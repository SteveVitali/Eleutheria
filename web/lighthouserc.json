{
  "//": "SPDX-License-Identifier: Apache-2.0 — SIG performance-budget CI gate (SIG-UI-041). A dense evidence page that takes eight seconds to load will not be used at a podium; the build FAILS on regression.",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 0 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }],
        "total-byte-weight": ["error", { "maxNumericValue": 153600 }],
        "unminified-css": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
