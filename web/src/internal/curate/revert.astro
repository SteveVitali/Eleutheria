// Revert a contribution (P21.6, §34.4, SIG-CONTRIB-009). A revert is a NEW assertion,
// never a deletion: the original rows are preserved so a citation made before the
// revert stays reproducible. A reason is required. Zero-JS form.
import CurateLayout from "../../layouts/CurateLayout.astro";
import { curationAction } from "../../lib/curation";
---

<CurateLayout title="Revert a contribution" path="/curate/revert/">
  <p>
    Reverting a contribution appends a retraction assertion; it never deletes the
    original rows, so a citation made before the revert stays reproducible at its belief
    time (SIG-CONTRIB-009). A reason is required.
  </p>

  <form
    class="sig-decide-form"
    method="post"
    action={curationAction("revert")}
    data-testid="revert-form"
  >
    <label>
      Contribution id (required)
      <input type="text" name="contribution_id" required data-testid="revert-contribution" />
    </label>
    <label>
      Reason (required, SIG-CONTRIB-009)
      <textarea name="reason" rows="3" required data-testid="revert-reason"></textarea>
    </label>
    <button type="submit" data-testid="revert-submit">Revert (records a new assertion)</button>
  </form>
</CurateLayout>
