// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The network explorer (§39.4). Static, zero-JS (SIG-UI-036): the default ego
// network, the three distinct + separately-listed access edge types, and the
// access-path closures all render server-side. The LIST EQUIVALENT (the edge lists
// and the hop lists) is the source of truth and the no-JS/screen-reader path
// (SIG-UI-037). P34.15 (K2 NEW-6, D-K2-2, SIG-IDENT-030 by abstention): the
// centrality statistic and the "deterministic identity resolution … exact" claim
// are WITHDRAWN — organisation entity resolution has not passed its gate, so the
// page publishes no ranking and says why.
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import {
  ACCESS_EDGE_TYPES,
  ACCESS_EDGE_STYLES,
  DEFAULT_NETWORK_VIEW,
  boundedEgoNetwork,
  edgeTemporal,
  EGO_EDGE_LIMIT,
  filterAccessEdges,
  isCurrentEdge,
  DEFAULT_ACCESS_EDGE_FILTER,
  pathConfidence,
  pathHopCount,
  pathIsHeadline,
  pathIsSpeculative,
  pathOrgs,
  pathSource,
  pathTarget,
  pathTemporalStatus,
  SPECULATIVE_HOP_THRESHOLD,
} from "../lib/network";
import NetworkEdgeItem from "../components/NetworkEdgeItem.astro";
import ProvenancePanel from "../components/ProvenancePanel";
import {
  getNetwork,
  getNetworkFocusEntityId,
  getLatestReleaseTarget,
  getStatementIndex,
  capRows,
} from "../lib/data";
import { panelForClaim } from "../lib/provenance-panel";
import type { ProvenancePanelData, StatementRow } from "../lib/provenance-panel";
import NetworkIsland from "../islands/NetworkIsland";
import "../styles/islands.css";

// The sharing network + its ego-focus pick flow through the single data seam
// (ADR-066): fixtures by default, real export bytes under SIG_DATA_SOURCE=export.
// P34.15: no centrality statistic is read — the ranking is withdrawn
// (SIG-IDENT-030 by abstention); the focus entity is a presentation mechanism only.
const { nodes: NETWORK_NODES, edges: NETWORK_EDGES, accessPaths: ACCESS_PATHS } = getNetwork();
const FOCUS_ENTITY_ID = getNetworkFocusEntityId();

const labelOf = (id: string) => NETWORK_NODES.find((n) => n.id === id)?.label ?? id;

// The edge list items render through `NetworkEdgeItem` — one component for both
// the current view and the marked past/undated block (SIG-UI-037 parity).

// The default surface is an ego network with expansion, never a global graph. When the
// network is empty (a thin/unresearched jurisdiction), there is nothing to centre on —
// the page renders an honest empty state instead of computing an ego view (P27.7).
const hasNetwork = NETWORK_NODES.some((n) => n.id === FOCUS_ENTITY_ID);
// The default ego diagram is BOUNDED (≤50 nodes / ≤100 edges, S4 acceptance
// budget) with its true totals stated — continued edge lists below carry all.
const ego = hasNetwork
  ? boundedEgoNetwork(NETWORK_NODES, NETWORK_EDGES, FOCUS_ENTITY_ID, 1)
  : { nodes: [], edges: [], totalNodes: 0, totalEdges: 0, truncated: false };

// The publication the workspace `release=` param defaults to (P32.15).
const LATEST = getLatestReleaseTarget();

// P35.36 (UXR-33): the `claim_id → sig.provenance-panel/1` map — one panel per
// UNIQUE claim the page names (edge supporting claims, partner-count claims,
// path-hop evidence), rendered once in the "Claim provenance" section below so
// each `#claim-<id>` anchor resolves exactly once; the rows link it. The
// island's edge detail renders the same normalised contract. A claim with no
// statement normalises to the `not_recorded` panel — never a gap.
const STATEMENTS = getStatementIndex();
const PAGE_CLAIM_IDS = [
  ...new Set([
    ...NETWORK_EDGES.flatMap((e) => e.evidence ?? []),
    ...NETWORK_NODES.flatMap((n) => n.degree_claim_ids ?? []),
    ...ACCESS_PATHS.flatMap((p) => p.hops.flatMap((h) => h.evidence)),
  ]),
].sort();
const CLAIM_PANELS: Record<string, ProvenancePanelData> = Object.fromEntries(
  PAGE_CLAIM_IDS.map((cid) => [cid, panelForClaim(STATEMENTS, cid)]),
);
// The island ships only the claims that HAVE statements (the row bytes, not
// the rendered panel) — absent claims normalise in-island to `not_recorded`
// through the same `panelFromStatement`, so the serialized props stay lean.
const ISLAND_STATEMENTS: Record<string, StatementRow> = Object.fromEntries(
  PAGE_CLAIM_IDS.filter((cid) => STATEMENTS.has(cid)).map((cid) => [
    cid,
    STATEMENTS.get(cid)!,
  ]),
);

// Lay the ego nodes out on a circle for the static diagram (center in the middle).
const others = ego.nodes.filter((n) => n.id !== FOCUS_ENTITY_ID);
const cx = 200;
const cy = 150;
const r = 110;
const pos = new Map<string, { x: number; y: number }>();
if (hasNetwork) pos.set(FOCUS_ENTITY_ID, { x: cx, y: cy });
others.forEach((n, i) => {
  const a = (2 * Math.PI * i) / Math.max(1, others.length);
  pos.set(n.id, { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) });
});
---

<BaseLayout title="Network explorer" path="/network/">
  <p>
    The sharing / access network. It defaults to an <strong>ego network</strong> around
    one entity — never a global graph — and expands one ring at a time (SIG-UI-022).{" "}
    <strong>Every edge and every path is also in the lists below</strong>: the lists are
    the equivalent, not a fallback.
  </p>

  <ViewSwitch view="network" release={LATEST?.publicationId ?? null} />

  {!hasNetwork && <EmptyState surface="network" />}

  {hasNetwork && (
  <section class="sig-island sig-graph-island" aria-labelledby="graph-island-heading" data-testid="graph-island-section">
    <h2 id="graph-island-heading">Interactive explorer</h2>
    <p class="sig-island__note">
      An opt-in interactive explorer (P27.9, ADR-097). It opens on an ego network and
      expands one node at a time — never a national hairball (SIG-UI-021/022). With
      JavaScript disabled this block is empty and the edge and path <strong>lists
      below</strong> are the full, usable surface (SIG-UI-037/050).
    </p>
    <NetworkIsland
      client:only="react"
      nodes={NETWORK_NODES}
      edges={NETWORK_EDGES}
      focusEntityId={FOCUS_ENTITY_ID}
      release={LATEST?.publicationId ?? null}
      claimStatements={ISLAND_STATEMENTS}
    />
  </section>
  )}

  {hasNetwork && (
  <section data-testid="network-view" data-default-view={DEFAULT_NETWORK_VIEW}>
    <h2 id="ego-heading">Ego network — {labelOf(FOCUS_ENTITY_ID)}</h2>
    <figure aria-labelledby="ego-caption">
      <svg
        role="img"
        aria-label={`Ego network around ${labelOf(FOCUS_ENTITY_ID)}; full detail in the lists below.`}
        viewBox="0 0 400 300"
        width="400"
        height="300"
        style="max-width:100%;border:1px solid var(--sig-rule);background:hsl(0deg 0% 98%);"
      >
        {ego.edges.map((e) => {
          const a = pos.get(e.from)!;
          const b = pos.get(e.to)!;
          const style = ACCESS_EDGE_STYLES[e.access_kind];
          const t = edgeTemporal(e);
          return (
            <line
              x1={a.x}
              y1={a.y}
              x2={b.x}
              y2={b.y}
              stroke="var(--sig-muted)"
              stroke-width="2"
              stroke-dasharray={style.dash || undefined}
              stroke-opacity={t === "current" ? 1 : 0.4}
              data-temporal={t}
            />
          );
        })}
        {ego.nodes.map((n) => {
          const p = pos.get(n.id)!;
          const center = n.id === FOCUS_ENTITY_ID;
          return (
            <g>
              <circle cx={p.x} cy={p.y} r={center ? 12 : 9} fill="var(--sig-epi-status-resolved)">
                <title>{n.label}</title>
              </circle>
              <text x={p.x} y={p.y - 15} text-anchor="middle" font-size="9">{n.label}</text>
            </g>
          );
        })}
      </svg>
      <figcaption id="ego-caption">
        Expansion pulls in the next ring of neighbours; edge dash patterns encode the
        access type (see the legend below).
        {ego.truncated && (
          <span data-testid="ego-bounds-note">
            {" "}Bounded view — {ego.nodes.length} of {ego.totalNodes} nodes,{" "}
            {ego.edges.length} of {ego.totalEdges} edges drawn; the edge lists below
            carry the rest.
          </span>
        )}
      </figcaption>
    </figure>
  </section>
  )}

  <!-- Centrality/hub statistics — WITHDRAWN (P34.15, D-K2-2, SIG-IDENT-030 by
       abstention): the old "deterministic identity resolution … exact" claim
       overstated organisation resolution; SIG abstains from publishing a ranking
       until the resolution gate passes. When it does, every returned statistic
       still carries its ER-quality disclosure INLINE (SIG-UI-023 — the
       `CentralityStatistic` type keeps that contract structural). -->
  <h2 id="centrality-heading">Centrality &amp; hub statistics</h2>
  <p data-copy="NW-01 NW-02" data-testid="centrality-withdrawn">
    SIG has not merged organisations across sources — one agency can appear more
    than once in these lists. No centrality or hub ranking is published; the
    resolution review that would make one honest has not passed its gate.
  </p>

  <!-- The three access edge types: distinct legend + three unmerged lists. -->
  <h2 id="access-heading">Access edges</h2>
  <p>
    The three access edge types are <strong>never merged by default</strong> and each is
    independently filterable (SIG-UI-024). They are distinguished by a glyph and a dash
    pattern — two non-colour channels, legible in greyscale and print.
  </p>
  <ul class="sig-access-legend" data-testid="access-legend">
    {ACCESS_EDGE_TYPES.map((k) => {
      const style = ACCESS_EDGE_STYLES[k];
      return (
        <li data-testid="access-legend-item" data-kind={k} data-glyph={style.glyph} data-dash={style.dash}>
          <span class="sig-access-glyph" aria-hidden="true">{style.glyph}</span>
          <svg width="40" height="10" aria-hidden="true">
            <line x1="0" y1="5" x2="40" y2="5" stroke="var(--sig-ink)" stroke-width="2" stroke-dasharray={style.dash || undefined}></line>
          </svg>
          <strong>{style.label}</strong> — {style.meaning} <em>Never implies:</em> {style.neverImplies}
        </li>
      );
    })}
  </ul>

  {ACCESS_EDGE_TYPES.map((k) => {
    const edges = filterAccessEdges(NETWORK_EDGES, {
      ...DEFAULT_ACCESS_EDGE_FILTER,
      configured_access: k === "configured_access",
      observed_use: k === "observed_use",
      declared_policy: k === "declared_policy",
    });
    const style = ACCESS_EDGE_STYLES[k];
    // The default "current" view holds dated, not-yet-ended edges only; ended
    // and undated edges stay listed but visibly marked, out of the current
    // filter (K2 §7 H-3 — never a present-tense claim about them).
    const current = edges.filter(isCurrentEdge);
    const nonCurrent = edges.filter((e) => !isCurrentEdge(e));
    const cappedEdges = capRows(current, EGO_EDGE_LIMIT);
    return (
      <section class="sig-access-group" data-testid="access-edge-group" data-kind={k}>
        <h3>{style.glyph} {style.label}</h3>
        {edges.length === 0 && <EmptyState surface="accessEdges" />}
        <ul class="sig-edge-list">
          {cappedEdges.rows.map((e) => <NetworkEdgeItem edge={e} labelOf={labelOf} />)}
        </ul>
        {nonCurrent.length > 0 && (
          <details class="sig-edge-past" data-testid="access-edge-past" data-kind={k}>
            <summary>
              {nonCurrent.length} ended or undated {style.label.toLowerCase()} edge
              {nonCurrent.length === 1 ? "" : "s"} — visibly marked, out of the
              current view
            </summary>
            <ul class="sig-edge-list">
              {nonCurrent.map((e) => <NetworkEdgeItem edge={e} labelOf={labelOf} />)}
            </ul>
          </details>
        )}
        {cappedEdges.truncated && (
          <p class="sig-table-note" data-testid="access-edge-bounds-note">
            Showing the first {cappedEdges.shown} of {cappedEdges.total} {style.label}
            edges; the interactive explorer expands one ring at a time and the full
            edge set ships in the export.
          </p>
        )}
      </section>
    );
  })}

  {/* Recorded partner counts — a source-stated partner COUNT is a node
      attribute, never an edge (P35.30, SIG-INGEST-043c / K2 §7 H-4). The
      static list carries the same fact the island's node chip shows. */}
  {NETWORK_NODES.some((n) => n.degree !== undefined) && (
    <section data-testid="partner-counts">
      <h2 id="degree-heading">Recorded partner counts</h2>
      <p data-copy="NW-04">
        Some sources state a partner <strong>count</strong> without naming the
        partners — "shared with N agencies". A count is a fact about the
        entity, not a relationship: it is listed here as a node attribute and
        is never drawn as an edge (SIG-INGEST-043c).
      </p>
      <ul class="sig-degree-list">
        {NETWORK_NODES.filter((n) => n.degree !== undefined).map((n) => (
          <li data-testid="degree-node">
            <strong>{n.label}</strong> — {Array.isArray(n.degree) ? n.degree.join("–") : n.degree}{" "}
            partner{n.degree === 1 ? "" : "s"} recorded
            {n.degree_observed_at ? `, observed ${n.degree_observed_at}` : " (undated)"}
            {n.degree_claim_ids && n.degree_claim_ids.length > 0 && (
              <span class="sig-path__evidence" data-testid="degree-evidence">
                {" "}— evidence: {n.degree_claim_ids.join(", ")}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Access-path closure: full hop list, per-hop evidence, speculative label. -->
  <h2 id="paths-heading">Access-path closure</h2>
  <p>
    "Can this entity reach that entity's data, through any chain?" Each path shows its{" "}
    <strong>full hop list with per-hop evidence</strong>; confidence is the minimum over
    the hops; and a path longer than {SPECULATIVE_HOP_THRESHOLD} hops is labelled{" "}
    <strong>speculative</strong> and excluded from headline figures (SIG-UI-025,
    SIG-RECON-050).
  </p>
  {ACCESS_PATHS.length === 0 && <EmptyState surface="accessPaths" />}
  <ol class="sig-paths">
    {ACCESS_PATHS.map((p) => (
      <li
        class="sig-path"
        data-testid="access-path"
        data-hop-count={pathHopCount(p)}
        data-speculative={pathIsSpeculative(p) ? "true" : "false"}
        data-headline={pathIsHeadline(p) ? "true" : "false"}
        data-temporal={pathTemporalStatus(p)}
      >
        <p class="sig-path__summary">
          <strong>{labelOf(pathSource(p))}</strong> can reach
          <strong> {labelOf(pathTarget(p))}</strong>
          {" "}— {pathHopCount(p)} hop{pathHopCount(p) === 1 ? "" : "s"},
          confidence {pathConfidence(p)} (path minimum), {pathTemporalStatus(p)}.
          {pathIsSpeculative(p) ? (
            <span class="sig-path__speculative" data-testid="speculative-label">
              {" "}SPECULATIVE — beyond the published hop threshold; not a headline figure.
            </span>
          ) : (
            <span class="sig-path__finding"> A publishable finding.</span>
          )}
        </p>
        <p class="sig-path__chain">{pathOrgs(p).map((o) => labelOf(o)).join(" → ")}</p>
        <ol class="sig-path__hops">
          {p.hops.map((h) => (
            <li data-testid="path-hop" data-edge-label={h.edge_label}>
              <strong>{labelOf(h.from_org)}</strong> → <strong>{labelOf(h.to_org)}</strong>
              {" "}<span class="sig-path__hop-meta">
                ({h.edge_label}, scope {h.scope}, {h.confidence})
              </span>
              {" "}<span class="sig-path__evidence" data-testid="hop-evidence">
                evidence: {h.evidence.join(", ")}
              </span>
            </li>
          ))}
        </ol>
      </li>
    ))}
  </ol>

  <!-- P35.36 (R11-K13-TX-08a / J3 §5.1–5.2, UXR-33, SIG-TRANSP-011): one shared
       provenance panel per claim the page names — the same contract the
       record pages and the claim viewer render. Each `#claim-<id>` anchor
       resolves to exactly one panel; a claim with no published statement
       shows the `not_recorded` absence, never a fabricated binding. -->
  {PAGE_CLAIM_IDS.length > 0 && (
    <section data-testid="claim-provenance">
      <h2 id="claim-provenance-heading">Claim provenance</h2>
      <p class="mut">
        One provenance panel per named claim — J3 §5.1's binding states,
        verbatim. A claim SIG cannot evidence shows the named absence, never
        an implied document.
      </p>
      {PAGE_CLAIM_IDS.map((cid) => (
        <ProvenancePanel panel={CLAIM_PANELS[cid]!} anchor />
      ))}
    </section>
  )}
</BaseLayout>
