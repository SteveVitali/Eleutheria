// L0 contributor submission (P21.6, §34.1-34.3, SIG-CONTRIB-002/004/005). A submission
// is a piece of EVIDENCE (evidence URL + claim + as-of), entering at L0 — never a
// direct graph claim. The form refuses without evidence. Device observations route to
// OSM/DeFlock (the server enforces this, SIG-CONTRIB-004). Zero-JS form.
import CurateLayout from "../../layouts/CurateLayout.astro";
import { SUBMISSION_KINDS, curationAction } from "../../lib/curation";
---

<CurateLayout title="Submit evidence" path="/curate/submit/">
  <p>
    A contribution is a piece of <strong>evidence</strong> — an operator record, a photo
    of signage, a contract, an agenda item, or a report. It enters at level L0 and is
    promoted to a graph claim only by reviewed resolution, never directly
    (SIG-CONTRIB-002). Evidence is required. Device sightings belong to OSM/DeFlock and
    are routed there, not captured here (SIG-CONTRIB-004).
  </p>

  <form
    class="sig-decide-form"
    method="post"
    action={curationAction("submission")}
    data-testid="submit-form"
  >
    <label>
      Evidence URL (required)
      <input type="url" name="evidence_url" required data-testid="submit-evidence" />
    </label>
    <label>
      Kind
      <select name="kind" required data-testid="submit-kind">
        {SUBMISSION_KINDS.map((k) => (
          <option value={k}>{k}</option>
        ))}
      </select>
    </label>
    <label>
      Claim (what the evidence shows)
      <textarea name="claim" rows="3" data-testid="submit-claim"></textarea>
    </label>
    <label>
      As of (date the evidence describes)
      <input type="date" name="as_of" data-testid="submit-asof" />
    </label>
    <button type="submit" data-testid="submit-submit">Submit evidence (enters at L0)</button>
  </form>
</CurateLayout>
