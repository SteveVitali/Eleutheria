// The public methodology page (§39.8, SIG-UI-034). Static, zero-JS. It explains how
// SIG knows what it knows — evidence tiers, currency, reconciliation, the four kinds of
// absence, and the honesty constraints — and links the data-freshness (§32.4) and
// coverage-metrics (§32.5) pages. Linked from every dossier via the base layout's
// "How we know this" module, satisfying "linked from every dossier".
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import InBrief from "../components/InBrief.astro";
import Term from "../components/Term.astro";
import { getResolutionEval } from "../lib/data";
// P35.37 (SIG-TRANSP-013, DR-C3-03): the eval is a published release artifact —
// the data layer's single seam (canonical record in fixtures mode,
// `web/evaluation.json` in export mode), never a hard-coded constant — and
// each rendered metric is an evaluation-class <Figure> pointing into it.
import { artifactHref, defineFigures, evaluationTargets } from "../lib/figures";

const eval_ = getResolutionEval();
const FIGURES = defineFigures("methodology", eval_.metrics.map((m, i) => ({
  id: `eval-${i}`,
  class: "evaluation" as const,
  value: m.value,
  artifact: "web/evaluation.json",
  pointer: `/metrics/${i}/value`,
  definition: "#resolution-eval",
  href: artifactHref("web/evaluation.json"),
  breakdown: `#fig-eval-${i}`,
  targets: evaluationTargets(),
})));
---

<BaseLayout title="Methodology" path="/methodology/">
  {/* P36.17 (K14 §2.4): the plain layer first — ≤80 words, the precise page
      one action away. */}
  <InBrief href="#evidence-tiers">
    SIG reports what the evidence shows, and how sure it is — nothing more.
    Every claim keeps its sources, how strongly they back it, whether sources
    disagree, and how old the evidence is. A gap is named, never silently
    omitted.
  </InBrief>
  <p>
    This page explains how SIG produces and qualifies every{" "}
    <Term term="claim">claim</Term>. SIG{" "}
    <strong>reports</strong>; it does not endorse. Every material claim carries four
    independent epistemic fields, a support glyph, a persistent marker when contested,
    and an honest gap wherever SIG has not looked.
  </p>

  <h2 id="evidence-tiers">Evidence tiers and support</h2>
  <p>
    <Term term="source">Sources</Term> are graded by an evidence tier (e.g. a
    records-request contract outranks a
    portal aggregator snapshot). The support glyph is a four-step mark whose fill
    reflects how many independent, method-distinct evidence classes stand behind the
    winning value, and it always carries a machine-readable downgrade reason when it
    sits below fully confirmed.
  </p>

  <h2>Reconciliation and contradiction</h2>
  <p>
    When sources disagree, SIG resolves by a versioned ruleset (e.g. highest tier wins)
    and <strong>preserves the dissent</strong> — a contested value is plotted as a
    range, with each competing claim's source, tier, date, and document link. Two
    numbers that measure different quantities are labelled as such, not forced into a
    disagreement.
  </p>

  <h2>Absence is data</h2>
  <p>
    A missing row is never silently omitted. SIG distinguishes four kinds of absence —
    not researched, none found (with the sources searched named), stated
    absent, and unresolved — and each is a clickable invitation to{" "}
    <a href="/research-queue/">research it</a>.
  </p>

  <h2>What SIG does not do</h2>
  <p data-testid="no-capture-recapture">
    SIG does <strong>not</strong> publish a capture–recapture estimate of device
    population from volunteer mapping and vendor portal reporting — not with a caveat,
    not with a wide interval. Linkage is impossible from published counts, the samples
    are not independent, and the estimator's known failure mode is understating the very
    thing SIG exists to document. SIG publishes counted quantities with{" "}
    <strong>named denominators</strong> and records-derived bounds instead — never a
    total. See the <a href="/coverage-metrics/">coverage metrics</a>.
  </p>

  <h2 id="resolution-eval">How well SIG resolves entities (SIG measuring its own method)</h2>
  <p>
    SIG resolves many overlapping observations into single entities ("this camera seen by
    three sources is one camera"). A project that does this <strong>must publish how well
    its resolver measures against ground truth</strong> — and must say plainly when that
    ground truth is provisional. These are the current measurements.
  </p>
  <p data-testid="holdout-provenance" data-copy="M-40 M-41 M-42">
    Matching quality: development evidence only. The label sets these rules
    were tuned on were produced by an AI model and by agents; no person
    labelled them. SIG is changing the merge rules so that only copies of one
    upstream record are merged.
  </p>
  <p data-testid="resolved-site-definition">
    <strong>What a "resolved site" is.</strong> An{" "}
    <em><Term term="record">observation-level record</Term></em> is one
    source's published row for one camera. A <em>resolved site</em> is a cluster of those
    records that SIG's camera-site entity resolution judged to describe the <strong>same
    physical device</strong>. SIG reports <strong>N resolved sites from M observation-level
    records</strong> (N is never more than M) and the dedup ratio 1 − N/M. Only merges from
    rules whose measured holdout precision clears the published floor are applied
    automatically; every other candidate merge waits for human review and is not counted.
    Two rows from the same source are never merged, a republished copy (mirror) of the same
    upstream dataset is not treated as independent confirmation, and each point shown is
    one record's own — never coordinates combined from two sources. Deciding which of one
    record's own values stands (for example its latest coordinate) is <em>not</em>{" "}
    deduplication and is never counted as a resolved site.
  </p>
  {eval_.provisional && (
    <p class="sig-eval-provisional" data-testid="resolution-eval-provisional">
      <strong>{eval_.disclosure}</strong>
    </p>
  )}
  <ul class="sig-eval" data-testid="resolution-eval">
    {eval_.metrics.map((m, i) => (
      <li class="sig-eval-metric" data-testid="resolution-eval-metric">
        <Figure figure={FIGURES[i]!} order="inline" testid="resolution-eval-figure">
          <span class="sig-eval-metric__label">{m.label}</span>{" "}
          <span class="sig-eval-metric__value"><strong>{m.value}</strong></span>{" "}
          <span class="sig-eval-metric__against">{m.against}</span>
        </Figure>
      </li>
    ))}
  </ul>
  <p data-copy="M-43 M-21">
    These measure <em>SIG's method</em>, on the named holdout each row names —
    never a device population and never a capture–recapture estimate. The full
    report and its generator are committed with the build.
  </p>
  <p data-copy="M-30">
    The SIG-authored data SIG offers upstream to OpenStreetMap is dual-licensed
    CC0-1.0 for that purpose.
  </p>
