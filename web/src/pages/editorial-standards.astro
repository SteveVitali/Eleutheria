// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The public editorial-standards page (§41). Static, zero-JS. It renders (a) the three
// example conformant editorial cases verbatim (SIG-UI-045) and (b) the recorded
// hostile-reader review for the current dossier template version (SIG-UI-042) — or its
// honest absence.
//
// P34.17 / ADR-179 (WV-04): the fixture two-reviewer "Releasable" review that this page
// rendered was fabricated — no hostile-reader review has ever been performed
// (F-183/F-107/F-198/F-201). The SIG-UI-042 release block is WAIVED for this round, so
// the page now records the truthful state: the review is not yet performed (notice
// string N-1, shipped by sha256 under the B-2 notice allowance). `assertReviewReleasable`
// still binds a *recorded* review — open findings or fewer than two reviewers fail the
// build — but it no longer fails the truthful absent review.
import BaseLayout from "../layouts/BaseLayout.astro";
import { EDITORIAL_CASES, assertReviewReleasable, openFindings } from "../lib/editorial";
import { getHostileReaderReview } from "../lib/data";

// The recorded hostile-reader review flows through the single data seam (ADR-066);
// `null` is the honest "never performed" state — NOT a releasable review.
const review = getHostileReaderReview();

// SIG-UI-042 (as waived, WV-04): a recorded review must still be dispositioned; absence
// is truthful, never a failure.
assertReviewReleasable(review);
const open = review ? openFindings(review) : [];
---

<BaseLayout title="Editorial standards" path="/editorial-standards/">
  <p data-copy="ES-01">
    SIG's editorial standards are what make its record usable as evidence. The{" "}
    <a href="/style-guide/">style guide</a> codifies the register rules; this page
    records the worked example cases and the state of the hostile-reader review that
    gates each dossier template version.
  </p>

  <!-- The three example editorial cases, rendered as specified (SIG-UI-045). -->
  <h2 id="cases-heading">Example cases</h2>
  <p data-copy="ES-02">Conformant copy for the three hardest cases:</p>
  <ul class="sig-editorial-cases" aria-labelledby="cases-heading">
    {EDITORIAL_CASES.map((c) => (
      <li class="sig-editorial-case" data-testid="editorial-case" data-case-id={c.id}>
        <h3>{c.title}</h3>
        <blockquote data-testid="editorial-case-copy">{c.copy}</blockquote>
      </li>
    ))}
  </ul>

  <!-- The hostile-reader review (SIG-UI-042) — recorded truthfully (P34.17 / ADR-179). -->
  <h2 id="review-heading">Hostile-reader review</h2>
  {review === null ? (
    <>
      <p data-testid="review-status" data-notice="N-1">Not yet performed.</p>
      <p data-copy="ES-03">
        Before a dossier template version is released, the standards call for two
        independent readers to read a real rendered dossier from the documented
        organization's point of view and log every sentence they would challenge. No
        such reading has taken place; a previously published record describing one was
        incorrect and has been removed.
      </p>
      <p data-copy="ES-04">
        The release block is waived for this round; the waiver and its reason are
        recorded in the project's decision log.
      </p>
    </>
  ) : (
    <>
      <p data-copy="ES-05">
        The recorded review, its findings, and their disposition are committed
        alongside the template version.
      </p>
      <dl class="sig-review-meta">
        <dt>Template version</dt><dd data-testid="review-template-version">{review.template_version}</dd>
        <dt>Dossier reviewed</dt><dd><a href={review.reviewed_dossier}>{review.reviewed_dossier}</a></dd>
        <dt>Reviewers</dt><dd data-testid="review-reviewers">{review.reviewers.join("; ")}</dd>
        <dt>Review date</dt><dd><time datetime={review.review_date}>{review.review_date}</time></dd>
        <dt>Release status</dt>
        <dd data-testid="release-status" data-open-findings={open.length}>
          {open.length === 0 ? "Every finding dispositioned" : `Blocked — ${open.length} open finding(s)`}
        </dd>
      </dl>
      <h3 id="findings-heading">Findings</h3>
      <ol class="sig-review-findings" aria-labelledby="findings-heading">
        {review.findings.map((f) => (
          <li
            class="sig-review-finding"
            data-testid="review-finding"
            data-finding-id={f.id}
            data-disposition={f.disposition ?? "open"}
          >
            <p class="sig-review-finding__challenge" data-testid="finding-challenge">{f.challenge}</p>
            <p class="sig-review-finding__disposition" data-testid="finding-disposition">
              <strong>{f.disposition ?? "OPEN"}</strong> — {f.resolution}
            </p>
          </li>
        ))}
      </ol>
    </>
  )}
</BaseLayout>
