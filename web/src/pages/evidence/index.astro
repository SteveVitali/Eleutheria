// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// P36.60 (K8 EV-02, SIG-EVUI-001/003/005/008): the evidence hub — §4.1.
// "What evidence means" intro, the state-of-the-evidence roll-up (claims by
// binding state, artifacts by classification + lane, captures with bytes vs
// digest-only), the current-state banner, the browse-artifacts table (≤ 50
// rows — K9 §6.1 pagination via /evidence/page/<n>/), the claim-views index,
// the facet nav and the JSON twin. T1 zero-JS; every fact shows without a
// script. D-K8-4 [B-44]: the synthetic run-record artifacts show with honest
// labels — never as stored documents.
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContestedMarker from "../../components/ContestedMarker.astro";
import EmptyState from "../../components/EmptyState.astro";
import ArtifactRows from "../../components/ArtifactRows.astro";
import {
  artifactHandles,
  artifactHref,
  byArtifactIndex,
  claimHref,
  evidenceRollup,
  latestCapture,
  pageCount,
  pageSlice,
} from "../../lib/evidence-hub";
import { evidencePath, isClaimContested, isSealed } from "../../lib/evidence-viewer";
import {
  ARTIFACTS_EMPTY,
  ARTIFACTS_HEADING,
  ARTIFACTS_INTRO,
  ARTIFACT_COPY,
  UPSTREAM_LINK_LABEL,
} from "../../lib/evidence-artifacts";
import { getEvidence } from "../../lib/data";
import { withBase } from "../../lib/paths";

// The evidence claim-views + published artifacts flow through the single data
// seam (ADR-066): fixtures by default, real export bytes under SIG_DATA_SOURCE=export.
const { artifacts, claimViews: CLAIM_VIEWS, claimViewsStats: CV_STATS } = getEvidence();
const handles = artifactHandles(artifacts);
const sorted = [...artifacts].sort(byArtifactIndex);
const shown = pageSlice(sorted, 1);
const totalPages = pageCount(sorted.length);
const roll = evidenceRollup(artifacts);
const runRecordShare =
  roll.artifacts === 0 ? 0 : Math.round((roll.runRecords / roll.artifacts) * 100);
// SIG-EVUI-008: the current-state banner names the actual cause — a pipeline
// gap (claims not yet bound to stored documents), never a research gap.
const allRunRecords = roll.artifacts > 0 && roll.runRecords === roll.artifacts;
---

<BaseLayout title="Evidence" path="/evidence/">
  <p>
    SIG's evidence is three things: an <strong>artifact</strong> (a document or dataset SIG
    read), a <strong>capture</strong> (a dated, hashed copy or record of that read), and a <strong>claim</strong> (one statement
    extracted from a capture). This page is the state of
    the evidence in this release — browse the artifacts, open one to see its captures and the
    claims it supports, or open a claim's full evidence view. Links to a source's own page
    — <em data-copy={ARTIFACT_COPY.upstreamLink}>{UPSTREAM_LINK_LABEL}</em> —
    are never presented as captures SIG holds.
  </p>

  {allRunRecords && (
    <p class="sig-evidence-banner" data-testid="evidence-state-banner">
      Every published artifact currently points to a <strong>run-level record</strong>: SIG
      logged which source run produced it, but did not keep a per-record copy of the page or
      file it came from. Each source's page lists what was fetched, when, and its hash — the
      run record is labelled honestly, never presented as a stored document.
    </p>
  )}

  <h2 id="state-heading">State of the evidence</h2>
  <dl class="sig-evidence-rollup" data-testid="evidence-rollup" data-artifacts={roll.artifacts} data-run-records={roll.runRecords}>
    <div><dt data-copy={ARTIFACT_COPY.heading}>{ARTIFACTS_HEADING}</dt><dd>{roll.artifacts}</dd></div>
    <div><dt>Run records (no stored document)</dt><dd>{roll.runRecords} ({runRecordShare}%)</dd></div>
    <div><dt>Recorded captures</dt><dd>{roll.capturesRecorded === 0 ? "not recorded" : roll.capturesRecorded}</dd></div>
    <div><dt>Captures with stored bytes</dt><dd>{roll.captures === 0 ? "not recorded" : `${roll.capturesWithBytes} of ${roll.captures}`}</dd></div>
    <div><dt>Claim evidence views</dt><dd>{CLAIM_VIEWS.length}</dd></div>
  </dl>

  <h2 id="browse-heading">Browse artifacts ({sorted.length})</h2>
  {sorted.length === 0 && <EmptyState surface="evidenceIndex" />}
  {sorted.length === 0 && (
    <p data-testid="artifacts-empty" data-copy={ARTIFACT_COPY.empty}>{ARTIFACTS_EMPTY}</p>
  )}
  <ArtifactRows artifacts={shown} handles={handles} testid="evidence-artifact-row" />
  {totalPages > 1 && (
    <p class="sig-evidence-pagination" data-testid="evidence-pagination">
      Showing {shown.length} of {sorted.length} —{" "}
      <a href={withBase("evidence/page/2/")}>next page →</a>
    </p>
  )}

  <h2 id="facets-heading">Browse by</h2>
  <p data-copy={ARTIFACT_COPY.intro}>{ARTIFACTS_INTRO}</p>
  <ul class="sig-evidence-facets" aria-labelledby="facets-heading">
    {([
      ["Source", "source", roll.bySource, "facet-source"],
      ["Type", "type", roll.byType, "facet-type"],
      ["Lane", "lane", roll.byLane, "facet-lane"],
      ["Capture state", "state", roll.byState, "facet-state"],
      ["Place", "place", roll.byPlace, "facet-place"],
    ] as const).map(([dimLabel, dim, facets, tid]) => (
      <li data-testid="facet-dim" data-dim={dim}>
        <strong>{dimLabel}:</strong>{" "}
        {facets.map((f, i) => (
          <>
            {i > 0 && ", "}
            <a href={withBase(`evidence/${dim}/${f.id}/`)} data-testid={tid}>{f.label} ({f.items})</a>
          </>
        ))}
      </li>
    ))}
  </ul>

  <h2 id="claim-views-heading">Claim evidence views ({CLAIM_VIEWS.length})</h2>
  <p>
    The full evidence view shows the claim's supporting location by binding state and
    disclosure lane: the document with the span highlighted where the lane permits bytes,
    the locator and digest with a download or view-at-source link where it does not, and a
    metadata-only representation where the bytes are withheld. It also shows the extraction
    method and version, the review status, the conflicting claims, the capture date and
    digest, the acquisition method, and the full claim history.
  </p>
  {/* SIG-EVUI-009 (P37.37 / D-K8-2 [B-22]): the published generation cap and
      the overflow count are stated verbatim — never a smoothed number. */}
  {CV_STATS !== null ? (
    <p data-testid="claim-view-cap">
      Claim evidence views are generated for every document-genre claim bound to a stored
      capture, up to a cap of <strong>{CV_STATS.cap.toLocaleString("en-US")}</strong> per
      release: <strong data-testid="claim-view-emitted">{CV_STATS.emitted}</strong> emitted
      of <strong data-testid="claim-view-eligible">{CV_STATS.eligible}</strong> eligible
      {CV_STATS.overflow > 0 && (
        <> — <strong data-testid="claim-view-overflow">{CV_STATS.overflow}</strong> eligible
        views were not generated because the cap was reached</>
      )}
      .
    </p>
  ) : (
    <p data-testid="claim-view-cap">The claim-view generation cap is not recorded in this release.</p>
  )}
  {CLAIM_VIEWS.length === 0 && <EmptyState surface="evidenceIndex" />}
  <ul class="sig-evidence-index">
    {CLAIM_VIEWS.map((view) => (
      <li data-testid="evidence-index-item" data-claim-id={view.claim_id} data-sealed={isSealed(view.capture) ? "true" : "false"}>
        <a href={withBase(evidencePath(view.claim_id))}>{view.claim_label}</a>{" "}
        {isClaimContested(view) && <ContestedMarker compact />}
        {isSealed(view.capture) && <span class="sig-sealed-badge"> (sealed — metadata only)</span>}
      </li>
    ))}
  </ul>

  <h2 id="downloads-heading">Machine-readable</h2>
  <p>
    <a href={withBase("evidence/index.json")} data-testid="evidence-json-twin">The artifact index as JSON</a>{" "}
    — every artifact page and claim view also carries a <code>.json</code> twin.
  </p>
</BaseLayout>
