// P36.60 (EV-02 / K13 §2.5, SIG-UI-058): `/evidence/<id>/` is the retired
// claim-viewer address — the canonical page lives at `/evidence/claim/<id>/`.
// This stub is the static fallback for the JUR-05 generator's 301 rule
// (redirects.conf); where the include cannot run the page still answers —
// a noindex moved notice with a zero-JS refresh (the K4 §8.2 pattern: a
// 0-second meta refresh is no WCAG timing failure).
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEvidence } from "../../lib/data";
import { claimHref, EVIDENCE_RESERVED_SEGMENTS } from "../../lib/evidence-hub";
import { withBase } from "../../lib/paths";

export const getStaticPaths: GetStaticPaths = () =>
  getEvidence().claimViews.map((view) => {
    if (EVIDENCE_RESERVED_SEGMENTS.has(view.claim_id)) {
      throw new Error(
        `evidence/[id]: claim id "${view.claim_id}" collides with a facet namespace (SIG-ENG-042)`,
      );
    }
    return { params: { id: view.claim_id }, props: { claimId: view.claim_id } };
  });

const { claimId } = Astro.props as { claimId: string };
const target = withBase(claimHref(claimId));
---

<BaseLayout
  title={`Moved — /evidence/${claimId}/`}
  path={withBase(`evidence/${claimId}/`)}
  noindex
  crumbs={[{ label: "Evidence", href: withBase("evidence/") }, { label: "Moved" }]}
>
  <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />
  <p class="sig-lede" data-testid="evidence-moved-stub" data-claim-id={claimId}>
    This claim's evidence page moved. Claim pages now live under{" "}
    <code>/evidence/claim/</code> — the same record, at the canonical address.
  </p>
  <p>
    <a href={target} data-testid="evidence-moved-target">
      Continue to the claim's evidence page →
    </a>
  </p>
</BaseLayout>
