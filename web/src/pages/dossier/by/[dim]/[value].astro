// P36.34 (K4 JUR-04): single-dimension facet routes — /dossier/by/<dim>/<v>/
// (K4 §6: level, single-source, evidence-type). Only values present in the
// index mint a route; an empty value is a 404, never an empty page.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DossierIndexRow from "../../../../components/DossierIndexRow.astro";
import { getDossierIndex, getIndexSprite } from "../../../../lib/data";
import { FACET_DIMS, facetIndex, facetValues, indexFigureSpecs, isFacetDim, isKeyedIndexRow } from "../../../../lib/dossier-index";
import { defineFigures } from "../../../../lib/figures";
import { withBase } from "../../../../lib/paths";

export function getStaticPaths() {
  const rows = getDossierIndex();
  const out: { params: { dim: string; value: string }; props: { dim: string; value: string } }[] = [];
  for (const dim of FACET_DIMS) {
    for (const value of facetValues(rows, dim)) {
      out.push({ params: { dim, value }, props: { dim, value } });
    }
  }
  return out;
}
const { dim, value } = Astro.props;
if (!isFacetDim(dim)) throw new Error(`dossier facet: unknown dimension ${dim}`);
const dossiers = getDossierIndex();
const keyedRows = dossiers.filter(isKeyedIndexRow);
const rows = facetIndex(dossiers, dim, value);
const figs = new Map(defineFigures(`dossier-by-${dim}-${value}`, indexFigureSpecs(keyedRows)).map((f) => [f.id, f]));
const keyedIndex = (row: (typeof dossiers)[number]) => keyedRows.indexOf(row);
const sprite = getIndexSprite();
---
<BaseLayout title={`Dossiers — ${dim}: ${value}`} path={`/dossier/by/${dim}/${value}/`}>
  <p class="sig-lede">
    Dossiers where <strong>{dim}</strong> is <strong>{value}</strong>.{" "}
    <a href={withBase("dossier/")}>Back to the grouped index</a>.
  </p>
  <ul class="sig-dossier-index" role="list" data-testid="dossier-index">
    {rows.map((row) => (
      <DossierIndexRow row={row} figs={figs} keyedIndex={keyedIndex(row)} sprite={sprite} />
    ))}
  </ul>
</BaseLayout>
