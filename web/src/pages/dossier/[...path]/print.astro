// The dossier print / PDF path (SIG-UI-013): a document suitable for handing to
// a council member. It is a standalone, zero-JS page (not the interactive shell
// layout). P36.26 (K14 UXK14-9 / §4.10–4.11, SIG-UI-098/130/155) composes it:
// page 1 is the council brief (recorded/unknown at a glance, next decision or
// its typed absence, documents to bring, the build-generated QR back to the
// pinned permalink); each declared print figure paginates on its own page; the
// twelve §39.2 sections follow; the "Terms used" strip closes the document.
// Every `.sig-print-page` carries the running head and footer — as-of, release,
// permalink, licence, page n of N — so every emitted PDF page is
// self-identifying (SIG-UI-013/035, DR-K14-21 no orphan pages). The
// reconciliations print expanded (a paper reader cannot click) via print CSS.
import "../../../styles/epistemic.css";
import printCssUrl from "../../../styles/print.css?url";
import PrintChrome from "../../../components/print/PrintChrome.astro";
import CouncilBrief from "../../../components/print/CouncilBrief.astro";
import PrintFigure from "../../../components/print/PrintFigure.astro";
import PrintTerms from "../../../components/print/PrintTerms.astro";
import DossierSection from "../../../components/DossierSection.astro";
import ActionBlocks from "../../../components/ActionBlocks.astro";
import WhatWeDontKnow from "../../../components/WhatWeDontKnow.astro";
import { SECTION_TITLES, dossierPath, dossierPermalink, dossierPrintPath, validateDossier, sectionIsEmpty, SECTION_ACTION_BLOCKS, NO_RECORD_IN_SIG } from "../../../lib/dossier";
import { citationBlock } from "../../../lib/citation";
import { withBase } from "../../../lib/paths";
import { getDossierArtifactRef, getDossiers, getJurisdictionCompartments } from "../../../lib/data";
import { getReleaseStamp } from "../../../lib/release-stamp";
import { displayJurisdiction, dossierDisplayTitle } from "../../../lib/jurisdictions";
import { planPrintPages, recordedGlance, councilDecision, documentsToBring } from "../../../lib/print";
import { qrEncode, qrPathData } from "../../../lib/qr";
// P35.37 (SIG-TRANSP-013, J3 §5.4, UXR-34): the print document carries the SAME
// figure-evidence registry as the interactive dossier (its own variant ids).
import { artifactHref, defineFigures } from "../../../lib/figures";
import { dossierFigureSpecs, figureSpecMap } from "../../../lib/dossier-figures";
import { defaultDescription } from "../../../lib/meta";
import { socialCardForRoute } from "../../../lib/brand";

// P35.45 (D-K4-3 / K4 §5.3): print/CSV/runs mint ONLY for country + admin-1
// dossiers — the registry levels `country` and `state_province`
// (RUNS_FILE_LEVELS in exports/dossier_sources.py). A legacy flat dossier
// carries no `level` and keeps its print page; a keyed dossier whose level is
// county/municipality mints none — the dossier's `links.print` names the same
// set, so no link dangles.
const PRINT_LEVELS = new Set(["country", "state_province"]);

export function getStaticPaths() {
  return getDossiers()
    .filter((d) => d.level === undefined || PRINT_LEVELS.has(d.level))
    .map((d) => ({ params: { path: d.slug }, props: { dossier: d } }));
}

const { dossier } = Astro.props;
validateDossier(dossier);

// P34.14 (QW-8, F-105): the print form leads with the place's name too, code
// secondary — a printed ID/MN dossier still discloses its mix (K4 NEW-1).
// P35.45: a keyed dossier carries its own registry name (jkey secondary).
const jurisdiction = dossier.display_name || dossier.name
  ? {
      name: dossier.display_name ?? dossier.name ?? dossier.jurisdiction,
      code: dossier.jurisdiction_key ?? null,
      label: dossier.jurisdiction_key
        ? `${dossier.display_name ?? dossier.name} (${dossier.jurisdiction_key})`
        : (dossier.display_name ?? dossier.name ?? dossier.jurisdiction),
      known: true,
      combines: null,
    }
  : displayJurisdiction(dossier.jurisdiction);
// Keyed subject_labels already lead with the place name; a legacy "… — CODE"
// label is rewritten name-first (JD batch pins the display contract).
const pageTitle = dossierDisplayTitle(dossier.subject_label, dossier.jurisdiction);
const combinesList = jurisdiction.combines ? jurisdiction.combines.join(" and ") : null;

const origin = Astro.site ? Astro.site.origin : undefined;
const link = dossierPermalink(dossier, origin);
// P36.25 (SIG-UI-154): this route's own path — the OG share object + the
// card lookup below. `dossierPrintPath` is the registry-named route.
const printPath = dossierPrintPath(dossier.slug);
const printCard = socialCardForRoute(printPath);
const printOrigin = Astro.site ?? "https://surveillancegraph.org";
const printUrl = new URL(printPath, printOrigin).href;
const printCardUrl = printCard ? new URL(withBase(printCard.file), printOrigin).href : null;
const printTitle = `${pageTitle} — SIG dossier (print)`;
const printDesc = defaultDescription(printTitle, "T0");

// P35.13 (SIG-REL-009, G3 §6.1): the print form names the release it was
// printed from on every page footer — a council copy of "release
// sig-2026-10-15.1" is citable on its own.
const stamp = getReleaseStamp();

// P36.26: the page plan — brief + one page per declared figure + the section
// chunks + the terms strip. `releaseBound` decides whether `release` and
// `pinned-citation` join the terms list and whether the release/licence lines
// render — never asserted on an unbound development build.
const pages = planPrintPages(dossier, { releaseBound: stamp !== null });
const glance = recordedGlance(dossier);
const decision = councilDecision(dossier);
const documents = documentsToBring(dossier);
// K14 §4.11: the QR is a static SVG generated at build — EC level M,
// deterministic, encodes the belief-pinned permalink verbatim.
const qr = qrPathData(qrEncode(link));

// The print page's figures[] registry — the print variant ids; no "How we know
// this" panel on this surface → the provenance target is a named absence.
const ref = getDossierArtifactRef(dossier.slug);
const compartment =
  getJurisdictionCompartments().get(dossier.jurisdiction_key ?? dossier.jurisdiction) ??
  getJurisdictionCompartments().get(dossier.slug) ??
  null;
const recordList =
  stamp && compartment
    ? `r/${stamp.publicationId}/c/${compartment}/jurisdiction/${dossier.slug}/`
    : null;

// P35.42 (SIG-TRANSP-023, J3 §8.2, F-101): the print document's citation line
// renders the SAME contract as the on-page block — the cite sentence, the
// release id, the conditional reproducibility/interim wording — not a second
// hand-written block.
const printCite = citationBlock({
  path: dossierPath(dossier.slug),
  title: pageTitle,
  asOf: dossier.asOf,
  rulesetVersion: dossier.rulesetVersion,
  ...(origin ? { origin } : {}),
  release: stamp
    ? {
        publicationId: stamp.publicationId,
        label: stamp.label,
        recordPath: withBase(recordList ?? dossierPath(dossier.slug)),
      }
    : null,
});
const FIGURES = defineFigures(
  `dossier/${dossier.slug}/print`,
  dossierFigureSpecs(dossier, "print", {
    ref,
    recordList,
    provenanceHref: null,
    artifactHref: ref ? artifactHref(ref.artifact) : "",
  }),
);
if (FIGURES.length === 0) {
  throw new Error(
    `dossier "${dossier.slug}" (print): no figure registry — the dossier has no ` +
      `record in a manifest-listed artifact (SIG-TRANSP-013)`,
  );
}
const specMap = figureSpecMap(FIGURES);
---

<!doctype html>
<html lang="en" data-sig-chrome="print">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} — SIG dossier (print)</title>
    {/* P34.13 (QW-11): the same unique-description template as BaseLayout
        (copy-batch row MD-01), in this route's T0 form (P36.25, SIG-UI-154 —
        the print page IS the fixed, no-JavaScript surface), plus the shared
        favicon set and the per-type social card. */}
    <meta name="description" content={printDesc} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="alternate icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="canonical" href={new URL(dossierPath(dossier.slug), Astro.site ?? "https://surveillancegraph.org").href} />
    {/* P36.25 (SIG-UI-154): the same OG/Twitter block as BaseLayout — the
        print route is T0 and shares the T0 card; og:url names this route
        itself (the shared object), while link rel=canonical still names the
        dossier for indexers. */}
    {printCard && (
      <Fragment>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Surveillance Infrastructure Graph" />
        <meta property="og:title" content={printTitle} />
        <meta property="og:description" content={printDesc} />
        <meta property="og:url" content={printUrl} />
        <meta property="og:image" content={printCardUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={printCard.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={printTitle} />
        <meta name="twitter:description" content={printDesc} />
        <meta name="twitter:image" content={printCardUrl} />
      </Fragment>
    )}
    {stamp && <meta name="sig-release" content={stamp.metaContent} />}
    {stamp && <link rel="describedby" type="application/json" href={stamp.describedby} />}
    {/* The print stylesheet is an explicit link, not a side-effect import —
        a frontmatter `import ".../print.css"` gets hoisted onto every page's
        <head> in this build (`inlineStylesheets: "never"` + the shared
        data-layer chunk), which leaked ~1 KiB gzip onto /search/'s initial
        wire bytes and tripped the recorded D-P35.51-2 regression bound (run
        40807930438). `?url` still gives the bundled, hashed asset — it just
        ships only where this page links it. */}
    <link rel="stylesheet" href={printCssUrl} />
  </head>
  <body>
    <div class="sig-print-toolbar" role="note">
      <p>
        Print or save this page as a PDF (your browser's Print dialog → “Save as PDF”).{" "}
        <a href={dossierPath(dossier.slug)}>Back to the interactive dossier.</a>
      </p>
    </div>

    {/* P34.13 (QW-13, RI-49): the standalone document had NO main landmark —
        the print content now sits inside one. P36.26: every page carries the
        running head (place) and footer (as-of, release, permalink, licence,
        page n of N) — DR-K14-21's "no orphan pages". */}
    <main id="main">
    {pages.map((page) => (
      <div class="sig-print-page" data-testid="print-page" data-page-kind={page.kind}>
        <PrintChrome part="head" place={jurisdiction.label} n={page.n} total={page.total} />

        {page.kind === "brief" && (
          <CouncilBrief
            dossier={dossier}
            pageTitle={pageTitle}
            jurisdictionLabel={jurisdiction.label}
            glance={glance}
            decision={decision}
            documents={documents}
            qr={qr}
            permalink={link}
            specMap={specMap}
          >
            {/* JD-02/JD-07 stay in THIS file: the P34.14 copy-binding tests
                parse the route source, so the guarded elements are passed to
                the brief as a named slot (mixed-bucket disclosure K4 NEW-1). */}
            <Fragment slot="jurisdiction-notes">
              {combinesList && (
                <p class="sig-dossier-combines" data-testid="dossier-combines" data-copy="JD-02">This dossier combines {combinesList}.</p>
              )}
              {!jurisdiction.known && (
                <p class="sig-dossier-unmapped" data-testid="dossier-jurisdiction-unmapped" data-copy="JD-07">A jurisdiction code SIG has not yet named is on this page — flag it in the <a href={withBase("research-queue/")}>research queue</a>.</p>
              )}
            </Fragment>
          </CouncilBrief>
        )}

        {page.kind === "figures" && (
          <PrintFigure
            figure={page.figure}
            ordinal={page.n - 1}
            place={jurisdiction.label}
            asOf={dossier.asOf}
            permalink={link}
          />
        )}

        {page.kind === "sections" &&
          page.sections.map((section) => {
            const action = SECTION_ACTION_BLOCKS[section.section_id];
            const noRecord =
              section.section_id !== "what_we_dont_know" && sectionIsEmpty(section) && !action;
            return (
              <section data-section-id={section.section_id}>
                <h2>{SECTION_TITLES[section.section_id]}</h2>
                {section.section_id === "what_we_dont_know" ? (
                  <WhatWeDontKnow gaps={dossier.gaps} variant="print-section" specs={specMap} />
                ) : (
                  <DossierSection section={section} specs={specMap} />
                )}
                {action && <ActionBlocks dossier={dossier} which={action} specs={specMap} />}
                {noRecord && (
                  <p class="sig-no-record" data-testid="section-no-record" data-copy="DS-01">{NO_RECORD_IN_SIG}</p>
                )}
              </section>
            );
          })}

        {page.kind === "terms" && <PrintTerms terms={page.terms} />}

        <PrintChrome
          part="foot"
          place={jurisdiction.label}
          n={page.n}
          total={page.total}
          asOf={dossier.asOf}
          permalink={link}
          stamp={stamp}
          cite={printCite}
        >
          {/* JD-08 likewise binds in this file — the release sentence renders
              inside the footer row via the default slot. */}
          {stamp && (
            <span class="sig-print-footer__release" data-testid="print-release" data-copy="JD-08">
              {" "}— release {stamp.label} · built {stamp.builtAt} from code{" "}
              <a href={stamp.commitHref}><code>{stamp.commit8}</code></a> ·{" "}
              <code>{stamp.publicationShort}</code> ·{" "}
              <a href={stamp.describedby}>release.json</a>
            </span>
          )}
        </PrintChrome>
      </div>
    ))}
    </main>
  </body>
</html>
