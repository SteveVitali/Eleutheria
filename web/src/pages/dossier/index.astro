// The grouped dossier index (K4 JUR-04 / P36.34): the `sig.dossier-index/2`
// tree rendered as K4 §5.1 — the United States first (states and territories
// nested, subdivisions under them), then the other countries A–Z with their
// subdivisions, then the honest unkeyed demonstration tail and the
// "Not yet placed" data-quality sibling (never a jurisdiction). Every row
// carries the §5.2 field set with named definitions (SIG-JUR-006/007/008),
// the country-derived publication regime (SIG-JUR-010), and the
// dossier/print/JSON/map links (SIG-JUR-011: every dossier ≤3 clicks away
// by hierarchy or the A–Z directory). The place form GETs
// `/search/?type=place` (C-24); the same letter the reader would type is a
// static `/dossier/a-z/<letter>/` page while the API is unreachable.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import DossierIndexRow from "../../components/DossierIndexRow.astro";
import Figure from "../../components/Figure.astro";
import { getDossierIndex, getIndexSprite, getUnplacedIndexEntry } from "../../lib/data";
import type { DossierIndexRow as IndexRowType } from "../../lib/data";
import { unplacedPath } from "../../lib/dossier";
import { displayJurisdiction } from "../../lib/jurisdictions";
import {
  INDEX_FIELD_DEFINITIONS,
  facetValues,
  groupIndex,
  isKeyedIndexRow,
  indexFigureSpecs,
  FACET_DIMS,
  SORT_KEYS,
} from "../../lib/dossier-index";
import type { IndexTreeNode } from "../../lib/dossier-index";
import { artifactHref, defineFigures, dossierTargets } from "../../lib/figures";
import { withBase } from "../../lib/paths";

const dossiers = getDossierIndex();
const keyedRows = dossiers.filter(isKeyedIndexRow);
const unplaced = getUnplacedIndexEntry();
const sprite = getIndexSprite();
const groups = groupIndex(dossiers);

// The ONE figures[] registry: the row-table numerals (pointing into
// `web/dossiers/index.json`) + the unplaced sibling's count.
const INDEX_FIGURES = defineFigures("dossier-index", [
  ...indexFigureSpecs(keyedRows),
  ...(unplaced !== null
    ? [{
        id: "unplaced-records",
        class: "dossier" as const,
        value: unplaced.records,
        unit: "records",
        artifact: "web/unplaced.json",
        pointer: "/records",
        definition: "#unplaced-heading",
        href: artifactHref("web/unplaced.json"),
        breakdown: "#fig-unplaced-records",
        targets: dossierTargets({ recordList: null, provenanceHref: null, perSourceSlices: null }),
      }]
    : []),
]);
const figs = new Map(INDEX_FIGURES.map((f) => [f.id, f]));
const keyedIndex = (row: IndexRowType) => keyedRows.indexOf(row);

// Flatten a tree into (node, depth) rows for the nested list.
const flatten = (node: IndexTreeNode, depth = 0): { node: IndexTreeNode; depth: number }[] => [
  { node, depth },
  ...node.children.flatMap((c) => flatten(c, depth + 1)),
];
const hasUnmapped = dossiers.some(
  (d) => !d.display_name && !d.name && !displayJurisdiction(d.jurisdiction).known,
);
---

<BaseLayout title="Dossiers" path="/dossier/">
  <p class="sig-lede" data-copy="DI-02 DI-03">
    A dossier is SIG's primary public artifact for a jurisdiction: what is deployed, who
    can see it, what it costs, when it must be decided, and — as a headline, not an
    appendix — <strong>what SIG does not know</strong>. Each dossier has a print view,
    and the page records the belief-time and ruleset it was built from.
  </p>
  <p data-copy="DI-07 DI-05 DI-06">
    This index lists every jurisdiction SIG has published to a publishable standard,
    grouped the way the registry records it: the <strong>United States</strong> first,
    its states and territories together, then the other countries and their
    subdivisions. It is not a census: a jurisdiction absent here is one SIG has not yet
    published, <strong>not</strong> one with no surveillance infrastructure.
  </p>

  {/* C-24: the index place form — GET /search/?type=place (the release-pinned
      search's place kind); the same first letter is a static directory page
      while the API is unreachable (the nginx first-letter fallback). */}
  <form
    method="get"
    action={withBase("search/")}
    class="sig-place-search"
    data-testid="place-search-form"
  >
    <label for="place-q">Find a place:</label>{" "}
    <input id="place-q" type="search" name="q" maxlength={200} size={30} placeholder="State, county or city" />
    <input type="hidden" name="type" value="place" />
    <button type="submit">Search</button>{" "}
    <span class="sig-place-search__note" data-testid="place-search-fallback">
      If search cannot be reached, the first letter of a place's name finds it in the{" "}
      <a href={withBase("dossier/a-z/")}>A–Z directory</a>.
    </span>
  </form>
  <p class="sig-table-note">
    Sort:{" "}
    {SORT_KEYS.map((k, i) => (
      <>
        {i > 0 && " · "}
        <a href={withBase(`dossier/sort/${k}/`)}>{k}</a>
      </>
    ))}
    {" · "}
    {FACET_DIMS.map((d, i) => (
      <>
        {i > 0 && " · "}
        by {d}:{" "}
        {facetValues(keyedRows, d).map((v, vi) => (
          <>
            {vi > 0 && " "}
            <a href={withBase(`dossier/by/${d}/${v}/`)}>{v}</a>
          </>
        ))}
      </>
    ))}
    {" · "}
    <a href={withBase("dossier/a-z/")}>A–Z directory</a>
    {" · "}
    <a href={withBase("map/")}>Browse on the map</a>
    {" · "}
    <a href={artifactHref("web/dossiers/index.json")}>index JSON</a>
  </p>

  {dossiers.length === 0 && <EmptyState surface="dossierIndex" />}
  {hasUnmapped && (
    <p class="sig-jurisdiction-unmapped" data-testid="dossier-index-unmapped" data-copy="JD-04">A jurisdiction code SIG has not yet named is on this page — flag it in the <a href={withBase("research-queue/")}>research queue</a>.</p>
  )}

  {groups.unitedStates && (
    <section aria-labelledby="group-us" data-testid="group-united-states">
      <h2 id="group-us">United States</h2>
      <p class="sig-table-note">
        States and territories under the United States — counties and places nest
        under their state.
      </p>
      <ul class="sig-dossier-index" role="list" data-testid="dossier-index">
        {flatten(groups.unitedStates).map(({ node, depth }) => (
          <DossierIndexRow row={node.row} figs={figs} keyedIndex={keyedIndex(node.row)} depth={depth} sprite={sprite} />
        ))}
      </ul>
    </section>
  )}

  {groups.otherCountries.length > 0 && (
    <section aria-labelledby="group-other" data-testid="group-other-countries">
      <h2 id="group-other">Other countries</h2>
      <p class="sig-table-note">Countries and their first-level subdivisions, A–Z.</p>
      <ul class="sig-dossier-index" role="list" data-testid="dossier-index-other">
        {groups.otherCountries.flatMap((c) =>
          flatten(c).map(({ node, depth }) => (
            <DossierIndexRow row={node.row} figs={figs} keyedIndex={keyedIndex(node.row)} depth={depth} sprite={sprite} />
          )),
        )}
      </ul>
    </section>
  )}

  {groups.unkeyed.length > 0 && (
    <section aria-labelledby="group-demos" data-testid="group-demonstrations">
      <h2 id="group-demos">Demonstration dossiers</h2>
      <p class="sig-table-note">
        Worked examples outside the canonical jurisdiction tree — the publication-rule
        demonstrations and the appendix worked dossier.
      </p>
      <ul class="sig-dossier-index" role="list" data-testid="dossier-index-demos">
        {groups.unkeyed.map((row) => (
          <DossierIndexRow row={row} figs={figs} keyedIndex={-1} sprite={null} />
        ))}
      </ul>
    </section>
  )}

  {/* The unplaced sibling — a data-quality report, never a jurisdiction
      (K4 §5.2; excluded from the count above). */}
  {unplaced !== null && (
    <section aria-labelledby="unplaced-heading" data-testid="dossier-index-unplaced">
      <h2 id="unplaced-heading">Not a jurisdiction</h2>
      <p>
        <a href={unplacedPath()} data-testid="unplaced-link">Not yet placed — the data-quality report</a>{" "}
        — <Figure figure={figs.get("unplaced-records")!} order="inline">{unplaced.records}</Figure> published
        record{unplaced.records === 1 ? "" : "s"} could not be
        placed under the recorded placement checks. It is excluded from the jurisdiction
        count above; a record here is never guessed into a place.
      </p>
    </section>
  )}

  <section aria-labelledby="field-defs" data-testid="index-field-definitions">
    <h2 id="field-defs">What the row fields mean</h2>
    <dl class="sig-definitions">
      {INDEX_FIELD_DEFINITIONS.map((d) => (
        <>
          <dt id={`fig-def-${d.id}`}>{d.field}</dt>
          <dd>{d.definition}</dd>
        </>
      ))}
    </dl>
  </section>
</BaseLayout>
