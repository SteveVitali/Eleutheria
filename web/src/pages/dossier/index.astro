// The per-jurisdiction dossier index (§39.2, SIG-UI-048 / ADR-090+ADR-093): the
// SIG-UI-010..015 local dossier made discoverable at scale. Static-first, zero client
// JS (SIG-UI-036/037). It lists every publishable jurisdiction from the P27.4 dossier
// index (through the single data seam, ADR-066) — the flat nav's hardcoded
// `/dossier/oklahoma-city/` link is replaced by this index.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getDossierIndex } from "../../lib/data";
import { dossierPath, dossierPrintPath } from "../../lib/dossier";
import { displayJurisdiction, dossierDisplayTitle } from "../../lib/jurisdictions";

// P34.14 (QW-8, F-105): names lead — the index sorts by the place's NAME so a
// reader browsing names finds them, and every row shows "Name (CODE)" with the
// code secondary. A bare code the lookup does not know fails loud (AC4/AC5).
const dossiers = [...getDossierIndex()].sort(
  (a, b) =>
    displayJurisdiction(a.jurisdiction).name.localeCompare(
      displayJurisdiction(b.jurisdiction).name,
    ) || a.subject_label.localeCompare(b.subject_label),
);
const hasUnmapped = dossiers.some((d) => !displayJurisdiction(d.jurisdiction).known);
---

<BaseLayout title="Dossiers" path="/dossier/">
  <p class="sig-lede" data-copy="DI-02 DI-03">
    A dossier is SIG's primary public artifact for a jurisdiction: what is deployed, who
    can see it, what it costs, when it must be decided, and — as a headline, not an
    appendix — <strong>what SIG does not know</strong>. Each dossier has a print view,
    and the page records the belief-time and ruleset it was built from.
  </p>
  <p data-copy="DI-04 DI-05 DI-06">
    This index lists every jurisdiction SIG has researched to a publishable standard.
    It is not a census: a jurisdiction absent here is one SIG has not yet published,{" "}
    <strong>not</strong> one with no surveillance infrastructure. These are{" "}
    <strong>inventory overviews</strong>, built automatically from published claims; the
    reviewed, evidence-complete twelve-question portfolio form is being built.
  </p>

  {dossiers.length === 0 && <EmptyState surface="dossierIndex" />}
  {hasUnmapped && (
    <p class="sig-jurisdiction-unmapped" data-testid="dossier-index-unmapped" data-copy="JD-04">A jurisdiction code SIG has not yet named is on this page — flag it in the <a href="/research-queue/">research queue</a>.</p>
  )}
  <ul class="sig-dossier-index" role="list" data-testid="dossier-index">
    {dossiers.map((d) => (
      <li class="sig-dossier-index__item" data-testid="dossier-index-item" data-slug={d.slug}>
        <a class="sig-dossier-index__link" href={dossierPath(d.slug)}>
          <span class="sig-dossier-index__subject">{dossierDisplayTitle(d.subject_label, d.jurisdiction)}</span>{" "}
          <span class="sig-dossier-index__place">{displayJurisdiction(d.jurisdiction).label}</span>
        </a>{" "}
        <span class="sig-dossier-index__meta">
          as of {d.asOf.as_of_world}
          <span aria-hidden="true"> · </span>
          <a href={dossierPrintPath(d.slug)}>print / PDF</a>
        </span>
      </li>
    ))}
  </ul>
</BaseLayout>
