// The public status page (P34.17 / R1.10). Static, zero-JS. It carries (a) notice
// N-7 verbatim — the API's dossier and terms responses are known to be wrong until
// P34.46 deploys the fix (no API hotfix, B-7) — and (b) the A-20 notice that
// live-API answers may differ from this dated site before the next published
// release. Every sentence is a pending copy-batch row (`data-copy`) or an allowed
// N-string (`data-notice`, B-2 notice allowance until GATE-G4).
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import { getSiteMetadata } from "../lib/data";
import { getReleaseStamp } from "../lib/release-stamp";
import { withBase } from "../lib/paths";
// P36.43 (TX-07, SIG-TRANSP-021/034): the status lane — the second clock.
// `getStatusLane()` reads the lane job's `sig.status-lane/1` doc (fixtures:
// the committed fixture; export: `<exportDir>/status/lane.json` when the
// lane has emitted, else honest absence).
import { getStatusLane, outcomeCells } from "../lib/status-lane";
import { fmtInt } from "../lib/format";
// P35.37 (SIG-TRANSP-013, UXR-34): the page's ONE figures[] registry — the
// lane's material counts point at the `status/lane.json` artifact.
import { artifactHref, defineFigures } from "../lib/figures";

const lane = getStatusLane();
const countOnly = lane ? lane.counts.gated + lane.counts.refused + lane.counts.withdrawn : 0;
const FIGURES = defineFigures(
  "status",
  lane
    ? [
        {
          id: "runs-24h",
          class: "headline" as const,
          value: Object.values(lane.runs.last_24h).reduce((a, b) => a + b, 0),
          artifact: "status/lane.json",
          pointer: "/runs/last_24h",
          definition: "#lane-heading",
          href: artifactHref("status/lane.json"),
          breakdown: "#fig-runs-24h",
          targets: [],
        },
        {
          id: "listed",
          class: "headline" as const,
          value: lane.counts.listed,
          artifact: "status/lane.json",
          pointer: "/counts/listed",
          definition: "#lane-heading",
          href: artifactHref("status/lane.json"),
          breakdown: "#fig-listed",
          targets: [],
        },
        {
          id: "count-only",
          class: "headline" as const,
          value: countOnly,
          artifact: "status/lane.json",
          pointer: "/counts",
          definition: "#lane-heading",
          href: artifactHref("status/lane.json"),
          breakdown: "#fig-count-only",
          targets: [],
        },
      ]
    : [],
);
const fig = (id: string) => {
  const f = FIGURES.find((x) => x.id === id);
  if (!f) throw new Error(`status figures[]: no figure registered as "${id}"`);
  return f;
};

const meta = getSiteMetadata();
const releaseId = meta.releaseId;
const asOfWorld = meta.asOf.as_of_world;
const statusTime = lane?.status_time ?? "not_recorded";
const runs24h = lane
  ? fmtInt(Object.values(lane.runs.last_24h).reduce((a, b) => a + b, 0))
  : "0";
const outcomes24h = lane ? outcomeCells(lane.runs.last_24h) : "none";
const outcomes7d = lane ? outcomeCells(lane.runs.last_7d) : "none";
const freshnessStates = lane
  ? Object.entries(lane.sources_by_freshness)
      .map(([k, n]) => `${k} ${fmtInt(n)}`)
      .join(" · ") || "none evaluated"
  : "none evaluated";
const listedCount = lane ? fmtInt(lane.counts.listed) : "0";
const drift = lane
  ? lane.scheduler_drift.state === "drift"
    ? `${fmtInt(lane.scheduler_drift.findings ?? 0)} finding(s)`
    : lane.scheduler_drift.state === "ok"
      ? "none detected"
      : "not evaluated this run"
  : "not evaluated this run";
const decisionRef = lane?.robots_disregard.decision_ref ?? "not_recorded";
const hosts = lane ? fmtInt(lane.robots_disregard.hosts) : "0";
const events = lane ? fmtInt(lane.robots_disregard.events) : "0";
// P35.13 (SIG-REL-009): the currency answer names the release fully once a
// sig.site-release/1 is bound — interim sentence until then.
const stamp = getReleaseStamp();
---

<BaseLayout title="Status" path="/status/">
  <p data-copy="ST-02">
    This page names what is known to be wrong right now and how it is being
    corrected.
  </p>

  {lane ? (
    <>
      <h2 id="lane-heading" data-copy="ST-12">The status lane</h2>
      <p data-copy="ST-13" data-testid="status-clock-label">
        Status as of <time datetime={lane.status_time}>{statusTime}</time>{" "}
        UTC — the lane updates every 6 hours and its values are not a
        citation; the published data is release {releaseId} (data as of{" "}
        {asOfWorld}).
      </p>
      <p data-copy="ST-14" id="fig-runs-24h" data-testid="lane-runs">
        In the last 24 hours <Figure figure={fig("runs-24h")} order="inline">{runs24h}</Figure>{" "}
        runs completed — {outcomes24h}; the last 7 days: {outcomes7d}.
      </p>
      <p data-copy="ST-15" id="fig-listed" data-testid="lane-freshness">
        Sources by freshness state: {freshnessStates}.
      </p>
      <p data-copy="ST-16" id="fig-count-only" data-testid="lane-count-only">
        <Figure figure={fig("listed")} order="inline">{listedCount}</Figure>{" "}
        scheduled sources are listed on{" "}
        <a href={withBase("/status/sources/")}>/status/sources/</a>;{" "}
        <Figure figure={fig("count-only")} order="inline">{countOnly}</Figure>{" "}
        gated, refused or withdrawn sources appear as counts only.
      </p>
      <p data-copy="ST-17" data-testid="lane-drift">Scheduler drift: {drift}.</p>
      <p data-copy="ST-18" data-testid="lane-robots">
        Robots disregarded under the recorded decision ({decisionRef}):{" "}
        {hosts} host(s), {events} fetch(es) — disclosed as host and count
        only.
      </p>
    </>
  ) : (
    <p data-copy="ST-19" data-testid="no-status-read">
      No status read is recorded in this build; the lane publishes a fresh
      copy every 6 hours once the status job runs.
    </p>
  )}

  <h2 id="api-heading" data-copy="ST-07">The API</h2>
  <p data-notice="N-7" data-testid="api-notice">The API's dossier and terms responses are known to be wrong and are being corrected.</p>
  <p data-copy="ST-03">
    The fix ships as part of a later release; the wrong answers stay live until
    then, marked here rather than hidden.
  </p>
  {/* P35.25 (SIG-CONF-014, S6 A-20): the lineage-basis disclosure — copy-batch
      row ST-11, staged pending for the ticket's L2 leg (the sentence describes
      the post-rematerialize basis; it ships with the OM-20 legs, not before). */}
  <p data-copy="ST-11">
    Corroboration counts and identifier matching now require declared lineage;
    records with no declared lineage are unclassified, never independent voices.
  </p>

  <h2 id="currency-heading" data-copy="ST-08">How current this site is</h2>
  {stamp ? (
    <p data-copy="ST-10" data-testid="status-release">
      Release {stamp.label} · data as of {stamp.asOfWorld} · built{" "}
      {stamp.builtAt} from code{" "}
      <a href={stamp.commitHref}><code>{stamp.commit8}</code></a> ·{" "}
      <code>{stamp.publicationShort}</code> ·{" "}
      <a href={stamp.describedby}>release.json</a>.
      This is the latest view. Cite the fixed copy:{" "}
      <a href={withBase(`/r/${stamp.publicationId}/`)}><code>/r/{stamp.publicationId}/</code></a>.
      The public API also serves newer, unreleased records, labelled "live".
    </p>
  ) : releaseId ? (
    <p data-copy="ST-04">
      This site shows release {releaseId}, data as of {asOfWorld}.
      The public API is updated continuously and may show newer records.
    </p>
  ) : (
    <p data-copy="ST-05">
      This is a development build. The public API is updated continuously and may
      show newer records.
    </p>
  )}

  <h2 id="reports-heading" data-copy="ST-09">Reports</h2>
  <p data-copy="ST-06">
    Corrections and safety reports arrive by e-mail — the{" "}
    <a href="/dispute/">dispute page</a> states the address and the handling
    order. SIG promises no response time.
  </p>
</BaseLayout>
