// The public data-freshness page (§32.4, SIG-UI-034, SIG-METRIC-006/007). Static, zero-JS.
// Per source: last successful run, last content change, current status, and the count of
// entities whose evidence is stale FOR THEIR PREDICATE CLASS — freshness is measured
// relative to predicate volatility, not absolute days (SIG-METRIC-006).
//
// P27.7 large-table UX: at national scale this table is ~210 sources. It carries a
// build-time grouping/summarisation band (counts by status) so a reader sees the shape
// first, is SORTABLE via plain GET links to pre-rendered sort routes (no client JS —
// the ordering is in the HTML, SIG-UI-037), and is capped at build time with an honest
// "showing N of M". An empty source set renders a designed, honest empty state, never a
// blank table (SIG-UI-007, §3.1).
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import Figure from "../../components/Figure.astro";
import { assertFreshnessRow, evaluableLabel, isNotEvaluable, isNotRecorded } from "../../lib/metrics";
import type { FreshnessRow } from "../../lib/metrics";
import { getFreshness, capRows } from "../../lib/data";
import { sortRows, sortHref, summariseBy } from "../../lib/tables";
import { fmtInt } from "../../lib/format";
import type { SortColumn } from "../../lib/tables";
// P35.37 (SIG-TRANSP-013, J3 §5.4, UXR-34): every freshness/run number is a
// <Figure> whose evidence is the freshness artifact + the run row (P36.46's
// route — a named absence until published).
import { artifactHref, defineFigures, freshnessTargets, type FigureSpec } from "../../lib/figures";

const BASE_PATH = "/data-freshness/";
const DEFAULT_SORT = "source";

// The columns the static table can be sorted by (each a pre-rendered route).
// P34.13 (K12b NEW-11, F-17): the "stale entities" and "volatility class" sorts
// returned the identical alphabetical table — a sort affordance that does
// nothing is a false promise, so both routes and links are REMOVED until a real
// ordering exists (UX9-2). Source and status sorts are kept: they genuinely
// re-order the rows. Stale counts and volatility classes still render as table
// columns — only the sort affordance is gone.
const COLUMNS: SortColumn<FreshnessRow>[] = [
  { key: "source", label: "Source", value: (r) => r.source },
  { key: "status", label: "Status", value: (r) => r.status },
];

// One pre-rendered page per sort order: the base path (default sort) plus one route
// per non-default key. Sorting is therefore a plain GET, archivable and no-JS.
// (The key list is local: Astro hoists getStaticPaths into its own chunk, where
// frontmatter bindings like COLUMNS are out of scope.)
export function getStaticPaths() {
  const SORT_KEYS = ["source", "status"];
  return [
    { params: { sort: undefined }, props: { sortKey: "source" } },
    ...SORT_KEYS.filter((k) => k !== "source").map((k) => ({
      params: { sort: k },
      props: { sortKey: k },
    })),
  ];
}

const { sortKey } = Astro.props as { sortKey: string };

// P34.13 (QW-11): a sort route is a distinct page — it carries a distinct title
// (every built page's title is unique; the sort title is copy-batch `title`
// row for /data-freshness/status/, B-2). The base route keeps "Data freshness".

// The freshness rows flow through the single data seam (ADR-066): fixtures by default,
// real export bytes under SIG_DATA_SOURCE=export.
const ALL_ROWS = getFreshness();
for (const row of ALL_ROWS) assertFreshnessRow(row);

// Grouping/summarisation over the FULL set (honest counts, computed before capping).
const byStatus = summariseBy(ALL_ROWS, (r) => r.status);
const byVolatility = summariseBy(ALL_ROWS, (r) => r.volatility_class);

// Sort (stable, tiebroken on source) then cap for the perf/a11y budget.
const { rows: sortedRows, active } = sortRows(ALL_ROWS, COLUMNS, sortKey, (r) => r.source);
const freshnessRows = capRows(sortedRows);

// The ONE figures[] registry for this page (UXR-34). Every count the page
// renders — the status/volatility summaries, the truncation note, each row's
// stale and not-evaluable counts — is a freshness-class <Figure> pointing
// into `web/freshness.json`.
const slug = (s: string): string =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const FRESHNESS_ARTIFACT = "web/freshness.json";
const FRESHNESS_HREF = artifactHref(FRESHNESS_ARTIFACT);
const specs: FigureSpec[] = [
  ...byStatus.map((b) => ({
    id: `summary-status-${slug(b.label)}`,
    class: "freshness" as const,
    value: b.count,
    artifact: FRESHNESS_ARTIFACT,
    pointer: "/",
    definition: "#summary-heading",
    href: FRESHNESS_HREF,
    breakdown: `#fig-summary-status-${slug(b.label)}`,
    targets: freshnessTargets(b.label),
  })),
  ...byVolatility.map((b) => ({
    id: `summary-vol-${slug(b.label)}`,
    class: "freshness" as const,
    value: b.count,
    artifact: FRESHNESS_ARTIFACT,
    pointer: "/",
    definition: "#summary-heading",
    href: FRESHNESS_HREF,
    breakdown: `#fig-summary-vol-${slug(b.label)}`,
    targets: freshnessTargets(b.label),
  })),
  ...(freshnessRows.truncated
    ? [
        {
          id: "trunc-shown",
          class: "freshness" as const,
          value: freshnessRows.shown,
          artifact: FRESHNESS_ARTIFACT,
          pointer: "/",
          definition: "#summary-heading",
          href: FRESHNESS_HREF,
          breakdown: "#fig-trunc-shown",
          targets: freshnessTargets("the capped view"),
        },
        {
          id: "trunc-total",
          class: "freshness" as const,
          value: freshnessRows.total,
          artifact: FRESHNESS_ARTIFACT,
          pointer: "/",
          definition: "#summary-heading",
          href: FRESHNESS_HREF,
          breakdown: "#fig-trunc-total",
          targets: freshnessTargets("the capped view"),
        },
      ]
    : []),
  ...freshnessRows.rows.flatMap((row) => {
    const i = ALL_ROWS.indexOf(row);
    const sid = slug(row.source);
    const rowSpecs: FigureSpec[] = [
      {
        id: `not-eval-${sid}`,
        class: "freshness",
        value: row.staleness_not_evaluable,
        artifact: FRESHNESS_ARTIFACT,
        pointer: `/${i}/staleness_not_evaluable`,
        definition: "#summary-heading",
        href: FRESHNESS_HREF,
        breakdown: `#fig-not-eval-${sid}`,
        targets: freshnessTargets(row.source),
      },
    ];
    if (!isNotEvaluable(row.status)) {
      rowSpecs.push({
        id: `stale-${sid}`,
        class: "freshness",
        value: row.stale_entity_count,
        artifact: FRESHNESS_ARTIFACT,
        pointer: `/${i}/stale_entity_count`,
        definition: "#summary-heading",
        href: FRESHNESS_HREF,
        breakdown: `#fig-stale-${sid}`,
        targets: freshnessTargets(row.source),
      });
    }
    return rowSpecs;
  }),
];
const FIGURES = defineFigures("data-freshness", specs);
const fig = (id: string) => {
  const f = FIGURES.find((x) => x.id === id);
  if (!f) throw new Error(`data-freshness figures[]: no figure registered as "${id}"`);
  return f;
};
---

<BaseLayout
  title={sortKey === "source" ? "Data freshness" : `Data freshness — sorted by ${sortKey}`}
  path={sortKey === "source" ? BASE_PATH : `${BASE_PATH}${sortKey}/`}
>
  <p>
    How current is each source? Freshness is measured <strong>relative to predicate
    volatility</strong>, not in absolute days — a two-year-old contract date is fresh; a
    two-year-old active count is historical (§32.4).
  </p>
  {ALL_ROWS.some((r) => isNotRecorded(r.last_successful_run) || isNotRecorded(r.last_content_change)) && (
    <p class="sig-table-note" data-testid="not-recorded-note">
      <strong>"Not recorded"</strong> means the record itself holds no value for that field —
      for example an ingest run whose completion was never written back, or a source that
      publishes no observation dates. SIG shows the gap rather than guessing a date (§3.1).
    </p>
  )}
  {ALL_ROWS.some((r) => isNotEvaluable(r.status)) && (
    <p class="sig-table-note" data-testid="not-evaluable-note">
      <strong>"Not evaluable"</strong> means staleness could not be evaluated for that
      source — no declared volatility class, or no dated observation staleness can be
      measured against (§32.4, SIG-METRIC-006). It is never reported as "ok".
    </p>
  )}

  {ALL_ROWS.length === 0 ? (
    <EmptyState surface="freshness" />
  ) : (
    <>
      <!-- Build-time grouping/summarisation: the shape of the table before its rows. -->
      <h2 id="summary-heading">At a glance</h2>
      <ul class="sig-table-summary" data-testid="freshness-summary" aria-labelledby="summary-heading">
        {byStatus.map((b) => (
          <li data-testid="summary-status" data-status={b.label}>
            <Figure figure={fig(`summary-status-${slug(b.label)}`)} order="inline" testid="summary-figure">
              <span class="sig-table-summary__count">{fmtInt(b.count)}</span> {evaluableLabel(b.label)}
            </Figure>
          </li>
        ))}
      </ul>
      <p class="sig-table-note">
        Volatility classes:{" "}
        {byVolatility.map((b, i) => (
          <span>{i > 0 ? " · " : ""}<Figure figure={fig(`summary-vol-${slug(b.label)}`)} order="inline"><strong>{fmtInt(b.count)}</strong> {evaluableLabel(b.label)}</Figure></span>
        ))}.
      </p>

      <!-- Static-link sorting: each is a pre-rendered route (no client JS). -->
      <nav class="sig-sort" aria-label="Sort the freshness table" data-testid="freshness-sort">
        <span class="sig-sort__label">Sort by:</span>{" "}
        {COLUMNS.map((c, i) => (
          <>
            {i > 0 && " "}
            <a
              class="sig-sort__link"
              data-testid="sort-link"
              data-sort-key={c.key}
              href={sortHref(BASE_PATH, c.key, DEFAULT_SORT)}
              aria-current={c.key === active.key ? "true" : "false"}
            >
              {c.label}{c.direction === "desc" ? " (most first)" : ""}
            </a>
          </>
        ))}
      </nav>

      {freshnessRows.truncated && (
        <p class="sig-table-note" data-testid="freshness-truncation-note">
          <Figure figure={fig("trunc-shown")} order="inline">Showing the first {fmtInt(freshnessRows.shown)}</Figure>{" "}
          <Figure figure={fig("trunc-total")} order="inline">of {fmtInt(freshnessRows.total)} sources (sorted by {active.label.toLowerCase()})</Figure>;
          the full set is in the export bundle and the API (SIG-UI-037).
        </p>
      )}

      <div class="sig-table-wrap">
        <table class="sig-freshness sig-table" data-testid="freshness-table" data-sort={active.key}>
          <caption class="sig-visually-hidden">Per-source data freshness, sorted by {active.label.toLowerCase()}</caption>
          <thead>
            <tr>
              <th scope="col">Source</th>
              <th scope="col">Last successful run</th>
              <th scope="col">Last content change</th>
              <th scope="col">Status</th>
              <th scope="col">Stale entities (for their predicate class)</th>
              <th scope="col">Staleness not evaluable</th>
              <th scope="col">Volatility class</th>
            </tr>
          </thead>
          <tbody>
            {freshnessRows.rows.map((row) => (
              <tr data-testid="freshness-row" data-source={row.source} data-status={row.status}>
                <th scope="row">{row.source}</th>
                <td>{isNotRecorded(row.last_successful_run)
                  ? <span class="sig-not-recorded" data-testid="not-recorded">not recorded</span>
                  : <time datetime={row.last_successful_run}>{row.last_successful_run}</time>}</td>
                <td>{isNotRecorded(row.last_content_change)
                  ? <span class="sig-not-recorded" data-testid="not-recorded">not recorded</span>
                  : <time datetime={row.last_content_change}>{row.last_content_change}</time>}</td>
                <td data-testid="freshness-status">{evaluableLabel(row.status)}</td>
                {/* A non-evaluable source never prints a stale figure — the number
                    would read as measured (GQ-15, ED-43). */}
                <td data-testid="stale-count">{isNotEvaluable(row.status)
                  ? "not evaluable"
                  : <Figure figure={fig(`stale-${slug(row.source)}`)} order="inline">{fmtInt(row.stale_entity_count)}</Figure>}</td>
                <td data-testid="staleness-not-evaluable"><Figure figure={fig(`not-eval-${slug(row.source)}`)} order="inline">{fmtInt(row.staleness_not_evaluable)}</Figure></td>
                <td data-testid="volatility-class">{evaluableLabel(row.volatility_class)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}
</BaseLayout>
