// The public corrections log (§39.8, SIG-UI-032) — the required EIGHTH surface the
// outline omits. Static, zero-JS: every correction lists what changed, when, why, and
// who reported it, with the outcome (correct / annotate / suppress / delete / refuse,
// SIG-GOV-004) and a link recording the belief date at which the earlier value stood
// (SIG-GOV-005). The page also states the log's start date (P34.11 / QW-14). Ends
// with the transparency report — counts by category and outcome, including refusals
// (SIG-GOV-011).
import BaseLayout from "../layouts/BaseLayout.astro";
import DisputeLink from "../components/DisputeLink.astro";
import EmptyState from "../components/EmptyState.astro";
import {
  CORRECTION_OUTCOME_META,
  orderedCorrections,
  priorValuePermalink,
  transparencyReport,
} from "../lib/corrections";
import { RULESET_VERSION } from "../lib/fixtures";
import { getCorrections, getCorrectionsProvenance } from "../lib/data";

// The corrections log + its provenance summary flow through the single data seam
// (ADR-066): fixtures by default, real export bytes under SIG_DATA_SOURCE=export.
const CORRECTIONS = getCorrections();
const CORRECTIONS_PROVENANCE = getCorrectionsProvenance();

const origin = Astro.site?.origin;
const entries = orderedCorrections(CORRECTIONS);
const report = transparencyReport(CORRECTIONS);
// The log's start date (QW-14): the earliest recorded correction, shown so the log
// never reads as if it existed from the project's first day.
const logStart = entries.map((e) => e.corrected_at).sort()[0] ?? null;
---

<BaseLayout title="Corrections log" path="/corrections/" provenance={CORRECTIONS_PROVENANCE} provenanceName="corrections log">
  <p data-copy="CL-01 CL-03 CL-04">
    Every correction SIG makes is public. A correction is a <strong>new assertion</strong>,
    never a deletion: the earlier value is preserved, and each entry names the belief
    date at which it stood (SIG-GOV-005). Each entry states{" "}
    <strong>what changed, when, why, and who reported it</strong>.
  </p>
  {logStart && (
    <p class="sig-log-start" data-testid="log-start" data-copy="CL-02">
      This log begins <time datetime={logStart}>{logStart}</time>; its counts
      cover only corrections recorded since that date.
    </p>
  )}

  <DisputeLink />

  <h2 id="log-heading">Corrections</h2>
  {entries.length === 0 && <EmptyState surface="corrections" />}
  <ol class="sig-corrections" aria-labelledby="log-heading">
    {entries.map((e) => (
      <li
        class="sig-correction"
        data-testid="correction"
        data-correction-id={e.id}
        data-category={e.category}
        data-outcome={e.outcome}
      >
        <h3>{e.subject_label}</h3>
        <dl class="sig-correction__fields">
          <div>
            <dt>What changed</dt>
            <dd data-testid="what-changed">{e.what_changed}</dd>
          </div>
          <div>
            <dt>When</dt>
            <dd data-testid="when"><time datetime={e.corrected_at}>{e.corrected_at}</time></dd>
          </div>
          <div>
            <dt>Why</dt>
            <dd data-testid="why">{e.reason}</dd>
          </div>
          <div>
            <dt>Reported by</dt>
            <dd data-testid="reported-by">{e.reported_by}</dd>
          </div>
          <div>
            <dt>Outcome</dt>
            <dd data-testid="outcome"><code>{e.outcome}</code> — {CORRECTION_OUTCOME_META[e.outcome]}</dd>
          </div>
          <div>
            <dt>Value</dt>
            <dd data-testid="value-change">
              {e.previous_withheld ? "withheld" : e.previous_value} → {e.corrected_value}
            </dd>
          </div>
        </dl>
        {e.previous_withheld ? (
          <p class="sig-correction__prior" data-testid="prior-withheld">
            The earlier assertion stays on the append-only spine, but its value is
            withheld from the public surface by current rights and sensitivity
            policy — it is not re-published here, and no fabricated value stands
            in its place.
          </p>
        ) : (
          <p class="sig-correction__prior" data-copy="CL-05">
            The earlier value is preserved on the append-only record; this link
            records the belief date at which it stood:{" "}
            <a data-testid="prior-permalink" href={priorValuePermalink(e, RULESET_VERSION, origin)}>
              belief {e.previous_belief_date}
            </a>.
          </p>
        )}
      </li>
    ))}
  </ol>

  <!-- Transparency reporting (SIG-GOV-011): counts by category and outcome, incl. refusals. -->
  <h2 id="transparency-heading">Transparency report</h2>
  <p data-testid="transparency-total">Total requests recorded: <strong>{report.total}</strong>.</p>
  <div class="sig-transparency">
    <div>
      <h3>By category</h3>
      <ul data-testid="transparency-by-category">
        {Object.entries(report.by_category).map(([cat, n]) => (
          <li data-category={cat}>{cat}: {n}</li>
        ))}
      </ul>
    </div>
    <div>
      <h3>By outcome</h3>
      <ul data-testid="transparency-by-outcome">
        {Object.entries(report.by_outcome).map(([outcome, n]) => (
          <li data-outcome={outcome} data-testid={`outcome-count-${outcome}`}>{outcome}: {n}</li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
