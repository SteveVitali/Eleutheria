---
// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The SIG project. Code is Apache-2.0; data and documentation
// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The public coverage-metrics page (§32.5, SIG-UI-034). Static, zero-JS. It publishes
// counted quantities with NAMED denominators, records-derived bounds, per-agency
// reconciliation ratios, and measured survey recall — and NEVER a total (SIG-METRIC-009).
// It publishes no completeness percentage implying a known denominator of reality
// (SIG-METRIC-010) and no capture–recapture estimate (SIG-METRIC-008). Those
// prohibitions are enforced structurally by assertCoverageMetrics at build.
//
// P35.37 (SIG-TRANSP-013, J3 §5.4, UXR-34, K12b NEW-14): every number is a <Figure>
// with a manifest artifact + JSON pointer — INCLUDING the coverage tiles (the
// national density bins), which K13 §2.6 places on this page (UXW0-1).
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import Figure from "../components/Figure.astro";
import { assertCoverageMetrics } from "../lib/metrics";
import { getCoverage, getMapDensityBins } from "../lib/data";
import { binRecordCount } from "../lib/map";
import { artifactHref, defineFigures, headlineTargets } from "../lib/figures";

// Coverage metrics flow through the single data seam (ADR-066): fixtures by default,
// real export bytes under SIG_DATA_SOURCE=export.
const COVERAGE_METRICS = getCoverage();

// A build-time gate: any metric without a named denominator, or claiming a population
// total, fails the build (SIG-METRIC-009/010).
assertCoverageMetrics(COVERAGE_METRICS);

// The coverage tiles (K12b NEW-14): the national density bins rendered as
// figures — each cell's record count carries artifact + pointer.
const TILES = getMapDensityBins();

const slug = (s: string): string => s.replace(/_/g, "-");
// The ONE figures[] registry for this page (UXR-34).
const FIGURES = defineFigures("coverage", [
  ...COVERAGE_METRICS.map((m, i) => ({
    id: `metric-${slug(m.id)}`,
    class: "headline" as const,
    value: m.value,
    artifact: "web/coverage.json",
    pointer: `/${i}/value`,
    definition: `#metric-${slug(m.id)}`,
    href: artifactHref("web/coverage.json"),
    breakdown: `#fig-metric-${slug(m.id)}`,
    targets: headlineTargets({ recordList: null }),
  })),
  ...TILES.map((b, i) => ({
    id: `tile-${i}`,
    class: "headline" as const,
    value: binRecordCount(b),
    unit: "records",
    artifact: "web/analytics/density_bins.json",
    pointer: `/bins/${i}/recordCount`,
    definition: "#coverage-tiles",
    href: artifactHref("web/analytics/density_bins.json"),
    breakdown: `#fig-tile-${i}`,
    targets: headlineTargets({ recordList: null }),
  })),
]);
const fig = (id: string) => {
  const f = FIGURES.find((x) => x.id === id);
  if (!f) throw new Error(`coverage figures[]: no figure registered as "${id}"`);
  return f;
};
---

<BaseLayout title="Coverage metrics" path="/coverage-metrics/">
  <p>
    SIG publishes what it can honestly measure: <strong>counted quantities with named
    denominators</strong>, records-derived bounds, per-agency reconciliation ratios, and
    measured survey recall. It <strong>never publishes a total</strong>, and it never
    implies it knows the denominator of reality.
  </p>
  <p class="sig-coverage-prohibition" data-testid="no-total-note">
    In particular, SIG does not publish a capture–recapture population estimate from
    volunteer mapping and vendor portal reporting (SIG-METRIC-008). The defensible claim
    is coverage of <em>known</em> entities plus an explicit statement that the true
    population is unknown.
  </p>

  {COVERAGE_METRICS.length === 0 ? (
    <EmptyState surface="coverage" />
  ) : (
    <ul class="sig-coverage" data-testid="coverage-list">
      {COVERAGE_METRICS.map((m) => (
        <li class="sig-coverage-metric" id={`metric-${slug(m.id)}`} data-testid="coverage-metric" data-kind={m.kind} data-metric-id={m.id}>
          <h2>{m.label}</h2>
          {/* The figure region covers the value AND its note — the note's
              derivations ("N merges auto-written; M await review") are part
              of the same material figure (P35.37). */}
          <Figure figure={fig(`metric-${slug(m.id)}`)} order="inline" tag="div" testid="coverage-value">
            <p class="sig-coverage-metric__value"><strong>{m.value}</strong> <span data-testid="coverage-denominator">{m.denominator}</span></p>
            <p class="sig-coverage-metric__note" data-testid="population-note">{m.population_note}</p>
          </Figure>
        </li>
      ))}
    </ul>
  )}

  {TILES.length > 0 && (
    <section aria-labelledby="coverage-tiles" data-testid="coverage-tiles">
      <h2 id="coverage-tiles">Coverage tiles</h2>
      <p>
        The national density bins — each cell's published record count with its
        evidence pointer. Low coverage is a gap, never low density.
      </p>
      <ul class="sig-coverage-tiles" role="list">
        {TILES.map((b, i) => (
          <li data-testid="coverage-tile" data-h3={b.h3} data-coverage={b.coverage}>
            <Figure figure={fig(`tile-${i}`)} order="inline" testid="coverage-tile-figure">
              <code>{b.h3}</code> — {binRecordCount(b)} record{binRecordCount(b) === 1 ? "" : "s"}
              {b.jurisdiction ? <> in {b.jurisdiction}</> : null}
              {" "}(coverage: {b.coverage})
            </Figure>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
