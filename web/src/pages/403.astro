// P34.13 (QW-11, RI-52): the branded 403 — built as a static page; the nginx
// `error_page 403` wiring that serves it is P34.40's dark roll (recorded owed).
// astro.config.mjs's sigChrome integration also emits a flat /403.html copy so
// the eventual error_page mapping matches the 404 convention.
// P36.22 (SIG-UI-151): the body renders the five-part `sig.error-page/1`
// contract — state · missing · nearby · action · change plus the search /
// status recovery links (home is the action).
import BaseLayout from "../layouts/BaseLayout.astro";
import ErrorState from "../components/ErrorState.astro";
import { errorPage } from "../lib/errors";

const spec = errorPage("refused");
---

<BaseLayout title={spec.state} path="/403/" chrome="minimal" noindex={true}>
  <ErrorState spec={spec} />
</BaseLayout>
