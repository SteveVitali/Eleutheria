// P36.59 (K7 WX-04a): `/watch/technology/<c>/page/<n>/` — facet pagination
// (K9 §6.1), emitted only for pages 2..N.
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import WatchList from "../../../../../components/WatchList.astro";
import { watchContext } from "../../../../../lib/watch-context";
import {
  facetValues,
  itemsForTechnology,
  pageCount,
  pageNumbers,
  pageSlice,
} from "../../../../../lib/watch-v2";
import { withBase } from "../../../../../lib/paths";

export function getStaticPaths() {
  const { envelope } = watchContext();
  const out: { params: { c: string; n: string }; props: { id: string; label: string; n: number } }[] = [];
  for (const t of facetValues(envelope.items, "technology")) {
    for (const n of pageNumbers(itemsForTechnology(envelope.items, t.id).length).filter((x) => x > 1)) {
      out.push({ params: { c: t.id, n: String(n) }, props: { id: t.id, label: t.label, n } });
    }
  }
  return out;
}

const { id, label, n } = Astro.props as { id: string; label: string; n: number };
const { envelope, pages } = watchContext();
const items = itemsForTechnology(envelope.items, id);
const shown = pageSlice(items, n);
const total = pageCount(items.length);
---

<BaseLayout title={`Watch — technology: ${label}, page ${n}`} path={withBase(`watch/technology/${id}/page/${n}/`)}>
  <p>
    Technology {label} — page {n} of {total}.{" "}
    <a href={withBase(`watch/technology/${id}/${n > 2 ? `page/${n - 1}/` : ""}`)}>← previous</a>
    {n < total && <> <a href={withBase(`watch/technology/${id}/page/${n + 1}/`)}>next page →</a></>}
  </p>
  <ol class="sig-watch-list">
    {shown.map((item) => <WatchList item={item} pages={pages} />)}
  </ol>
</BaseLayout>
