// P36.59 (K7 WX-04a): `/watch/page/<n>/` — the index's pagination fallback
// (K9 §6.1): emitted only for pages 2..N (page 1 IS `/watch/`).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WatchList from "../../../components/WatchList.astro";
import { watchContext } from "../../../lib/watch-context";
import { listItems, pageCount, pageNumbers, pageSlice } from "../../../lib/watch-v2";
import { withBase } from "../../../lib/paths";

export function getStaticPaths() {
  const { envelope } = watchContext();
  const items = listItems(envelope);
  // Pages 2..N only — page 1 is the index itself.
  return pageNumbers(items.length)
    .filter((n) => n > 1)
    .map((n) => ({ params: { n: String(n) }, props: { n } }));
}

const { n } = Astro.props as { n: number };
const { envelope, pages } = watchContext();
const items = listItems(envelope);
const shown = pageSlice(items, n);
const total = pageCount(items.length);
---

<BaseLayout title={`Watch — page ${n}`} path={withBase(`watch/page/${n}/`)}>
  <p>
    Upcoming decisions — page {n} of {total}.{" "}
    {n > 2 && <a href={withBase(`watch/page/${n - 1}/`)}>← previous</a>}
    {n === 2 && <a href={withBase("watch/")}>← first page</a>}
    {n < total && <> · <a href={withBase(`watch/page/${n + 1}/`)}>next page →</a></>}
  </p>
  <ol class="sig-watch-list">
    {shown.map((item) => <WatchList item={item} pages={pages} />)}
  </ol>
</BaseLayout>
