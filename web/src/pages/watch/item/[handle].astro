// P36.59 (K7 WX-04a, SIG-WATCH-002/003): the watch item page —
// `/watch/item/<handle>/`. The ONE alert date with its kind + certainty (an
// `upper_bound` never labels "deadline"), the dates timeline, the body, the
// subjects, the evidence links — supporting claims (linked to the evidence
// viewer when a route exists) + the upstream document per the J3 §5.3 lane
// table — the procedural "what you can do", the related research tasks and
// the place link. T1 zero-JS.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ContestedMarker from "../../../components/ContestedMarker.astro";
import EmptyState from "../../../components/EmptyState.astro";
import { watchContext } from "../../../lib/watch-context";
import { getEvidence, getDecisionPoints, getStatementIndex } from "../../../lib/data";
import { artifactHandles, artifactHref } from "../../../lib/evidence-hub";
import { recommendEvidence } from "../../../lib/recommender";
import { artifactTitle } from "../../../lib/evidence-hub";
import {
  evidenceRows,
  itemDateLabel,
  itemPlaceHref,
  STATUS_LABELS,
  upstreamDisplay,
  WATCH_KIND_LABELS,
  watchDecisionPoint,
} from "../../../lib/watch-v2";
import type { WatchItemV2 } from "../../../lib/watch-v2";
import { panelForClaim } from "../../../lib/provenance-panel";
import ProvenancePanelShell from "../../../components/ProvenancePanelShell.astro";
import { withBase } from "../../../lib/paths";

export function getStaticPaths() {
  const { envelope } = watchContext();
  return envelope.items.map((item) => ({
    params: { handle: item.handle },
    props: { item },
  }));
}

const { item } = Astro.props as { item: WatchItemV2 };
const { envelope, pages, names } = watchContext();
const dl = itemDateLabel(item);
const placeHref = itemPlaceHref(item, pages);
// Claim links resolve only when the evidence viewer actually emits the
// claim's route — never a dead link (the claim id renders verbatim else).
const claimRoutes = new Set(getEvidence().claimViews.map((v) => v.claim_id));
// P36.60 (EV-02): artifact links resolve through the one handle map — an id
// with no emitted page renders verbatim (never a dead link).
const artifactHandlesMap = artifactHandles(getEvidence().artifacts);
const STATEMENTS = getStatementIndex();
const evidence = evidenceRows(item);
// P37.30 (K7 §5.7, F-485): the SUBJECT-SCOPED recommender — only artifacts
// bearing on this item's subjects (or their one-hop neighbourhood) rank,
// each on the (artifact, subject) pair the score names; a non-finite score
// fails the build, never silently zero. The emitted decision_points entry
// wins; the local derivation is the honest fallback.
const evidenceData = getEvidence();
const decision = getDecisionPoints().get(item.handle) ?? watchDecisionPoint(item);
const ranked = recommendEvidence(evidenceData.artifacts, decision, evidenceData.subjectNeighbours);
const tasks = item.tasks ?? [];
const placePage = item.place?.key ? pages.find((p) => p.key === item.place!.key) : pages.find((p) => p.unplaced);
const placeDisplay = item.place?.key ? (names.get(item.place.key) ?? placePage?.name ?? item.place.key) : "Not yet placed";
---

<BaseLayout title={`Watch item — ${item.title}`} path={withBase(`watch/item/${item.handle}/`)}>
  <article class="sig-watch-item-page" data-testid="watch-item-page" data-handle={item.handle} data-kind={item.kind} data-certainty={item.date_certainty} data-contested={item.contested ? "true" : "false"}>
    <p class="sig-watch-item-page__kind">
      {WATCH_KIND_LABELS[item.kind]} · <span data-testid="item-status">{STATUS_LABELS[item.status ?? "upcoming"]}</span>{" "}
      {item.contested && <ContestedMarker compact />}
    </p>

    <h2>The date</h2>
    <p data-testid="item-date">
      <strong><time datetime={item.date}>{item.date}</time></strong> — {dl.kindLabel},{" "}
      <span data-testid="item-certainty">{dl.certaintyLabel}</span>.
      {item.date_certainty === "upper_bound" && (
        <> The real deadline may be earlier — this is the latest possible date, not a deadline.</>
      )}
    </p>
    {item.termination && (
      <dl class="sig-watch-termination" data-testid="item-termination">
        <div><dt>Contract expiry</dt><dd>{item.termination.expiry_date ?? "not_recorded"}</dd></div>
        <div>
          <dt>Auto-renewal</dt>
          <dd>
            {item.termination.auto_renews === null || item.termination.auto_renews === undefined
              ? "renewal terms not on record"
              : item.termination.auto_renews
                ? "auto-renews"
                : "does not auto-renew"}
          </dd>
        </div>
        <div><dt>Notice window</dt><dd>{item.termination.notice_window_days ?? "not_recorded"}</dd></div>
      </dl>
    )}

    {(item.timeline ?? []).length > 0 && (
      <>
        <h2>Timeline</h2>
        <ol class="sig-watch-timeline" data-testid="item-timeline">
          {item.timeline!.map((t) => (
            <li data-testid="timeline-row" data-kind={t.kind}>
              <time datetime={t.date}>{t.date}</time> — {t.kind}
            </li>
          ))}
        </ol>
      </>
    )}

    <h2>The decision</h2>
    <dl class="sig-watch-meta">
      <div><dt>Body</dt><dd data-testid="item-body">{item.body ?? "not_recorded"}</dd></div>
      <div>
        <dt>Place</dt>
        <dd data-testid="item-place">
          {placeHref ? <a href={withBase(placeHref)}>{placeDisplay}</a> : placeDisplay}
          {item.place?.basis && <> (placed by {item.place.basis})</>}
        </dd>
      </div>
      <div>
        <dt>Subjects</dt>
        <dd data-testid="item-subjects">
          {(item.subjects ?? []).length > 0
            ? item.subjects!.map((s) => <code>{s}</code>)
            : "not_recorded"}
        </dd>
      </div>
      {(item.technology ?? []).length > 0 && (
        <div><dt>Technology</dt><dd>{item.technology!.map((t) => t.label).join(", ")}</dd></div>
      )}
      {(item.vendor ?? []).length > 0 && (
        <div><dt>Vendor</dt><dd>{item.vendor!.map((v) => v.label).join(", ")}</dd></div>
      )}
      <div><dt>First seen</dt><dd>{item.first_seen ?? "not_recorded"}</dd></div>
      <div><dt>Last checked</dt><dd>{item.last_checked?.slice(0, 10) ?? envelope.generated_at ?? "not_recorded"}</dd></div>
      <div><dt>Sources</dt><dd>{(item.source_ids ?? []).join(", ") || "not_recorded"}</dd></div>
    </dl>

    {item.what_you_can_do && (
      <>
        <h2>What you can do</h2>
        <p data-testid="item-what-you-can-do">{item.what_you_can_do}</p>
        <p class="sig-watch-procedural-note">
          This is procedural information only — SIG recommends no position.
        </p>
      </>
    )}

    <h2 id="evidence-heading">Evidence ({evidence.length} claim{evidence.length === 1 ? "" : "s"})</h2>
    {evidence.length === 0 && (
      <p data-testid="item-evidence-none">
        This item's supporting claims carry no published evidence binding — the
        item itself was derived from publishable claims; the binding rows are
        the named absence, never fabricated.
      </p>
    )}
    <ul class="sig-watch-evidence" aria-labelledby="evidence-heading">
      {evidence.map((e) => {
        const up = upstreamDisplay(e.upstream);
        return (
          <li data-testid="item-evidence" data-claim-id={e.claim_id}>
            <p>
              Claim{" "}
              {claimRoutes.has(e.claim_id) ? (
                <a href={withBase(`evidence/claim/${e.claim_id}/`)} data-testid="evidence-claim-link"><code>{e.claim_id}</code></a>
              ) : (
                <code>{e.claim_id}</code>
              )}{" "}
              — <code>{e.predicate ?? "not_recorded"}</code>
              {e.source_id && <> · source <code>{e.source_id}</code></>}
            </p>
            <p data-testid="evidence-upstream">
              Upstream:{" "}
              {up.href ? (
                <a href={up.href} rel="external" data-testid="upstream-link"><code>{up.display}</code></a>
              ) : (
                <code>{up.display}</code>
              )}
            </p>
            {(e.artifact_ids ?? []).length > 0 && (
              <p>
                Artifacts:{" "}
                {e.artifact_ids!.map((aid) =>
                  artifactHandlesMap.has(aid) ? (
                    <a href={withBase(artifactHref(artifactHandlesMap.get(aid)!))} data-testid="evidence-artifact-link"><code>{aid}</code></a>
                  ) : (
                    <code>{aid}</code>
                  ),
                )}
              </p>
            )}
            {/* The shared provenance panel for the claim — the same
                sig.provenance-panel/1 every surface renders; a claim with no
                statement row renders its named-absence state. */}
            <ProvenancePanelShell panel={panelForClaim(STATEMENTS, e.claim_id, { jsonHref: null })} />
          </li>
        );
      })}
    </ul>

    <h2 id="recommend-heading">Evidence to bring ({ranked.length})</h2>
    {ranked.length === 0 ? (
      <p data-testid="recommend-empty">
        No published evidence artifact is scored for this item's subject — the
        supporting claims above are the recorded basis. When the release
        carries scored artifacts that bear on this decision, they list here
        ranked by evidentiary directness, recency and dispute status only.
      </p>
    ) : (
      <>
        <p class="sig-watch-recommend-note">
          Ranked by evidentiary directness, recency, and dispute status only —
          SIG recommends no position.{" "}
          <a href={withBase(`watch/item/${item.handle}/citations.txt`)} data-testid="recommend-citations">
            Download the citation list
          </a>
        </p>
        <ol class="sig-watch-recommend" aria-labelledby="recommend-heading">
          {ranked.map((r) => (
            <li data-testid="recommend-item" data-artifact-id={r.artifact.artifact_id} data-score={r.score} data-subject={r.matched_subject}>
              <p>
                {artifactHandlesMap.has(r.artifact.artifact_id) ? (
                  <a href={withBase(artifactHref(artifactHandlesMap.get(r.artifact.artifact_id)!))} data-testid="recommend-link">
                    {artifactTitle(r.artifact)}
                  </a>
                ) : (
                  artifactTitle(r.artifact)
                )}{" "}
                {r.contested && <ContestedMarker compact />}
              </p>
              <p class="sig-watch-recommend-why">
                {r.artifact.artifact_type.replace(/_/g, " ")} · scored on <code>{r.matched_subject}</code> ·{" "}
                {Object.entries(r.breakdown).filter(([, v]) => v > 0).map(([k]) => k.replace(/_/g, " ")).join(" · ") || "no axes"}
                {" "}· capture {r.artifact.capture_status.replace(/_/g, " ")}
              </p>
            </li>
          ))}
        </ol>
      </>
    )}

    {tasks.length > 0 && (
      <>
        <h2>Open research tasks</h2>
        <ul class="sig-watch-tasks" data-testid="item-tasks">
          {tasks.map((t) => (
            <li data-task-id={t.task_id}>
              <a href={withBase(`research-queue/#task-${t.task_id}`)}>{t.task_id}</a>
              {" "}— {t.task_type ?? "not_recorded"} ({t.status ?? "open"})
            </li>
          ))}
        </ul>
      </>
    )}

    {placePage && (
      <p>
        <a href={withBase(`watch/place/${placePage.path}/`)} data-testid="item-place-page">
          All decisions for {placePage.unplaced ? "unplaced items" : (names.get(placePage.key ?? "") ?? placePage.name)} →
        </a>
      </p>
    )}
    <p><a href={withBase("watch/feeds/")}>Subscribe to the watch feeds →</a></p>
  </article>
</BaseLayout>
