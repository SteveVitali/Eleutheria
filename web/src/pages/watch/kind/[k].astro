// P36.59 (K7 WX-04a): the kind facet route — `/watch/kind/<kind>/`, one
// dimension (J3 G-11), ≤50 rows per page (`…/page/<n>/`).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WatchList from "../../../components/WatchList.astro";
import { watchContext } from "../../../lib/watch-context";
import {
  itemsForKind,
  kindsPresent,
  pageSlice,
  pageCount,
  WATCH_KIND_LABELS,
  isWatchKind,
  type WatchKind,
} from "../../../lib/watch-v2";
import { withBase } from "../../../lib/paths";

export function getStaticPaths() {
  const { envelope } = watchContext();
  return kindsPresent(envelope.items).map((k) => ({
    params: { k },
    props: { k },
  }));
}

const { k } = Astro.props as { k: WatchKind };
if (!isWatchKind(k)) throw new Error(`watch/kind: unknown kind "${k}" (SIG-ENG-042)`);
const { envelope, pages } = watchContext();
const items = itemsForKind(envelope.items, k);
const shown = pageSlice(items, 1);
const total = pageCount(items.length);
---

<BaseLayout title={`Watch — ${WATCH_KIND_LABELS[k]}`} path={withBase(`watch/kind/${k}/`)}>
  <p>
    Upcoming decisions of kind <strong>{WATCH_KIND_LABELS[k]}</strong> ({items.length}).
  </p>
  <ol class="sig-watch-list">
    {shown.map((item) => <WatchList item={item} pages={pages} />)}
  </ol>
  {total > 1 && (
    <p class="sig-watch-pagination">
      Page 1 of {total} — <a href={withBase(`watch/kind/${k}/page/2/`)}>next page →</a>
    </p>
  )}
</BaseLayout>
