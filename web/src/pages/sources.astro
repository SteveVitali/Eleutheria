// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The interim sources-and-licences page (P34.17 / R1.8 as reassigned by A-8):
// P34.19's express-terms disclosure ships here instead of a withdrawal, and a
// source whose credit is wrong or missing shows notice N-4 until P34.21b's
// attribution re-export. The licence table is derived at build time from the
// export's own compartment rows (getSourceLicenceTable), so it can never drift
// from what the published downloads carry. Static, zero-JS.
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import {
  getAttributionCorrections,
  getSourceCounts,
  getSourceLicenceTable,
  getTermsDisclosure,
} from "../lib/data";
// P35.40 (SIG-TRANSP-002/026/027, K9 §3.1–3.3): the counting block renders the
// source universe straight out of `transparency/counts.json` — one source is
// one registry row, the six-state lifecycle partition covers every row
// exactly once (first matching precedence state wins), attributes are
// orthogonal named predicates, and anomaly identifiers are listed, never
// counted.
import { LIFECYCLE_STATES, STATE_LABELS } from "../lib/source-counts";
import { fmtInt } from "../lib/format";
import { withBase } from "../lib/paths";
// P35.37 (SIG-TRANSP-013, J3 §5.4, UXR-34): every row count is a per-source
// <Figure> — artifact web/sources.json (or web/terms_disclosure.json for the
// express-terms counts), and the /sources/<id>/ coverage target is a named
// absence until P36.48's route ships.
import { artifactHref, defineFigures, perSourceTargets, type FigureSpec } from "../lib/figures";
import { firstNumeral } from "../lib/dossier-figures";

const sources = getSourceLicenceTable();
const sourceCounts = getSourceCounts();
const disclosure = getTermsDisclosure();
const corrections = getAttributionCorrections();
const correctedOn = corrections?.corrected_on ?? null;
const correctedCount = sources.filter((s) => s.creditUnderCorrection).length;
const expressSources = new Set(disclosure.sources.map((s) => s.source_id));
const basisNumeral = firstNumeral(disclosure.basis.adopted_sentence);

// The ONE figures[] registry for this page (UXR-34).
const slug = (s: string): string =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const specs: FigureSpec[] = [
  // The counting block (P35.40): the universe and every named predicate over
  // it, all pointers into transparency/counts.json. The emitted artifact
  // already asserts the partition sums to the universe; the site renders it.
  {
    id: "count-universe",
    class: "headline",
    value: sourceCounts.universe.count,
    artifact: "transparency/counts.json",
    pointer: "/universe/count",
    definition: "#how-counted",
    href: artifactHref("transparency/counts.json"),
    breakdown: "#fig-count-universe",
    targets: [],
  },
  ...LIFECYCLE_STATES.map((state) => ({
    id: `count-${state.replace(/_/g, "-")}`,
    class: "headline" as const,
    value: sourceCounts.lifecycle[state].count,
    artifact: "transparency/counts.json",
    pointer: `/lifecycle/${state}/count`,
    definition: "#lifecycle-heading",
    href: artifactHref("transparency/counts.json"),
    breakdown: `#fig-count-${state.replace(/_/g, "-")}`,
    targets: [],
  })),
  ...(["rights_permitted", "rights_not_permitted"] as const).map((k) => ({
    id: `count-${k.replace(/_/g, "-")}`,
    class: "headline" as const,
    value: sourceCounts.attributes[k].count,
    artifact: "transparency/counts.json",
    pointer: `/attributes/${k}/count`,
    definition: "#attributes-heading",
    href: artifactHref("transparency/counts.json"),
    breakdown: "#fig-count-rights",
    targets: [],
  })),
  ...(["run_records_present", "scheduled", "site_records"] as const).map((k) => ({
    id: `count-attr-${k.replace(/_/g, "-")}`,
    class: "headline" as const,
    value: sourceCounts.attributes[k].count,
    artifact: "transparency/counts.json",
    pointer: `/attributes/${k}/count`,
    definition: "#attributes-heading",
    href: artifactHref("transparency/counts.json"),
    breakdown: `#fig-count-attr-${k.replace(/_/g, "-")}`,
    targets: [],
  })),
  ...sources.map((s, i) => ({
    id: `rows-${slug(s.sourceId)}`,
    class: "per_source" as const,
    value: s.rows,
    artifact: "web/sources.json",
    pointer: `/rows/${i}/rows`,
    definition: "#licences-heading",
    href: artifactHref("web/sources.json"),
    breakdown: `#fig-rows-${slug(s.sourceId)}`,
    targets: perSourceTargets(s.sourceId),
  })),
  ...disclosure.sources.flatMap((s, i) => {
    const out: FigureSpec[] = [];
    if (s.public_row_count != null) {
      out.push({
        id: `public-${slug(s.source_id)}`,
        class: "per_source",
        value: s.public_row_count,
        artifact: "web/terms_disclosure.json",
        pointer: `/sources/${i}/public_row_count`,
        definition: "#express-terms-heading",
        href: artifactHref("web/terms_disclosure.json"),
        breakdown: `#fig-public-${slug(s.source_id)}`,
        targets: perSourceTargets(s.source_id),
      });
    }
    if (s.export_row_count != null && s.export_row_count !== s.public_row_count) {
      out.push({
        id: `export-${slug(s.source_id)}`,
        class: "per_source",
        value: s.export_row_count,
        artifact: "web/terms_disclosure.json",
        pointer: `/sources/${i}/export_row_count`,
        definition: "#express-terms-heading",
        href: artifactHref("web/terms_disclosure.json"),
        breakdown: `#fig-export-${slug(s.source_id)}`,
        targets: perSourceTargets(s.source_id),
      });
    }
    return out;
  }),
  // The operator's verbatim basis sentence carries a row count ("≈8,088
  // currently public rows") — a material numeral inside recorded words; the
  // figure wraps the sentence without altering it.
  ...(() => {
    const n = basisNumeral;
    return n === null
      ? []
      : [
          {
            id: "basis-rows",
            class: "per_source" as const,
            value: n,
            artifact: "web/terms_disclosure.json",
            pointer: "/basis/adopted_sentence",
            definition: "#express-terms-heading",
            href: artifactHref("web/terms_disclosure.json"),
            breakdown: "#fig-basis-rows",
            targets: perSourceTargets("the express-terms sources"),
          },
        ];
  })(),
];
const FIGURES = defineFigures("sources", specs);
const fig = (id: string) => {
  const f = FIGURES.find((x) => x.id === id);
  if (!f) throw new Error(`sources figures[]: no figure registered as "${id}"`);
  return f;
};
---

<BaseLayout title="Sources and licences" path="/sources/">
  <p data-copy="SL-02">
    Every source SIG publishes rows from is listed with the licence its rows are
    filed under; a source whose express terms the operator accepted the risk of
    republishing shows its captured terms verbatim and the basis on which SIG
    publishes them.
  </p>

  <section class="sig-counting" data-testid="source-counting" aria-labelledby="how-counted">
    <h2 id="how-counted" data-copy="SC-01">How SIG counts a source</h2>
    <p data-copy="SC-02" id="fig-count-universe">
      A source is exactly one row in SIG's source registry —{" "}
      <Figure figure={fig("count-universe")} order="inline">
        {fmtInt(sourceCounts.universe.count)}
      </Figure>{" "}
      registry rows in this release. Connectors, capture hosts, mirrors, and
      tenants are attributes of a row, never sources of their own, and the
      counts recompute from the emitted rows in{" "}
      <a href={artifactHref("transparency/sources.json")}>the source-rows artifact</a>.
    </p>

    <h3 id="lifecycle-heading" data-copy="SC-03">The lifecycle partition</h3>
    <p data-copy="SC-04">
      Every registry row lands in exactly one state; the first matching state
      in precedence order wins, so the six states are a partition — they sum
      to the universe exactly once.
    </p>
    <ol class="sig-lifecycle">
      {LIFECYCLE_STATES.map((state) => {
        const entry = sourceCounts.lifecycle[state];
        return (
          <li data-testid={`lifecycle-${state}`} id={`fig-count-${state.replace(/_/g, "-")}`}>
            <strong>{STATE_LABELS[state]}</strong> —{" "}
            <Figure figure={fig(`count-${state.replace(/_/g, "-")}`)} order="inline">
              {fmtInt(entry.count)}
            </Figure>{" "}
            {entry.count === 1 ? "source" : "sources"}. {entry.definition}
          </li>
        );
      })}
    </ol>

    <h3 id="attributes-heading" data-copy="SC-05">Counted alongside the lifecycle</h3>
    <p data-copy="SC-06">
      These predicates count the same registry rows again — each is an
      independent named attribute, so they do not sum to the universe.
    </p>
    <ul class="sig-count-attrs">
      <li data-testid="attr-rights" id="fig-count-rights">
        <strong>Rights</strong> —{" "}
        <Figure figure={fig("count-rights-permitted")} order="inline">
          {fmtInt(sourceCounts.attributes.rights_permitted.count)}
        </Figure>{" "}
        permitted to ingest;{" "}
        <Figure figure={fig("count-rights-not-permitted")} order="inline">
          {fmtInt(sourceCounts.attributes.rights_not_permitted.count)}
        </Figure>{" "}
        not permitted.
      </li>
      <li data-testid="attr-run-records" id="fig-count-attr-run-records-present">
        <strong>Run records</strong> —{" "}
        <Figure figure={fig("count-attr-run-records-present")} order="inline">
          {fmtInt(sourceCounts.attributes.run_records_present.count)}
        </Figure>{" "}
        sources with run records in this release.{" "}
        {sourceCounts.attributes.run_records_present.definition}
      </li>
      <li data-testid="attr-scheduled" id="fig-count-attr-scheduled">
        <strong>Scheduled</strong> —{" "}
        <Figure figure={fig("count-attr-scheduled")} order="inline">
          {fmtInt(sourceCounts.attributes.scheduled.count)}
        </Figure>{" "}
        sources scheduled for recurring collection.{" "}
        {sourceCounts.attributes.scheduled.definition}
      </li>
      <li data-testid="attr-site-records" id="fig-count-attr-site-records">
        <strong>Site records</strong> —{" "}
        <Figure figure={fig("count-attr-site-records")} order="inline">
          {fmtInt(sourceCounts.attributes.site_records.count)}
        </Figure>{" "}
        sources with published site records.{" "}
        {sourceCounts.attributes.site_records.definition}
      </li>
    </ul>

    {sourceCounts.anomalies.ids.length > 0 && (
      <aside class="sig-notice" data-testid="source-anomalies" aria-labelledby="anomalies-heading">
        <h3 id="anomalies-heading" data-copy="SC-07">Identifiers that are not sources</h3>
        <p data-copy="SC-08">
          These identifiers carry data in this release but have no row in the
          source registry. They are anomalies — listed here and never counted
          as sources anywhere on this site:
        </p>
        <ul>
          {sourceCounts.anomalies.ids.map((id) => (
            <li data-testid="anomaly-id"><code>{id}</code></li>
          ))}
        </ul>
      </aside>
    )}

    <p data-copy="SC-09">
      The licence table below lists the sources SIG publishes rows from; the
      lifecycle partition above covers every registry row, including those
      SIG is gated from or has refused to collect.
    </p>
  </section>

  <h2 id="licences-heading" data-copy="SL-12">Sources and licences</h2>
  {/* P36.20 (UXK0-4): the table is the canonical no-JS view — `<sig-table>`
      upgrades it on this T1 page with filtering, licence/credit facet
      chips, a column chooser, column sorting and a "download this view"
      CSV whose provenance lines restate the licences the visible rows are
      filed under (`data-licence` carries them; `data-facet-*` feeds the
      chips). The module is an allow-listed T1 entry
      (tests/e2e/t1-module-entries.json); with JS off every row still
      renders. */}
  <sig-table
    filter
    facets="licence credit"
    columns
    download="sig-sources-licences"
    label="Sources and licences"
  >
  <table class="sig-sources" aria-labelledby="licences-heading">
    <thead>
      <tr>
        <th scope="col" data-copy="SL-06" data-col="source">Source</th>
        <th scope="col" data-copy="SL-07" data-col="licence">Licence</th>
        <th scope="col" data-copy="SL-08" data-col="rows">Rows</th>
        <th scope="col" data-copy="SL-09" data-col="credit">Credit</th>
        <th scope="col" data-copy="SL-10" data-col="terms">Terms</th>
      </tr>
    </thead>
    <tbody>
      {sources.map((s) => (
        <tr data-testid="source-row" data-source-id={s.sourceId} data-credit-status={s.creditUnderCorrection ? "under-correction" : "ok"} data-facet-licence={s.licenses.join("|")} data-facet-credit={s.creditUnderCorrection ? "under-correction" : "ok"} data-licence={s.licenses.join("|")}>
          <td><code>{s.sourceId}</code></td>
          <td>{s.licenses.join(", ")}</td>
          <td><Figure figure={fig(`rows-${slug(s.sourceId)}`)} order="inline" testid="source-rows-figure">{fmtInt(s.rows)}</Figure></td>
          <td>
            {s.creditUnderCorrection ? (
              <span data-notice="N-4" data-testid="credit-notice">Attribution for this source is being corrected; see the source's own terms.</span>
            ) : (
              s.attribution ?? "—"
            )}
          </td>
          <td>
            {s.termsUrl ? <a href={s.termsUrl} rel="external" data-copy="SL-14">terms</a> : "—"}
            {expressSources.has(s.sourceId) && <> (<a href="#express-terms-heading" data-copy="SL-15">express terms below</a>)</>}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  </sig-table>
  <script is:inline type="module" src={withBase("_kit/sig-table.js")}></script>
  {correctedCount > 0 && (
    <p data-copy="SL-05">
      Some credits are wrong or missing where the licence requires one; the
      correction notice above marks them, and the next data release replaces
      them.
    </p>
  )}
  {corrections !== null && corrections.corrections.length > 0 && (
    // P34.21b / E2-12: the dated correction note — rendered only when THIS
    // export's effective rights resolve through recorded ADR-194 correction
    // decisions (the artifact carries each corrected source's decided_at).
    // `{correctedOn}` is injected DATA, not drafted copy.
    <p data-copy="SL-20" data-testid="attribution-correction-note">
      Corrected {correctedOn}: earlier downloads credited some rows to the
      wrong source.
    </p>
  )}

  <h2 id="express-terms-heading" data-copy="SL-13">Express-terms sources</h2>
  {disclosure.sources.length === 0 ? (
    <p data-copy="SL-11">No source in this export carries express-terms rows.</p>
  ) : (
    <>
      <p data-copy="SL-03">
        Published under the operator's recorded acceptance of the express-terms
        risk (ADR-183); the source's captured terms appear verbatim.
      </p>
      <p data-copy="SL-04">
        Scheduled refreshes of these sources are covered by the same acceptance
        (SB-2); a new source carrying a non-commercial clause is added
        facts-and-pointers only (A-9).
      </p>
      <!-- DATA, not drafted copy: the operator's adopted sentence verbatim from
           the sig.terms-disclosure record (the basis itself, B-2 exempt as the
           operator's recorded words). -->
      {basisNumeral !== null ? (
        <Figure figure={fig("basis-rows")} order="inline" tag="div">
          <p class="sig-basis">{disclosure.basis.adopted_sentence}</p>
        </Figure>
      ) : (
        <p class="sig-basis">{disclosure.basis.adopted_sentence}</p>
      )}
      <ul class="sig-express-sources" aria-labelledby="express-terms-heading">
        {disclosure.sources.map((s) => (
          <li data-testid="express-source" data-source-id={s.source_id}>
            <h3>{s.name} <code>({s.source_id})</code></h3>
            <p>
              <a href={s.terms_url} rel="external" data-copy="SL-17">Terms page</a>
              {s.public_row_count != null && <> — <Figure figure={fig(`public-${slug(s.source_id)}`)} order="inline">{fmtInt(s.public_row_count)}</Figure> <span data-copy="SL-18">public rows</span></>}
              {s.export_row_count != null && s.export_row_count !== s.public_row_count && (
                <> — <Figure figure={fig(`export-${slug(s.source_id)}`)} order="inline">{fmtInt(s.export_row_count)}</Figure> <span data-copy="SL-19">rows in this export</span></>
              )}
            </p>
            <details>
              <summary data-copy="SL-16">Captured terms (verbatim)</summary>
              <!-- The literal captured bytes — rendered as text, never markup
                   (the capture may carry the source's own HTML). -->
              <pre class="sig-captured-terms">{s.captured_terms_verbatim}</pre>
            </details>
            <p>{s.publication_basis}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</BaseLayout>
