// P36.61 (K11 RQ-03a, SIG-RQ-006 / D-K11-1): `/research-queue/campaigns/` —
// the aggregated field-gap campaigns list, ≤50 rows per page (K9 §6.1).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QueueCampaignCard from "../../../components/QueueCampaignCard.astro";
import EmptyState from "../../../components/EmptyState.astro";
import { pageCount, pageSlice, queueCampaignsHref } from "../../../lib/queue-hub";
import { getQueueCampaigns } from "../../../lib/data";
import { withBase } from "../../../lib/paths";

const CAMPAIGNS = getQueueCampaigns();
const shown = pageSlice(CAMPAIGNS, 1);
const total = pageCount(CAMPAIGNS.length);
---

<BaseLayout title="Research queue — mapping campaigns" path={withBase("research-queue/campaigns/")}>
  <p>
    Mapping campaigns aggregate field-level gaps on individual mapped objects by
    place and missing field — one campaign, many records (SIG-RQ-006).{" "}
    <a href={withBase("research-queue/")}>Back to the queue hub</a>
  </p>
  {CAMPAIGNS.length === 0 && <EmptyState surface="researchQueue" />}
  <ol class="sig-campaigns">
    {shown.map((c) => <QueueCampaignCard campaign={c} />)}
  </ol>
  {total > 1 && (
    <p class="sig-queue-pagination" data-testid="queue-pagination">
      Page 1 of {total} — <a href={withBase(queueCampaignsHref(2))}>next page →</a>
    </p>
  )}
</BaseLayout>
