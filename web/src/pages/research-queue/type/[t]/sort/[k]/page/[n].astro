// P36.61 (K11 RQ-03a): `/research-queue/type/<t>/sort/<k>/page/<n>/` — the
// sorted facet's pagination fallback (K9 §6.1), emitted only for pages 2..N.
import BaseLayout from "../../../../../../../layouts/BaseLayout.astro";
import QueueCard from "../../../../../../../components/QueueCard.astro";
import {
  QUEUE_SORTS,
  SORT_LABELS,
  facetValues,
  pageCount,
  pageNumbers,
  pageSlice,
  queueTypeHref,
  sortQueue,
  tasksForType,
  typeLabel,
  type QueueSort,
} from "../../../../../../../lib/queue-hub";
import {
  getJurisdictionClaims,
  getQueueAsOf,
  getResearchQueue,
} from "../../../../../../../lib/data";
import { withBase } from "../../../../../../../lib/paths";

export function getStaticPaths() {
  const cards = getResearchQueue();
  const claims = getJurisdictionClaims();
  const asOf = getQueueAsOf();
  const out: {
    params: { t: string; k: string; n: string };
    props: { t: string; k: QueueSort; n: number };
  }[] = [];
  for (const f of facetValues(cards, "task_type")) {
    for (const k of QUEUE_SORTS.filter((x) => x !== "priority")) {
      const items = sortQueue(tasksForType(cards, f.id), claims, asOf, k);
      for (const n of pageNumbers(items.length).filter((x) => x > 1)) {
        out.push({ params: { t: f.id, k, n: String(n) }, props: { t: f.id, k, n } });
      }
    }
  }
  return out;
}

const { t, k, n } = Astro.props as { t: string; k: QueueSort; n: number };
const CARDS = getResearchQueue();
const CLAIMS = getJurisdictionClaims();
const AS_OF = getQueueAsOf();
const items = sortQueue(tasksForType(CARDS, t), CLAIMS, AS_OF, k);
const shown = pageSlice(items, n);
const total = pageCount(items.length);
---

<BaseLayout title={`Research queue — ${typeLabel(t)}, ${SORT_LABELS[k]}, page ${n}`} path={withBase(`research-queue/type/${t}/sort/${k}/page/${n}/`)}>
  <p>
    {typeLabel(t)} · {SORT_LABELS[k]} — page {n} of {total}.{" "}
    <a href={withBase(n > 2 ? queueTypeHref(t, k, n - 1) : `research-queue/type/${t}/sort/${k}/`)}>← previous</a>
    {n < total && <> · <a href={withBase(queueTypeHref(t, k, n + 1))}>next page →</a></>}
  </p>
  <ol class="sig-queue">
    {shown.map((card) => <QueueCard card={card} claims={CLAIMS} asOf={AS_OF} />)}
  </ol>
</BaseLayout>
