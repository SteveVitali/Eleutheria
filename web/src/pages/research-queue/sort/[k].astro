// P36.61 (K11 RQ-03a, SIG-RQ-004): `/research-queue/sort/<key>/` — the hub's
// sort routes (priority is the default order, so `priority` mints no route).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import QueueCard from "../../../components/QueueCard.astro";
import {
  QUEUE_SORTS,
  SORT_LABELS,
  pageCount,
  pageSlice,
  queueSortHref,
  sortQueue,
  type QueueSort,
} from "../../../lib/queue-hub";
import {
  getJurisdictionClaims,
  getQueueAsOf,
  getResearchQueue,
} from "../../../lib/data";
import { withBase } from "../../../lib/paths";

export function getStaticPaths() {
  return QUEUE_SORTS.filter((k) => k !== "priority").map((k) => ({
    params: { k },
    props: { k },
  }));
}

const { k } = Astro.props as { k: QueueSort };
const CARDS = getResearchQueue();
const CLAIMS = getJurisdictionClaims();
const AS_OF = getQueueAsOf();
const items = sortQueue(CARDS, CLAIMS, AS_OF, k);
const shown = pageSlice(items, 1);
const total = pageCount(items.length);
---

<BaseLayout title={`Research queue — ${SORT_LABELS[k]}`} path={withBase(`research-queue/sort/${k}/`)}>
  <p>
    Open research tasks, {SORT_LABELS[k].toLowerCase()} ({items.length}).{" "}
    <a href={withBase("research-queue/")}>Back to the queue hub</a>
  </p>
  <ol class="sig-queue">
    {shown.map((card) => <QueueCard card={card} claims={CLAIMS} asOf={AS_OF} />)}
  </ol>
  {total > 1 && (
    <p class="sig-queue-pagination" data-testid="queue-pagination">
      Page 1 of {total} — <a href={withBase(queueSortHref(k, 2))}>next page →</a>
    </p>
  )}
</BaseLayout>
