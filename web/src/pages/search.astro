// The search / filter surface (§40, SIG-UI-040/047 island; P27.9, ADR-097;
// P32.14, ADR-133 / SIG-FIND-003). Released-corpus search is the primary path:
// one no-JS GET form per licence compartment pins an immutable release and
// asks the read API's verified FTS5 index — plus complete static browse pages
// that need no service at all. The OPT-IN island stays a quick filter over the
// listed index (never the whole corpus); with JavaScript disabled the forms,
// browse links and island degrade honestly (SIG-UI-037/050).
import BaseLayout from "../layouts/BaseLayout.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import SearchIsland from "../islands/SearchIsland";
import type { SearchItem } from "../islands/SearchIsland";
import {
  getDossierIndex,
  getMapSites,
  getFreshness,
  getReleaseSearchTargets,
  getLatestReleaseTarget,
  getEntityCompartments,
  releasedRecordHref,
  capRows,
} from "../lib/data";
import "../styles/islands.css";

const dossiers = getDossierIndex();
const sites = getMapSites();
const sources = getFreshness();
const targets = getReleaseSearchTargets();
const latest = getLatestReleaseTarget();

// Specific released-record hrefs where a real activated release maps them —
// a listed site resolves to /r/<pub>/c/<comp>/entity/<type>/<id>/, never a
// generic /map/ link when its record is citable.
const entityComps = latest ? getEntityCompartments() : new Map();
const siteHref = (id: string): string =>
  releasedRecordHref(latest, entityComps, id) ?? "/map/";

// The `focus` id a listed site hands to the workspace: the self-describing
// record_key where the release maps it (islands resolve its record JSON /
// routes), else the bare asset id the map island's points carry (fixtures).
const siteFocusId = (id: string): string => {
  const m = entityComps.get(id);
  return m ? `${m.compartment}:${m.entityType}:${id}` : id;
};

// Cap the map-site rows fed to the client index so the page stays within budget at
// national scale (tens of thousands of sites); the FULL corpus is searched by the
// released-corpus forms + static browse pages above.
const cappedSites = capRows(sites);

const INDEX: SearchItem[] = [
  ...dossiers.map((d) => ({
    kind: "dossier" as const,
    label: d.subject_label,
    sublabel: d.jurisdiction,
    href: `/dossier/${d.slug}/`,
  })),
  ...cappedSites.rows.map((s) => ({
    kind: "site" as const,
    label: s.label,
    sublabel: s.jurisdiction,
    href: siteHref(s.id),
    focusId: siteFocusId(s.id),
  })),
  ...sources.map((r) => ({
    kind: "source" as const,
    label: r.source,
    sublabel: `status: ${r.status}`,
    href: "/data-freshness/",
  })),
];
---

<BaseLayout title="Search" path="/search/">
  <p>
    Search the <strong>full eligible released corpus</strong> — every record an
    immutable release publishes, in its own licence compartment — or filter the
    listed index interactively. Both work without client JavaScript
    (SIG-UI-037): the forms are plain GETs and the static browse pages
    enumerate every released record.
  </p>

  <ViewSwitch view="list" release={latest?.publicationId ?? null} />

  <!-- P32.14 (SIG-FIND-003): released-corpus search — the complete corpus, one
       compartment at a time, pinned to an immutable namespace. -->
  {targets.length > 0 ? (
    <section aria-labelledby="release-search-heading" data-testid="release-search">
      <h2 id="release-search-heading">Search an immutable release</h2>
      {targets.map((t) => (
        <div data-testid="release-search-target">
          <p>
            Release <a href={t.landingHref}><code>{t.publicationId}</code></a> —{" "}
            {t.recordCount} released records across{" "}
            {t.compartments.length} licence compartment{t.compartments.length === 1 ? "" : "s"}.
          </p>
          {t.compartments.map((c) => (
            <div class="sig-release-search__compartment" data-testid="release-search-compartment">
              <h3>
                <code>{c.compartment}</code>{" "}
                <span class="sig-island__note">
                  {c.license} — {c.recordCount} records
                </span>
              </h3>
              <form method="get" action={c.searchHref} data-testid="release-search-form">
                <input type="hidden" name="format" value="html" />
                <label>
                  Words or an exact identifier{" "}
                  <input type="search" name="q" maxlength={200} size={36} />
                </label>{" "}
                <button type="submit">Search this compartment</button>
              </form>
              <p>
                <a href={c.overviewHref}>Complete browse</a> — every record,
                paginated, with no service required.
              </p>
            </div>
          ))}
        </div>
      ))}
    </section>
  ) : (
    <section data-testid="release-search-empty">
      <h2>Search an immutable release</h2>
      <p>
        <em>No immutable release is activated for this surface yet</em> — the
        released-corpus search forms appear here once a release is activated.
        The browse index below still lists the published surface.
      </p>
    </section>
  )}

  <!-- The OPT-IN search island (P27.9, ADR-097). Hydrates only here; empty with JS off. -->
  <section class="sig-island" aria-labelledby="search-island-heading" data-testid="search-island-section">
    <h2 id="search-island-heading">Quick filter — the listed index</h2>
    <SearchIsland client:only="react" items={INDEX} release={latest?.publicationId ?? null} />
  </section>

  <!-- The no-JS BROWSE fallback: real GET links, always present (SIG-UI-050). -->
  <section aria-labelledby="browse-heading" data-testid="search-browse">
    <h2 id="browse-heading">Browse the record</h2>
    <p>Without JavaScript, browse the record directly:</p>
    <ul>
      <li>
        <a href="/dossier/">Dossier index</a> — {dossiers.length} jurisdiction dossier{dossiers.length === 1 ? "" : "s"}.
      </li>
      <li>
        <a href="/map/">Infrastructure map</a> — {sites.length} mapped site{sites.length === 1 ? "" : "s"} (tabular equivalent on the page).
      </li>
      <li>
        <a href="/data-freshness/">Sources &amp; data freshness</a> — {sources.length} source{sources.length === 1 ? "" : "s"} with per-source freshness.
      </li>
      <li>
        <a href="/network/">Network explorer</a> and the <a href="/research-queue/">research queue</a> for what is not yet researched.
      </li>
      <li>
        <a href="/releases/">Immutable releases</a> — complete browse of every
        activated release, record by record, compartment by compartment.
      </li>
    </ul>
    {cappedSites.truncated && (
      <p class="sig-island__note" data-testid="search-cap-note">
        The interactive filter covers {cappedSites.shown} of {cappedSites.total} listed
        sites — a sample, never the corpus. Every eligible record is reachable through
        the released-corpus search and the compartment browse pages.
      </p>
    )}
  </section>
</BaseLayout>
