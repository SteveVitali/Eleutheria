// The task-intake page a clicked absence hatch lands on (SIG-UI-007). It is fully
// static and needs no client JavaScript: one page is pre-generated per taskable
// absence (the fixture registry `TASKABLE_ABSENCES`), and the page renders the
// well-formed, GENERATED research-task descriptor derived from the slug. This is
// the end of the "gap → research task" flow: absence is an invitation, not a
// dead end.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { absenceTaskHref, buildResearchTask, decodeTaskSlug, taskSlug } from "../../../lib/task";
import { ABSENCE_KIND_META } from "../../../lib/epistemic";
import { TASKABLE_ABSENCES } from "../../../lib/fixtures";
import { dossierTaskableAbsences } from "../../../lib/dossier";
import { DOSSIERS } from "../../../lib/dossier-fixture";

export function getStaticPaths() {
  // The shell's own taskable absences plus every clickable gap in every dossier
  // (SIG-UI-007/011). Deduplicate by slug so a gap that appears in both a dossier
  // row and its "what we don't know" list generates exactly one intake page.
  const all = [...TASKABLE_ABSENCES, ...DOSSIERS.flatMap(dossierTaskableAbsences)];
  const bySlug = new Map<string, (typeof all)[number]>();
  for (const params of all) bySlug.set(taskSlug(params), params);
  return [...bySlug.keys()].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const params = slug ? decodeTaskSlug(slug) : null;
const task = params ? buildResearchTask(params) : null;
const meta = params ? ABSENCE_KIND_META[params.absence_kind] : null;
const path = params ? absenceTaskHref(params) : "/task/new/";
---

<BaseLayout title="Generate a research task" path={path}>
  {task && params && meta ? (
    <section data-testid="generated-task" data-task-status={task.status} data-task-type={task.task_type}>
      <p>
        A research task has been generated from this gap. It enters the queue in the
        <strong> {task.status}</strong> state and is keyed for de-duplication on
        <code> ({task.dedup_key[0]}, {task.dedup_key[1]})</code>.
      </p>
      <dl class="sig-task">
        <dt>Task type</dt><dd data-testid="task-field-type">{task.task_type}</dd>
        <dt>Status</dt><dd data-testid="task-field-status">{task.status}</dd>
        <dt>Subject</dt><dd data-testid="task-field-subject">{task.subject_id}</dd>
        <dt>Predicate</dt><dd data-testid="task-field-predicate">{task.predicate_id}</dd>
        <dt>Absence kind</dt><dd data-testid="task-field-absence">{meta.label} ({task.absence_kind})</dd>
        <dt>Rationale</dt><dd data-testid="task-field-rationale">{task.rationale}</dd>
      </dl>
      <p>
        This descriptor mirrors the engine's <code>research_task</code> row; the
        production queue accepts it and routes it by assignee class.
      </p>
    </section>
  ) : (
    <section data-testid="task-error">
      <p>This gap could not be turned into a research task: the request was malformed.</p>
      <p><a href="/visual-language/">Return to the visual-language reference.</a></p>
    </section>
  )}
</BaseLayout>
