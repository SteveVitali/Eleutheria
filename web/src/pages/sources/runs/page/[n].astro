// P36.48 fix arc (UX9-3, SIG-TRANSP-028, K9 §6.1): the Runs & freshness
// view's continuation pages — `/sources/runs/page/<n>/`. Page 1 is
// `/sources/runs/` itself.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SourcesTablePage from "../../../../components/SourcesTablePage.astro";
import { getTableRows, pageNumbers } from "../../../../lib/sources-table";
import { withBase } from "../../../../lib/paths";

export function getStaticPaths() {
  const { rows } = getTableRows();
  return pageNumbers(rows.length).map((n) => ({
    params: { n: String(n) },
    props: { page: n },
  }));
}

const { page } = Astro.props as { page: number };
---

<BaseLayout title={`Sources — runs and freshness, page ${page}`} path={withBase(`sources/runs/page/${page}/`)}>
  <SourcesTablePage view="runs" page={page} />
</BaseLayout>
