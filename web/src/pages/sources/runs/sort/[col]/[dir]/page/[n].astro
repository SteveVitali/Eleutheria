// P36.48 fix arc (UX9-3, SIG-TRANSP-028, K9 §6.1): the Runs & freshness
// view's sort-route continuation pages — `/sources/runs/sort/<col>/<dir>/page/<n>/`.
import BaseLayout from "../../../../../../../layouts/BaseLayout.astro";
import SourcesTablePage from "../../../../../../../components/SourcesTablePage.astro";
import {
  getTableRows,
  pageNumbers,
  sortRoutesFor,
  SORT_SPECS,
} from "../../../../../../../lib/sources-table";
import type { SortDir } from "../../../../../../../lib/sources-table";
import { withBase } from "../../../../../../../lib/paths";

export function getStaticPaths() {
  const { rows } = getTableRows();
  return sortRoutesFor("runs").flatMap(({ col, dir }) =>
    pageNumbers(rows.length).map((n) => ({
      params: { col, dir, n: String(n) },
      props: { col, dir, page: n },
    })),
  );
}

const { col, dir, page } = Astro.props as { col: string; dir: SortDir; page: number };
const spec = SORT_SPECS[col];
if (!spec || (dir !== "asc" && dir !== "desc")) {
  throw new Error(`sources/runs/sort: unregistered sort ${col}/${dir} (SIG-ENG-042)`);
}
---

<BaseLayout title={`Sources — runs and freshness, ${col} ${dir === "desc" ? "descending" : "ascending"}, page ${page}`} path={withBase(`sources/runs/sort/${col}/${dir}/page/${page}/`)}>
  <SourcesTablePage view="runs" sortKey={col} sortDir={dir} page={page} />
</BaseLayout>
