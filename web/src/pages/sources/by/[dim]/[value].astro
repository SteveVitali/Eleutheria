// P36.48 (UX9-3, SIG-TRANSP-028): the single-dimension facet routes —
// `/sources/by/<dim>/<value>/` renders the Overview view's row set for the
// facet predicate in the default sort (K9 §6.1: no facet × sort product).
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SourcesTablePage from "../../../../components/SourcesTablePage.astro";
import { facetDim, facetRoutes, facetValueSlug, getTableRows } from "../../../../lib/sources-table";
import { withBase } from "../../../../lib/paths";

export function getStaticPaths() {
  const { rows } = getTableRows();
  // params.value is the slugged segment (K9 facet routes are lowercase
  // paths); props.value stays the rendered predicate value.
  return facetRoutes(rows).map(({ dim, value }) => ({
    params: { dim, value: facetValueSlug(value) },
    props: { dim, value },
  }));
}

const { dim, value } = Astro.props as { dim: string; value: string };
if (facetDim(dim) === null) {
  throw new Error(`sources/by: unregistered facet dimension "${dim}" (SIG-ENG-042)`);
}
---

<BaseLayout title={`Sources — ${dim}: ${value}`} path={withBase(`sources/by/${dim}/${facetValueSlug(value)}/`)}>
  <SourcesTablePage view="overview" facet={{ dim, value }} />
</BaseLayout>
