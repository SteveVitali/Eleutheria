// P36.48 fix arc (UX9-3, SIG-TRANSP-028, K9 §6.1): the Overview sort routes'
// continuation pages — `/sources/sort/<col>/<dir>/page/<n>/` keeps the sort
// preserved across the paginated row set. Page 1 is the sort route itself.
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import SourcesTablePage from "../../../../../../components/SourcesTablePage.astro";
import {
  getTableRows,
  pageNumbers,
  sortRoutesFor,
  SORT_SPECS,
} from "../../../../../../lib/sources-table";
import type { SortDir } from "../../../../../../lib/sources-table";
import { withBase } from "../../../../../../lib/paths";

export function getStaticPaths() {
  const { rows } = getTableRows();
  return sortRoutesFor("overview").flatMap(({ col, dir }) =>
    pageNumbers(rows.length).map((n) => ({
      params: { col, dir, n: String(n) },
      props: { col, dir, page: n },
    })),
  );
}

const { col, dir, page } = Astro.props as { col: string; dir: SortDir; page: number };
const spec = SORT_SPECS[col];
if (!spec || (dir !== "asc" && dir !== "desc")) {
  throw new Error(`sources/sort: unregistered sort ${col}/${dir} (SIG-ENG-042)`);
}
---

<BaseLayout title={`Sources — overview, ${col} ${dir === "desc" ? "descending" : "ascending"}, page ${page}`} path={withBase(`sources/sort/${col}/${dir}/page/${page}/`)}>
  <SourcesTablePage view="overview" sortKey={col} sortDir={dir} page={page} />
</BaseLayout>
