// P36.48 (UX9-3, SIG-TRANSP-028): the Rights & downloads view's sort routes.
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import SourcesTablePage from "../../../../../components/SourcesTablePage.astro";
import { sortRoutesFor, SORT_SPECS } from "../../../../../lib/sources-table";
import type { SortDir } from "../../../../../lib/sources-table";
import { withBase } from "../../../../../lib/paths";

export function getStaticPaths() {
  return sortRoutesFor("rights").map(({ col, dir }) => ({
    params: { col, dir },
    props: { col, dir },
  }));
}

const { col, dir } = Astro.props as { col: string; dir: SortDir };
const spec = SORT_SPECS[col];
if (!spec || (dir !== "asc" && dir !== "desc")) {
  throw new Error(`sources/rights/sort: unregistered sort ${col}/${dir} (SIG-ENG-042)`);
}
---

<BaseLayout title={`Sources — rights and downloads, ${col} ${dir === "desc" ? "descending" : "ascending"}`} path={withBase(`sources/rights/sort/${col}/${dir}/`)}>
  <SourcesTablePage view="rights" sortKey={col} sortDir={dir} />
</BaseLayout>
