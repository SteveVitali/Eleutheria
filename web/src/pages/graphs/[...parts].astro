// P37.24 (K2 GX-08a, SIG-UI-117/118, SIG-EXPORT-015) — one rest route for
// the T1 overview pages: `/graphs/<ov>/`, `…/page/<n>/` (adjacency table
// paginated ≤ 100 rows) and `…/<country>/<sub>/` per-place drill-downs.
// The static SVG positions come precomputed from the artifact (K2 §6.3);
// the words live in the adjacency table.
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getGraphIndex,
  getGraphOverview,
  getDossiers,
} from "../../lib/data";
import { overviewAtPlace } from "../../lib/graph-overview";
import type { OverviewEdge, OverviewNode } from "../../lib/graph-overview";
import { withBase } from "../../lib/paths";

const PER_PAGE = 100;

export function getStaticPaths() {
  const PAGE_SIZE = 100;
  const out: { params: { parts: string | undefined } }[] = [];
  for (const entry of getGraphIndex()) {
    const ov = getGraphOverview(entry.id);
    if (!ov) continue;
    const pages = Math.max(1, Math.ceil(ov.edges.length / PAGE_SIZE));
    for (let n = 1; n <= pages; n++) {
      out.push({ params: { parts: n === 1 ? entry.id : `${entry.id}/page/${n}` } });
    }
    for (const place of entry.places) {
      // K4 display path (usa/tx[/deeper]) → the drill-down route.
      for (const seg of [place]) {
        const path = seg.split("-");
        if (path.length >= 2)
          out.push({ params: { parts: `${entry.id}/${path[0]}/${path.slice(1).join("-")}` } });
      }
    }
  }
  return out;
}

const parts = (Astro.params.parts ?? "").split(/\//).filter(Boolean);
const ovId = parts[0] ?? "";
const ov = getGraphOverview(ovId);
const indexEntry = getGraphIndex().find((r) => r.id === ovId);

let placeKey: string | null = null;
let pageNum = 1;
if (parts[1] === "page") pageNum = Number(parts[2] ?? 1) || 1;
else if (parts.length >= 3) placeKey = `${parts[1]}-${parts.slice(2).join("-")}`;
else if (parts.length === 2) placeKey = `${parts[1]}`;

const placeName = placeKey
  ? (getDossiers().find((x) => x.slug === placeKey.split("-").join(String.fromCharCode(47)))?.subject_label ?? placeKey)
  : null;

const scoped = ov && placeKey ? overviewAtPlace(ov, placeKey) : ov ? { nodes: ov.nodes, edges: ov.edges } : { nodes: [], edges: [] };
const nodeByKey = new Map(scoped.nodes.map((n: OverviewNode) => [n.key, n]));
const totalPages = Math.max(1, Math.ceil(scoped.edges.length / PER_PAGE));
const page = Math.min(Math.max(1, pageNum), totalPages);
const rows = scoped.edges.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const nodeLabel = (k: string) => nodeByKey.get(k)?.label ?? k;
const nodeHref = (k: string) => {
  const h = nodeByKey.get(k)?.href;
  return h ? withBase(h.replace(/^\//, "")) : null;
};

const maxX = Math.max(0, ...scoped.nodes.map((n) => n.x)) + 60;
const maxY = Math.max(0, ...scoped.nodes.map((n) => n.y)) + 40;
const edgeCls = (e: OverviewEdge) =>
  e.currency === "HISTORICAL" ? "historical" : e.dateKind === "undated" ? "undated" : "current";
---

<BaseLayout
  title={ov ? `${ov.title} overview` : "Overview graph"}
  path={withBase(`graphs/${ovId}/`)}
  crumbs={[
    { label: "Overview graphs", href: withBase("graphs/") },
    { label: ov?.title ?? ovId },
  ]}
  lede={ov?.question ?? ""}
>
  {!ov && (
    <section class="sig-empty" data-testid="empty-state">
      <p class="sig-empty__heading" data-testid="empty-state-state" data-copy="GO-07">Overview not in this release</p>
      <p class="sig-empty__text" data-copy="GO-08">
        This release emits no {ovId} overview — an honest absence, never a
        hidden one. The emitted overviews are listed on the hub.
      </p>
      <p class="sig-empty__text"><a href={withBase("graphs/")}>All overview graphs</a></p>
    </section>
  )}
  {ov && (
    <>
      {placeKey && (
        <p class="sig-lede" data-copy="GO-04">
          Scoped to <strong>{placeName}</strong> —{" "}
          <a href={withBase(`graphs/${ovId}/`)}>whole {ov.title.toLowerCase()} overview</a>.
        </p>
      )}
      <p class="sig-table-note">
        {scoped.nodes.length} nodes · {scoped.edges.length} edges · release {ov.release.label}
        {ov.release.asOf ? ` as of ${ov.release.asOf}` : ""} · {ov.positionNote}
        {ov.capActions.length > 0 && ` · ${ov.capActions.join("; ")}`}
      </p>
      {scoped.nodes.length > 0 && (
        <figure class="sig-figure" data-testid="graph-figure">
          <svg
            viewBox={`0 0 ${Math.ceil(maxX)} ${Math.ceil(maxY)}`}
            role="img"
            aria-label={`${ov.title} overview — static figure; the adjacency table below carries the same facts`}
          >
            {scoped.edges.map((e) => {
              const a = nodeByKey.get(e.src), b = nodeByKey.get(e.dst);
              if (!a || !b) return null;
              return (
                <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class={`sig-graph-edge sig-graph-edge-${edgeCls(e)}`} />
              );
            })}
            {scoped.nodes.map((n) => {
              const inner = <circle cx={n.x} cy={n.y} r={4} class={`sig-graph-node sig-graph-node-${n.band}`}><title>{n.label}</title></circle>;
              const href = nodeHref(n.key);
              return href ? <a href={href}>{inner}</a> : inner;
            })}
            {scoped.nodes.filter((n) => n.band === "kind" || n.band === "group").map((n) => (
              <text x={n.x + 8} y={n.y + 4} class="sig-graph-label">{n.label}</text>
            ))}
          </svg>
        </figure>
      )}
      <table class="sig-table" data-testid="graph-edges">
        <thead>
          <tr><th>From</th><th>Relation</th><th>To</th><th>Date</th><th>Currency</th><th>Sources</th><th>Evidence</th></tr>
        </thead>
        <tbody>
          {rows.map((e) => (
            <tr data-testid="graph-edge-row">
              <td>{nodeHref(e.src) ? <a href={nodeHref(e.src)!}>{nodeLabel(e.src)}</a> : nodeLabel(e.src)}</td>
              <td>{e.relation}</td>
              <td>{nodeHref(e.dst) ? <a href={nodeHref(e.dst)!}>{nodeLabel(e.dst)}</a> : nodeLabel(e.dst)}</td>
              <td>{e.date ?? <span class="sig-typed-state">undated</span>}</td>
              <td>{e.currency === "HISTORICAL" || e.dateKind === "undated" ? <span class="sig-typed-state">{e.currency.toLowerCase()}</span> : e.currency.toLowerCase()}</td>
              <td>{e.sources.join("; ")}</td>
              <td class="sig-num">{e.evidenceCount}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {totalPages > 1 && (
        <p class="sig-table-note">
          Page {page} of {totalPages} —{" "}
          {Array.from({ length: totalPages }, (_, i) => (
            <>
              {i > 0 && " "}
              {i + 1 === page ? <span aria-current="page">{i + 1}</span> : <a href={withBase(`graphs/${ovId}/page/${i + 1}/`)}>{i + 1}</a>}
            </>
          ))}
        </p>
      )}
      <p class="sig-table-note">
        <strong data-copy="GO-05">Downloads — per licence compartment:</strong>
        {getGraphIndex().find((r) => r.id === ovId)?.compartments.map((c) => (
          <> {c} (<a href={withBase(`graph/${ovId}/${c}.json`)}>JSON</a>, <a href={withBase(`graph/${ovId}/edges.${c}.csv`)}>edges CSV</a>, <a href={withBase(`graph/${ovId}/nodes.${c}.csv`)}>nodes CSV</a>, <a href={withBase(`graph/${ovId}/overview.${c}.svg`)}>SVG</a>) </>
        ))}
      </p>
      <p class="sig-table-note"><strong>Entity resolution.</strong> {ov.erDisclosure}</p>
      {indexEntry && indexEntry.places.length > 0 && !placeKey && (
        <p class="sig-table-note">
          <strong data-copy="GO-06">Drill down by place:</strong>{" "}
          {indexEntry.places.map((p, i) => {
            const seg = p.split("-");
            return (
              <>
                {i > 0 && " · "}
                <a href={withBase(`graphs/${ovId}/${seg[0]}/${seg.slice(1).join("-")}/`)}>{p}</a>
              </>
            );
          })}
        </p>
      )}
    </>
  )}
</BaseLayout>
