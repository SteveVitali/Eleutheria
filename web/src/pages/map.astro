---
// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The SIG project. Code is Apache-2.0; data and documentation
// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The infrastructure map (§39.3). The shipped page is static-first (SIG-UI-036):
// the data-bearing layers, the coverage-bound point control, the
// low-coverage≠low-density encoding, the national-zoom bins, and the no-coordinate
// jurisdiction indicators all render server-side, and the TABULAR EQUIVALENT below
// is the source of truth and the no-JS/screen-reader path (SIG-UI-037). The map is
// SERVED from self-hosted static PMTiles v3 — one z0–z14 archive per licence
// compartment (P31.15, ADR-R9-TILES) with per-source attribution and NO basemap
// (Q8) — the style is at /map/style.json (SIG-UI-038, SIG-GEO-012/013); the
// maplibre-gl runtime reaches the page only inside the `/map` island allowance
// (SIG-UI-047), so archivability and the island budget hold. The combined,
// licence-mixed /map/points.json is retired (Q9 — R8-1 ending).
// P34.15 (QW-12/K1 NEW-20/K12b NEW-7): the tables count RECORDS (never "devices"),
// legend entries with no records are dropped, a value-suppressed bin prints no
// count, and contested locations roll up to a per-jurisdiction count that leads
// to the dossier — never a dead task link.
import BaseLayout from "../layouts/BaseLayout.astro";
import AbsenceHatch from "../components/AbsenceHatch.astro";
import EmptyState from "../components/EmptyState.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import { summariseBy } from "../lib/tables";
import {
  LAYER_CONTROLS,
  OBSERVED_LAYERS,
  DERIVED_LAYERS,
  NATIONAL_ZOOM_MAX,
  POINT_LAYER_ID,
  COVERAGE_LAYER_ID,
  DEFAULT_SHARING_EDGE_VIEW,
  binCountLabel,
  contestedCount,
  coverageEncoding,
  islandPoints,
  jurisdictionSlug,
  layerControlsWithData,
  layersWithData,
  boundedJurisdictionIndicators,
  partitionByLocatability,
  readsAsDensity,
  renderBin,
} from "../lib/map";
import { MAP_ATTRIBUTION_LINE } from "../lib/map-tiles";
import {
  getDossiers,
  getMapSites,
  getMapDensityBins,
  getCompartmentTileSources,
  getLatestReleaseTarget,
  getEntityCompartments,
  releasedRecordHref,
  capRows,
  getSiteMetadata,
} from "../lib/data";
import { dossierPath } from "../lib/dossier";
import { beliefPinnedPermalink } from "../lib/citation";
import MapIsland from "../islands/MapIsland";
import "../styles/islands.css";

// The map's assets + national-view density bins flow through the single data seam
// (ADR-066): committed fixtures by default, real export bytes under SIG_DATA_SOURCE=export.
const MAP_ASSETS = getMapSites();
const DENSITY_BINS = getMapDensityBins();

const { locatable, jurisdictionIndicators } = partitionByLocatability(MAP_ASSETS);
// The no-coordinate enumeration is BOUNDED inline (P32.15, SIG-FIND-005): the
// honest jurisdiction count is kept, but the id list is capped and the
// remainder stays navigable through the released compartment browse — the
// same complete static pagination P32.14 delivered.
const boundIndicators = boundedJurisdictionIndicators(jurisdictionIndicators);
// id → asset, so the indicator list below is linear at national scale (not a find per id).
const ASSET_BY_ID = new Map(MAP_ASSETS.map((a) => [a.id, a]));
const maxCount = Math.max(1, ...DENSITY_BINS.map((b) => b.deviceCount));
const bins = DENSITY_BINS.map((b) => ({ bin: b, render: renderBin(b, maxCount) }));

// Build-time cap so the tabular equivalent stays within budget at national scale
// (tens of thousands of sites); the honest total is preserved. P27.7 adds a build-time
// per-jurisdiction summary band so a reader sees the shape before the (capped) rows.
const locatableRows = capRows(locatable);
const assetsByJurisdiction = summariseBy(locatable, (a) => a.jurisdiction);

// Which layer id each control governs, for the "bound control" display.
const boundControl = LAYER_CONTROLS.find(
  (c) => c.governs.includes(POINT_LAYER_ID) && c.governs.includes(COVERAGE_LAYER_ID),
)!;

// P34.15 (QW-12): a legend entry implies data — controls and layer labels are
// listed ONLY when a layer they name carries records in this build. Today the
// map draws device points/indicators (physical_devices) and the coverage
// underlay; every other §39.3 layer has no records yet and is not listed.
const DATA_LAYER_IDS: ReadonlySet<string> = new Set([
  ...(MAP_ASSETS.length > 0 ? [POINT_LAYER_ID] : []),
  ...(bins.length > 0 ? [COVERAGE_LAYER_ID] : []),
]);
const visibleControls = layerControlsWithData(LAYER_CONTROLS, DATA_LAYER_IDS);
const layersDropped = visibleControls.length < LAYER_CONTROLS.length;
const observedWithData = layersWithData(OBSERVED_LAYERS, DATA_LAYER_IDS);
const derivedWithData = layersWithData(DERIVED_LAYERS, DATA_LAYER_IDS);

// P34.15 (K12b NEW-7): the retired per-record "⚠ Unresolved" affordances (dead
// /task/new/ links) become a per-jurisdiction contested count that leads to the
// dossier — only where a dossier with the jurisdiction's slug exists, so the
// count never links to a 404. The count covers ALL of the indicator's records,
// not just the inline-listed cap. A partial export tree without dossiers.json
// degrades to the count without the link — never a build failure, never a 404.
const DOSSIER_SLUGS = new Set(
  (() => {
    try {
      return getDossiers().map((d) => d.slug);
    } catch {
      return [] as string[];
    }
  })(),
);
const CONTESTED_BY_JURISDICTION = new Map(
  jurisdictionIndicators.map((j) => [
    j.jurisdiction,
    contestedCount(j.assetIds, ASSET_BY_ID),
  ]),
);
const dossierSlugFor = (jurisdiction: string): string | null => {
  const slug = jurisdictionSlug(jurisdiction);
  return DOSSIER_SLUGS.has(slug) ? slug : null;
};

// A tiny static bin strip so the low-coverage≠low-density encoding is visible.
const cell = 64;

// P27.9 (ADR-097): the OPT-IN interactive map island. It draws ONLY the already
// tier-reduced, publishable points (§19.4) — the same `locatable` set the table
// below renders — so it can never imply more precision than SIG published, and it is
// a progressive enhancement layered over that table, never a replacement (SIG-UI-050).
// P31.15 (ADR-R9-TILES): the island layers the per-compartment PMTiles archives the
// export ships (one attributed source per compartment — never the retired,
// licence-mixed /map/points.json). A build with no archives (the fixtures) passes the
// small inline fallback list instead.
const TILE_SOURCES = getCompartmentTileSources();
const ISLAND_POINT_COUNT = locatable.filter((a) => a.lat !== null && a.lon !== null).length;
const ISLAND_FALLBACK_POINTS = TILE_SOURCES.length === 0 ? islandPoints(locatable) : [];

// P32.15 (SIG-FIND-004): the shared workspace state — the latest activated
// release the `release=` param defaults to, the compartment set the island's
// switch governs (tile archives in export mode; the release catalog's
// compartments otherwise), and the specific released-record hrefs the table
// links where the release maps an asset id.
const LATEST = getLatestReleaseTarget();
const entityComps = LATEST ? getEntityCompartments() : new Map();
const recordHref = (id: string): string | null =>
  releasedRecordHref(LATEST, entityComps, id);
const ISLAND_COMPARTMENTS = TILE_SOURCES.length > 0
  ? TILE_SOURCES.map((t) => ({ id: t.compartment, license: t.license }))
  : (LATEST?.compartments.map((c) => ({ id: c.compartment, license: c.license })) ?? []);
const meta = getSiteMetadata();
const mapCitationHref = beliefPinnedPermalink({
  path: "/map/",
  title: "Infrastructure map",
  asOf: meta.asOf,
  rulesetVersion: meta.rulesetVersion,
});
---

<BaseLayout title="Infrastructure map" path="/map/">
  <p data-copy="MP-01 MP-02 MP-03">
    The surveillance-infrastructure map. Everything the map shows is also in the
    tables below — they are the equivalent, not a fallback; the interactive map
    is an opt-in enhancement that loads only when JavaScript runs. The tiles
    are self-hosted static vector archives — no third-party tile CDN is required.
  </p>

  <ViewSwitch view="map" release={LATEST?.publicationId ?? null} />

  <!-- The OPT-IN interactive map island (P27.9, ADR-097; exercises SIG-UI-047).
       It hydrates only here; with JavaScript disabled this block is empty and the
       tabular equivalent below is the full, usable surface (SIG-UI-037/050). -->
  <section class="sig-island sig-map-island" aria-labelledby="map-island-heading" data-testid="map-island-section">
    <h2 id="map-island-heading">Interactive map</h2>
    {ISLAND_POINT_COUNT > 0 ? (
      <MapIsland
        client:only="react"
        tiles={TILE_SOURCES}
        points={ISLAND_FALLBACK_POINTS}
        pointCount={ISLAND_POINT_COUNT}
        attribution={MAP_ATTRIBUTION_LINE}
        citationHref={mapCitationHref}
        release={LATEST?.publicationId ?? null}
        compartments={ISLAND_COMPARTMENTS}
      />
    ) : (
      <p class="sig-island__note">No publishable points to draw at this belief; see the tabular equivalent below.</p>
    )}
    <p class="sig-island__note" data-testid="map-island-attribution">
      {MAP_ATTRIBUTION_LINE}. Interactive rendering is a progressive enhancement;
      the tables below are the archivable equivalent (SIG-UI-037/038/050).
    </p>
  </section>

  <!-- Layers (SIG-UI-016): observed layers, plus DERIVED layers flagged distinct. -->
  <h2 id="layers-heading">Layers</h2>
  <ul class="sig-layer-controls" data-testid="map-layer-controls" aria-labelledby="layers-heading">
    {visibleControls.map((c) => {
      const bound = c.id === boundControl.id;
      return (
        <li
          class="sig-layer-control"
          data-testid="layer-control"
          data-control-id={c.id}
          data-governs={c.governs.join(",")}
          data-bound={bound ? "true" : "false"}
        >
          <strong>{c.label}</strong>
          {bound && (
            <span class="sig-layer-control__note">
              — a single bound control: you cannot show devices without also showing where
              SIG has <em>not</em> looked (SIG-UI-017).
            </span>
          )}
        </li>
      );
    })}
  </ul>
  {layersDropped && (
    <p class="sig-island__note" data-testid="layers-not-listed" data-copy="MP-04">Layers with no records in this build are not listed.</p>
  )}

  <details class="sig-recon">
    <summary>Observed vs derived layers (SIG-GEO-006)</summary>
    <div class="sig-recon__body">
      {observedWithData.length > 0 && (
        <p><strong>Observed</strong> (a record): {observedWithData.map((l) => l.label).join(", ")}.</p>
      )}
      {derivedWithData.length > 0 && (
        <p>
          <strong>Derived</strong> (a model, drawn distinctly and separately toggled):{" "}
          {derivedWithData.map((l) => l.label).join(", ")}.
        </p>
      )}
    </div>
  </details>

  <!-- National-zoom density bins with the low-coverage≠low-density encoding. -->
  <h2 id="coverage-heading">National view: density binning with coverage (SIG-UI-018/019)</h2>
  <p>
    At national zoom (≤ {NATIONAL_ZOOM_MAX}) the map bins density rather than drawing
    individual points. <strong>Low coverage is desaturated and hatched</strong> so
    "we don't know" never reads as "there is little here."
  </p>
  <figure aria-labelledby="bins-caption">
    <svg
      role="img"
      aria-label="Density bins; low-coverage cells are hatched and desaturated, distinct from confidently-low-density cells."
      viewBox={`0 0 ${cell * bins.length} ${cell + 40}`}
      width={cell * bins.length}
      height={cell + 40}
      style="max-width:100%;border:1px solid var(--sig-rule);background:hsl(0deg 0% 98%);"
    >
      {bins.map(({ bin, render }, i) => (
        <g>
          <rect
            x={i * cell + 6}
            y={6}
            width={cell - 12}
            height={cell - 12}
            fill={render.coverage.desaturated
              ? "hsl(220deg 8% 82%)"
              : `hsl(214deg 70% ${72 - render.densityBucket * 14}%)`}
            stroke={render.coverage.hatched ? "var(--sig-epi-absence-ink)" : "var(--sig-rule)"}
            stroke-dasharray={render.coverage.hatched ? "3 2" : undefined}
          >
            <title>{coverageEncoding(bin.coverage).valueSuppressed
              ? `${bin.jurisdiction}: record count suppressed, coverage ${bin.coverage}`
              : `${bin.jurisdiction}: ${bin.deviceCount} record(s), coverage ${bin.coverage}`}</title>
          </rect>
          <text x={i * cell + cell / 2} y={cell + 12} text-anchor="middle" font-size="9">
            {bin.coverage}
          </text>
          <text x={i * cell + cell / 2} y={cell + 26} text-anchor="middle" font-size="9">
            {binCountLabel(bin)}
          </text>
        </g>
      ))}
    </svg>
    <figcaption id="bins-caption">
      Each cell is an H3 bin (§19.5). A grey hatched cell means SIG has barely looked;
      its count is suppressed, not shown as a low density.
    </figcaption>
  </figure>

  <h2 id="bins-table-heading">Coverage bins (tabular equivalent)</h2>
  {bins.length === 0 && <EmptyState surface="mapBins" />}
  <div class="sig-table-wrap">
  <table class="sig-table" aria-labelledby="bins-table-heading">
    <thead>
      <tr>
        <th scope="col">H3 cell</th>
        <th scope="col">Jurisdiction</th>
        <th scope="col" data-copy="MP-05">Records</th>
        <th scope="col">Coverage</th>
        <th scope="col">Reads as</th>
      </tr>
    </thead>
    <tbody>
      {bins.map(({ bin }) => (
        <tr
          data-testid="coverage-bin"
          data-coverage={bin.coverage}
          data-desaturated={coverageEncoding(bin.coverage).desaturated ? "true" : "false"}
          data-hatched={coverageEncoding(bin.coverage).hatched ? "true" : "false"}
          data-reads-as-density={readsAsDensity(bin) ? "true" : "false"}
        >
          <th scope="row"><code>{bin.h3}</code></th>
          <td>{bin.jurisdiction}</td>
          <td>{binCountLabel(bin)}</td>
          <td>{coverageEncoding(bin.coverage).label}</td>
          <td>{readsAsDensity(bin) ? "a density signal" : "we don't know (coverage too low)"}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>

  <!-- The tabular equivalent for the asset points + jurisdiction indicators. -->
  <h2 id="assets-heading" data-copy="MP-07">Located records (tabular equivalent)</h2>
  {locatable.length === 0 ? (
    <EmptyState surface="mapAssets" />
  ) : (
    <>
      <!-- Build-time per-jurisdiction summarisation: the shape before the rows. -->
      <ul class="sig-table-summary" data-testid="assets-summary">
        {assetsByJurisdiction.map((b) => (
          <li data-testid="assets-summary-item" data-jurisdiction={b.label}>
            <span class="sig-table-summary__count">{b.count}</span> {b.label}
          </li>
        ))}
      </ul>
      {locatableRows.truncated && (
        <p class="sig-table-note" data-testid="assets-truncation-note">
          <span data-copy="MP-09">Showing the first {locatableRows.shown} of {locatableRows.total} located records</span>
          {LATEST ? (
            <>
              {" "}— every released record remains navigable in the{" "}
              {LATEST.compartments.map((c, i) => (
                <>
                  {i > 0 && " · "}
                  <a href={c.overviewHref}>compartment browse</a>
                </>
              ))}{" "}
              and the export bundle/API (SIG-UI-037).
            </>
          ) : (
            <>; the full set is in the export bundle and the API (SIG-UI-037).</>
          )}
        </p>
      )}
      <div class="sig-table-wrap">
      <table class="sig-table" aria-labelledby="assets-heading">
        <thead>
      <tr>
        <th scope="col" data-copy="MP-08">Record</th>
        <th scope="col">Jurisdiction</th>
        <th scope="col">Tier</th>
        <th scope="col">Latitude</th>
        <th scope="col">Longitude</th>
        <th scope="col">Published precision</th>
      </tr>
    </thead>
    <tbody>
      {locatableRows.rows.map((a) => (
        <tr data-testid="map-asset-row">
          <th scope="row">
            {recordHref(a.id) ? (
              <a href={recordHref(a.id)!} data-testid="map-asset-record">{a.label}</a>
            ) : (
              a.label
            )}
          </th>
          <td>{a.jurisdiction}</td>
          <td>{a.tier}</td>
          <td>{a.lat}</td>
          <td>{a.lon}</td>
          <td>{a.precision}</td>
        </tr>
      ))}
        </tbody>
      </table>
      </div>
    </>
  )}

  <!-- No-coordinate records: jurisdiction indicators, never dropped (SIG-UI-020). -->
  <h2 id="nocoord-heading" data-copy="MP-10">Records without a published point</h2>
  <p data-copy="MP-14 MP-15">
    Records with no coordinates — or whose sensitivity tier forbids publishing a
    point — are <strong>not dropped</strong>. They appear as jurisdiction-level
    indicators, so the map does not systematically understate capability
    (SIG-UI-020).
  </p>
  {jurisdictionIndicators.length === 0 && <EmptyState surface="mapIndicators" />}
  <ul class="sig-jurisdiction-indicators">
    {boundIndicators.map((j) => {
      const contested = CONTESTED_BY_JURISDICTION.get(j.jurisdiction) ?? 0;
      const dossierSlug = dossierSlugFor(j.jurisdiction);
      return (
      <li data-testid="jurisdiction-indicator" data-count={j.count}>
        <strong>{j.jurisdiction}</strong>: <span data-copy="MP-11">{j.count} record(s) with no published point.</span>
        {contested > 0 && dossierSlug !== null && (
          <span class="sig-jurisdiction-contested" data-testid="jurisdiction-contested" data-count={contested} data-copy="MP-12"> — {contested} contested; see the <a href={dossierPath(dossierSlug)} data-testid="contested-dossier-link">{j.jurisdiction} dossier</a>.</span>
        )}
        {contested > 0 && dossierSlug === null && (
          <span class="sig-jurisdiction-contested" data-testid="jurisdiction-contested" data-count={contested} data-copy="MP-13"> — {contested} contested.</span>
        )}
        <ul>
          {j.listedIds.map((id) => {
            const asset = ASSET_BY_ID.get(id)!;
            const href = recordHref(asset.id);
            return (
              <li>
                {href ? <a href={href}>{asset.label}</a> : asset.label} — {asset.precision}
                {asset.locationAbsence && (
                  <> <AbsenceHatch
                    kind={asset.locationAbsence}
                    subject_id={asset.id}
                    predicate_id="location"
                    predicate_label="Location"
                  /></>
                )}
              </li>
            );
          })}
        </ul>
        {j.truncated && (
          <p class="sig-table-note" data-testid="indicator-bounds-note">
            … and {j.count - j.listedIds.length} more in {j.jurisdiction} — every record
            remains navigable
            {LATEST ? (
              <>
                {" "}in the{" "}
                {LATEST.compartments.map((c, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={c.overviewHref}>released compartment browse</a>
                  </>
                ))}
                .
              </>
            ) : (
              <> in the export bundle and the API.</>
            )}
          </p>
        )}
      </li>
      );
    })}
  </ul>

  <h2 id="sharing-heading">Sharing edges</h2>
  <p>
    Sharing edges default to an <strong>{DEFAULT_SHARING_EDGE_VIEW} network</strong> from a
    selected entity — never a national hairball (SIG-UI-021). Explore them in the{" "}
    <a href="/network/">network explorer</a>, which also offers matrix and arc views.
  </p>

  <!-- OSM attribution in every rendering context, incl. print (SIG-GEO-013). -->
  <p class="sig-map-attribution" data-testid="map-attribution">
    {MAP_ATTRIBUTION_LINE}. Tiles served as static PMTiles v3 —{" "}
    <a href="/map/style.json">map style</a> (SIG-GEO-012, SIG-UI-038).
  </p>
</BaseLayout>
