---
// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The SIG project. Code is Apache-2.0; data and documentation
// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The infrastructure map (§39.3). P36.36 (K1 MAP-05, UXR-18): the NO-JS
// baseline — a ≤ 100 KiB document carrying the static overview figure, the
// place form and the places table, with every per-record row moved to the
// paginated `/dossier/<path>/sites/` lists (the interim site-record link
// target, SIG-UI-068). The interactive renderer is the opt-in T2 surface
// (P36.37 owns its app half); without JavaScript this page is complete.
import BaseLayout from "../layouts/BaseLayout.astro";
import AbsenceChip from "../components/AbsenceChip.astro";
import EmptyState from "../components/EmptyState.astro";
import ViewSwitch from "../components/ViewSwitch.astro";
import NoJsStateNotice from "../components/NoJsStateNotice.astro";
import CiteThisView from "../components/CiteThisView.astro";
import {
  LAYER_CONTROLS,
  NATIONAL_ZOOM_MAX,
  POINT_LAYER_ID,
  COVERAGE_LAYER_ID,
  DEFAULT_SHARING_EDGE_VIEW,
  binAriaLabel,
  binCountLabel,
  binJurisdictionKeys,
  contestedCount,
  coverageEncoding,
  islandPoints,
  layerControlsWithData,
  layersWithData,
  boundedJurisdictionIndicators,
  partitionByLocatability,
  readsAsDensity,
  renderBin,
  OBSERVED_LAYERS,
  DERIVED_LAYERS,
} from "../lib/map";
import { EMPTY_TILE_STATE_NOTE, mapAttributionLine } from "../lib/map-tiles";
import {
  dataSource,
  getDossiers,
  getDossierIndex,
  getJurisdictionKeyMap,
  getMapSites,
  getMapDensityBins,
  getMapOverview,
  getCompartmentTileSources,
  getLatestReleaseTarget,
  getSiteMetadata,
  capRows,
} from "../lib/data";
import {
  buildJurisdictionLookup,
  buildSitesModel,
  buildPlaceTable,
  emittedSiteLists,
  dossierSitesPath,
  dossierSitesHref,
} from "../lib/sites";
import { dossierPath } from "../lib/dossier";
import { beliefPinnedPermalink } from "../lib/citation";
import { withBase } from "../lib/paths";
import MapIsland from "../islands/MapIsland";
import "../styles/islands.css";

const MAP_ASSETS = getMapSites();
const DENSITY_BINS = getMapDensityBins();

const { locatable, jurisdictionIndicators } = partitionByLocatability(MAP_ASSETS);
const boundIndicators = boundedJurisdictionIndicators(jurisdictionIndicators, 10);
const ASSET_BY_ID = new Map(MAP_ASSETS.map((a) => [a.id, a]));
const maxCount = Math.max(1, ...DENSITY_BINS.map((b) => b.recordCount));
const allBins = DENSITY_BINS.map((b) => ({ bin: b, render: renderBin(b, maxCount) }));
const cappedBins = capRows(allBins);
const bins = cappedBins.rows;

// P36.36 (MAP-05): the per-dossier sites model — every record resolves to its
// deepest published dossier; the places table and the sites lists derive from
// the SAME resolution, so the counts reconcile by construction.
const DOSSIERS = getDossiers();
const lookup = buildJurisdictionLookup(
  DOSSIERS,
  getDossierIndex(),
  getJurisdictionKeyMap(),
);
const sitesModel = buildSitesModel(MAP_ASSETS, lookup);
const places = buildPlaceTable(sitesModel, DOSSIERS);
// P36.36 (UXR-18 / SIG-UI-068): record id → its emitted sites-list page — the
// interim per-record link target; only lists that actually emit (≥ 1 located
// record) may be linked, so an anchor can never 404.
const SLUG_BY_ASSET_ID = new Map(
  emittedSiteLists(sitesModel).flatMap((l) => l.rows.map((r) => [r.id, l.slug] as const)),
);
const siteRecordHref = (id: string): string | null => {
  const slug = SLUG_BY_ASSET_ID.get(id);
  return slug ? withBase(dossierSitesHref(slug, id)) : null;
};

const DATA_LAYER_IDS: ReadonlySet<string> = new Set([
  ...(MAP_ASSETS.length > 0 ? [POINT_LAYER_ID] : []),
  ...(bins.length > 0 ? [COVERAGE_LAYER_ID] : []),
]);
const visibleControls = layerControlsWithData(LAYER_CONTROLS, DATA_LAYER_IDS);
const layersDropped = visibleControls.length < LAYER_CONTROLS.length;
const observedWithData = layersWithData(OBSERVED_LAYERS, DATA_LAYER_IDS);
const derivedWithData = layersWithData(DERIVED_LAYERS, DATA_LAYER_IDS);

const DOSSIER_SLUGS = new Set(DOSSIERS.map((d) => d.slug));
const CONTESTED_BY_JURISDICTION = new Map(
  jurisdictionIndicators.map((j) => [
    j.jurisdiction,
    contestedCount(j.assetIds, ASSET_BY_ID),
  ]),
);
// P36.36: contested counts lead to the dossier the records resolve to —
// the keyed canonical slug path, never a re-derived flat slug.
const dossierSlugFor = (jurisdiction: string): string | null => {
  const asset = jurisdictionIndicators
    .find((j) => j.jurisdiction === jurisdiction)
    ?.assetIds.map((id) => ASSET_BY_ID.get(id))
    .find((a) => a !== undefined);
  if (asset) {
    const key = asset.jurisdictionKey ?? (asset.jurisdiction.includes(":") ? asset.jurisdiction : null);
    const slug = key ? lookup.slugByJkey.get(key) ?? null : null;
    if (slug && DOSSIER_SLUGS.has(slug)) return slug;
  }
  return null;
};

const cell = 64;

// The opt-in interactive island (unchanged T2 surface — P36.37's app row).
const TILE_SOURCES = getCompartmentTileSources();
const EMPTY_TILE_STATE = dataSource() === "export" && TILE_SOURCES.length === 0;
const ATTRIBUTION_LINE = mapAttributionLine(TILE_SOURCES);
const ISLAND_POINT_COUNT = locatable.filter((a) => a.lat !== null && a.lon !== null).length;
const ISLAND_FALLBACK_POINTS = TILE_SOURCES.length === 0 ? islandPoints(locatable) : [];

const LATEST = getLatestReleaseTarget();
const ISLAND_COMPARTMENTS = TILE_SOURCES.length > 0
  ? TILE_SOURCES.map((t) => ({
      id: t.compartment,
      license: t.license,
      attribution: t.attribution,
    }))
  : (LATEST?.compartments.map((c) => ({ id: c.compartment, license: c.license })) ?? []);
const meta = getSiteMetadata();
const PLACEHOLDER_MAX_K = 24;
const placeholderK = Math.max(0, ISLAND_COMPARTMENTS.length - 2);
if (placeholderK > PLACEHOLDER_MAX_K) {
  throw new Error(
    `map: ${ISLAND_COMPARTMENTS.length} licence compartments exceed the ` +
      `placeholder reservation table (islands.css --k0…--k${PLACEHOLDER_MAX_K}) — ` +
      `extend the generated classes, never swallow the layout reservation`,
  );
}
const mapCitationHref = beliefPinnedPermalink({
  path: "/map/",
  title: "Infrastructure map",
  asOf: meta.asOf,
  rulesetVersion: meta.rulesetVersion,
});
const overview = getMapOverview();
// The place form's native suggestions — the same display-name lookup the
// dossier index uses, bounded so the document stays inside its wire budget.
const PLACE_OPTIONS_MAX = 200;
const placeRows = getDossierIndex().slice(0, PLACE_OPTIONS_MAX);
const placeOptionLabel = (d: (typeof placeRows)[number]) =>
  d.display_name ?? d.name ?? d.subject_label;
---

<BaseLayout title="Infrastructure map" path="/map/">
  <p data-copy="MP-01 MP-02 MP-03">
    The surveillance-infrastructure map. Everything the map shows is also in the
    tables below — they are the equivalent, not a fallback; the interactive map
    is an opt-in enhancement that loads only when JavaScript runs. The tiles
    are self-hosted static vector archives — no third-party tile CDN is required.
  </p>

  <ViewSwitch view="map" release={LATEST?.publicationId ?? null} />

  <!-- The OPT-IN interactive map island (P27.9, ADR-097; exercises SIG-UI-047). -->
  <section class="sig-island sig-map-island" aria-labelledby="map-island-heading" data-testid="map-island-section">
    <h2 id="map-island-heading">Interactive map</h2>
    <NoJsStateNotice
      params={["release", "collection", "jurisdiction", "frame", "bbox", "at", "layers", "basemap", "focus", "view"]}
      equivalents={[
        { href: "#overview-heading", label: "the static overview" },
        { href: "#places-heading", label: "the places table" },
        { href: "#bins-table-heading", label: "the coverage-bins table" },
      ]}
    />
    <CiteThisView
      view="map"
      release={LATEST?.publicationId ?? null}
      equivalents={[
        { href: "#places-heading", label: "the places table" },
        { href: "#bins-table-heading", label: "the coverage-bins table" },
      ]}
    />
    {EMPTY_TILE_STATE && (
      <p class="sig-island__note" data-testid="empty-tile-state">
        {EMPTY_TILE_STATE_NOTE}
      </p>
    )}
    {ISLAND_POINT_COUNT > 0 ? (
      <>
        <div
          class={`sig-island__placeholder sig-island__placeholder--k${placeholderK}`}
          data-testid="map-island-placeholder"
          role="note"
        >
          <p class="sig-island__note">
            The interactive map loads only when JavaScript runs — the tables
            below carry the same records and are the complete equivalent.
          </p>
        </div>
        <MapIsland
          client:only="react"
          tiles={TILE_SOURCES}
          points={ISLAND_FALLBACK_POINTS}
          pointCount={ISLAND_POINT_COUNT}
          attribution={ATTRIBUTION_LINE}
          citationHref={mapCitationHref}
          release={LATEST?.publicationId ?? null}
          compartments={ISLAND_COMPARTMENTS}
        />
      </>
    ) : (
      <p class="sig-island__note">No publishable points to draw at this belief; see the tabular equivalent below.</p>
    )}
    <p class="sig-island__note" data-testid="map-island-attribution">
      {ATTRIBUTION_LINE}. Interactive rendering is a progressive enhancement;
      the tables below are the archivable equivalent (SIG-UI-037/038/050).
    </p>
  </section>

  <!-- P36.36 (MAP-05, SIG-UI-105): the static national overview — a build-time
       SVG figure (FIG-01a) with its own attribution; the places table below is
       its tabular equivalent. -->
  <h2 id="overview-heading" data-copy="SL-MAP-04">Static overview</h2>
  {overview !== null ? (
    <figure aria-labelledby="overview-caption">
      <img
        src={withBase(overview.href)}
        alt="National overview of published located records — binned density over jurisdiction outlines"
        data-testid="map-overview"
        loading="eager"
        decoding="async"
      />
      <figcaption id="overview-caption" data-copy="SL-MAP-05">
        A build-time static rendition of the located records, binned so no single
        point implies more precision than SIG published. The places table below is
        its tabular equivalent (SIG-UI-037).
      </figcaption>
    </figure>
  ) : (
    <p class="sig-island__note" data-testid="map-overview-absent" data-copy="SL-MAP-06">
      This export does not emit the drawn overview figure — the places table
      below carries the same counts (SIG-ENG-042: an honest absence, never a
      fabricated map).
    </p>
  )}

  <!-- The place form (K1 §5 / C-24): a zero-JS GET to the release-pinned
       search's place kind; the A–Z directory is the static fallback. -->
  <form
    method="get"
    action={withBase("search/")}
    class="sig-place-search"
    data-testid="place-search-form"
  >
    <label for="map-place-q">Find a place:</label>{" "}
    <input id="map-place-q" type="search" name="q" maxlength={200} size={30} placeholder="State, county or city" list="map-place-names" />
    <input type="hidden" name="type" value="place" />
    <button type="submit">Search</button>{" "}
    <datalist id="map-place-names">
      {placeRows.map((d) => (
        <option data-slug={d.slug} value={placeOptionLabel(d)} />
      ))}
    </datalist>{" "}
    <span class="sig-place-search__note" data-testid="place-search-fallback" data-copy="SL-MAP-07">
      If search cannot be reached, the first letter of a place's name finds it in the{" "}
      <a href={withBase("dossier/a-z/")}>A–Z directory</a>.
    </span>
  </form>

  <!-- Layers (SIG-UI-016): observed layers, plus DERIVED layers flagged distinct. -->
  <h2 id="layers-heading">Layers</h2>
  <ul class="sig-layer-controls" data-testid="map-layer-controls" aria-labelledby="layers-heading">
    {visibleControls.map((c) => {
      const bound = c.id === "devices_and_coverage";
      return (
        <li
          class="sig-layer-control"
          data-testid="layer-control"
          data-control-id={c.id}
          data-governs={c.governs.join(",")}
          data-bound={bound ? "true" : "false"}
        >
          <strong>{c.label}</strong>
          {bound && (
            <span class="sig-layer-control__note">
              — a single bound control: you cannot show records without also showing where
              SIG has <em>not</em> looked (SIG-UI-017).
            </span>
          )}
        </li>
      );
    })}
  </ul>
  {layersDropped && (
    <p class="sig-island__note" data-testid="layers-not-listed" data-copy="MP-04">Layers with no records in this build are not listed.</p>
  )}

  <details class="sig-recon">
    <summary>Observed vs derived layers (SIG-GEO-006)</summary>
    <div class="sig-recon__body">
      {observedWithData.length > 0 && (
        <p><strong>Observed</strong> (a record): {observedWithData.map((l) => l.label).join(", ")}.</p>
      )}
      {derivedWithData.length > 0 && (
        <p>
          <strong>Derived</strong> (a model, drawn distinctly and separately toggled):{" "}
          {derivedWithData.map((l) => l.label).join(", ")}.
        </p>
      )}
    </div>
  </details>

  <!-- P36.36 (MAP-05, SIG-UI-105): the places table — the located-records
       tabular equivalent, grouped by country, ≤ 70 rows, every count shown
       with its coverage, and each jurisdiction's own paginated sites list. -->
  <h2 id="places-heading" data-copy="MP-07">Located records (tabular equivalent)</h2>
  <p data-copy="SL-MAP-08">
    Every jurisdiction SIG has located records in, with its own full site
    list — a paginated page per place, the interim per-record link target.
  </p>
  {places.totalRows === 0 && <EmptyState surface="mapAssets" />}
  {places.totalRows > 0 && (
    <>
      <div class="sig-table-wrap" data-testid="assets-summary">
      <table class="sig-table" aria-labelledby="places-heading" data-testid="places-table">
        <thead>
          <tr>
            <th scope="col">Place</th>
            <th scope="col">Published located records</th>
            <th scope="col">Sources</th>
            <th scope="col">Share single-source</th>
            <th scope="col">No published point</th>
            <th scope="col">Site list</th>
          </tr>
        </thead>
        <tbody>
          {places.groups.map((g) => (
            <>
              <tr data-testid="places-country" data-country={g.countrySlug}>
                <th scope="rowgroup" colspan="6">
                  {DOSSIER_SLUGS.has(g.countrySlug) ? (
                    <a href={withBase(dossierPath(g.countrySlug).replace(/^\//, ""))}>{g.countryName}</a>
                  ) : (
                    g.countryName
                  )}
                </th>
              </tr>
              {g.rows.map((r) => (
                <tr data-testid="map-places-row" data-slug={r.slug} data-level={r.level ?? ""}>
                  <th scope="row">
                    <a href={withBase(dossierPath(r.slug).replace(/^\//, ""))}>{r.name}</a>
                  </th>
                  <td data-testid="places-located">{r.located}</td>
                  <td data-testid="places-sources">{r.sources ?? "not recorded"}</td>
                  <td data-testid="places-single-source">
                    {r.singleSourceShare !== null
                      ? `${Math.round(r.singleSourceShare * 100)}%`
                      : "not recorded"}
                  </td>
                  <td data-testid="places-no-point">{r.noPoint}</td>
                  <td>
                    {r.hasSitesList ? (
                      <a href={withBase(dossierSitesPath(r.slug))} data-testid="sites-list-link">Site list</a>
                    ) : (
                      "—"
                    )}
                  </td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
      </div>
      {places.truncated > 0 && (
        <p class="sig-table-note" data-testid="places-truncation-note">
          Showing {places.totalRows - places.truncated} of {places.totalRows} jurisdictions — the{" "}
          <a href={withBase("dossier/")}>dossier index</a> lists every place.
        </p>
      )}
      {places.unresolvedRecords > 0 && (
        <p class="sig-table-note" data-testid="places-unresolved">
          {places.unresolvedRecords} record{places.unresolvedRecords === 1 ? "" : "s"} placed to no
          published dossier in this build — they remain in the export bundle and the API, never
          guessed into a jurisdiction.
        </p>
      )}
    </>
  )}

  <!-- National-zoom density bins with the low-coverage≠low-density encoding. -->
  <h2 id="coverage-heading">National view: density binning with coverage (SIG-UI-018/019)</h2>
  <p>
    At national zoom (≤ {NATIONAL_ZOOM_MAX}) the map bins density rather than drawing
    individual points. <strong>Low coverage is desaturated and hatched</strong> so
    "we don't know" never reads as "there is little here."
  </p>
  <figure aria-labelledby="bins-caption">
    <svg
      role="img"
      aria-label="Density bins; low-coverage cells are hatched and desaturated, distinct from confidently-low-density cells."
      viewBox={`0 0 ${cell * bins.length} ${cell + 40}`}
      width={cell * bins.length}
      height={cell + 40}
      class="sig-figure-frame"
    >
      {bins.map(({ bin, render }, i) => (
        <g>
          <rect
            x={i * cell + 6}
            y={6}
            width={cell - 12}
            height={cell - 12}
            fill={render.coverage.desaturated
              ? "hsl(220deg 8% 82%)"
              : `hsl(214deg 70% ${72 - render.densityBucket * 14}%)`}
            stroke={render.coverage.hatched ? "var(--sig-epi-absence-ink)" : "var(--sig-rule)"}
            stroke-dasharray={render.coverage.hatched ? "3 2" : undefined}
          >
            <title>{binAriaLabel(bin)}</title>
          </rect>
          <text x={i * cell + cell / 2} y={cell + 12} text-anchor="middle" font-size="9">
            {bin.coverage}
          </text>
          <text x={i * cell + cell / 2} y={cell + 26} text-anchor="middle" font-size="9">
            {binCountLabel(bin)}
          </text>
        </g>
      ))}
    </svg>
    <figcaption id="bins-caption">
      Each cell is an H3 bin (§19.5). A grey hatched cell means SIG has barely looked;
      its count is suppressed, not shown as a low density.
    </figcaption>
  </figure>

  <h2 id="bins-table-heading">Coverage bins (tabular equivalent)</h2>
  {bins.length === 0 && <EmptyState surface="mapBins" />}
  {cappedBins.truncated && (
    <p class="sig-table-note" data-testid="bins-bounds-note">
      Showing the first {cappedBins.shown} of {cappedBins.total} density cells — the
      full cell set ships in the export's <code>web/analytics/density_bins.json</code>.
    </p>
  )}
  <div class="sig-table-wrap">
  <table class="sig-table" aria-labelledby="bins-table-heading">
    <thead>
      <tr>
        <th scope="col">H3 cell</th>
        <th scope="col">Jurisdiction</th>
        <th scope="col" data-copy="MP-05">Records</th>
        <th scope="col">Coverage</th>
        <th scope="col">Reads as</th>
      </tr>
    </thead>
    <tbody>
      {bins.map(({ bin }) => {
        const keys = binJurisdictionKeys(bin);
        const mixed = keys.length > 1;
        return (
        <tr
          data-testid="coverage-bin"
          data-coverage={bin.coverage}
          data-desaturated={coverageEncoding(bin.coverage).desaturated ? "true" : "false"}
          data-hatched={coverageEncoding(bin.coverage).hatched ? "true" : "false"}
          data-reads-as-density={readsAsDensity(bin) ? "true" : "false"}
          data-jurisdiction-keys={keys.length}
        >
          <th scope="row"><code>{bin.h3}</code></th>
          <td data-testid="bin-jurisdiction">
            {bin.jurisdiction}
            {mixed && (
              <span class="sig-table-note" data-testid="bin-jurisdiction-mixed">
                {" "}— plurality of {keys.length} jurisdiction keys (
                {keys.map((k) => `${k}: ${bin.jurisdictionCounts?.[k] ?? 0}`).join(", ")})
              </span>
            )}
          </td>
          <td>{binCountLabel(bin)}</td>
          <td>{coverageEncoding(bin.coverage).label}</td>
          <td>{readsAsDensity(bin) ? "a density signal" : "we don't know (coverage too low)"}</td>
        </tr>
        );
      })}
    </tbody>
  </table>
  </div>

  <!-- No-coordinate records: jurisdiction indicators, never dropped (SIG-UI-020). -->
  <h2 id="nocoord-heading" data-copy="MP-10">Records without a published point</h2>
  <p data-copy="MP-14 MP-15">
    Records with no coordinates — or whose sensitivity tier forbids publishing a
    point — are <strong>not dropped</strong>. They appear as jurisdiction-level
    indicators, so the map does not systematically understate capability
    (SIG-UI-020).
  </p>
  {jurisdictionIndicators.length === 0 && <EmptyState surface="mapIndicators" />}
  <ul class="sig-jurisdiction-indicators">
    {boundIndicators.map((j) => {
      const contested = CONTESTED_BY_JURISDICTION.get(j.jurisdiction) ?? 0;
      const dossierSlug = dossierSlugFor(j.jurisdiction);
      return (
      <li data-testid="jurisdiction-indicator" data-count={j.count}>
        <strong>{j.jurisdiction}</strong>: <span data-copy="MP-11">{j.count} record(s) with no published point.</span>
        {contested > 0 && dossierSlug !== null && (
          <span class="sig-jurisdiction-contested" data-testid="jurisdiction-contested" data-count={contested} data-copy="MP-12"> — {contested} contested; see the <a href={withBase(dossierPath(dossierSlug).replace(/^\//, ""))} data-testid="contested-dossier-link">{j.jurisdiction} dossier</a>.</span>
        )}
        {contested > 0 && dossierSlug === null && (
          <span class="sig-jurisdiction-contested" data-testid="jurisdiction-contested" data-count={contested} data-copy="MP-13"> — {contested} contested.</span>
        )}
        <ul>
          {j.listedIds.map((id) => {
            const asset = ASSET_BY_ID.get(id)!;
            const href = siteRecordHref(id);
            return (
              <li>
                {href ? <a href={href}>{asset.label}</a> : asset.label} — {asset.precision}
                {asset.locationAbsence && (
                  <> <AbsenceChip
                    kind={asset.locationAbsence}
                    subject_id={asset.id}
                    predicate_id="location"
                    predicate_label="Location"
                    chipId={`map-${asset.id}`}
                  /></>
                )}
              </li>
            );
          })}
        </ul>
        {j.truncated && (
          <p class="sig-table-note" data-testid="indicator-bounds-note">
            … and {j.count - j.listedIds.length} more in {j.jurisdiction} — every record
            remains navigable through its dossier's sites list and the export bundle.
          </p>
        )}
      </li>
      );
    })}
  </ul>

  <h2 id="sharing-heading">Sharing edges</h2>
  <p>
    Sharing edges default to an <strong>{DEFAULT_SHARING_EDGE_VIEW} network</strong> from a
    selected entity — never a national hairball (SIG-UI-021). Explore them in the{" "}
    <a href="/network/">network explorer</a>, which also offers matrix and arc views.
  </p>

  <!-- OSM attribution in every rendering context, incl. print (SIG-GEO-013). -->
  <p class="sig-map-attribution" data-testid="map-attribution">
    {ATTRIBUTION_LINE}. Tiles served as static PMTiles v3 —{" "}
    <a href="/map/style.json">map style</a> (SIG-GEO-012, SIG-UI-038).
  </p>
</BaseLayout>
