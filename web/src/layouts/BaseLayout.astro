// The web shell's base layout (SIG-UI-036/037; the national IA, SIG-UI-049 /
// ADR-093). It ships NO client JavaScript: there is no `client:*` directive
// anywhere in the shell, so the built HTML is archivable by default. Every page
// rendered through this layout carries the citation affordance (SIG-UI-035), a skip
// link, a document language, the six-section route-aware navigation
// (P36.18 / SIG-UI-051/150 — a section or menu item the release does not serve
// is never offered), the page-header band with its release stamp and Cite
// disclosure, the footer strip inside the forty-word chrome budget
// (SIG-UI-145), and the shared design system.
//
// The belief-pinned citation defaults (the as-of pair + ruleset) come from the
// export MANIFEST via the data layer (getSiteMetadata), not the frozen fixtures
// constant, so a citation captured off the public surface names the belief the
// surface was actually built at (SIG-UI-035, SIG-UI-049 / ADR-093 §5).
import Citation from "../components/Citation.astro";
import HowWeKnowThis from "../components/HowWeKnowThis.astro";
import DisputeLink from "../components/DisputeLink.astro";
import SiteHeader from "../components/chrome/SiteHeader.astro";
import PageHeaderBand from "../components/chrome/PageHeaderBand.astro";
import "../styles/epistemic.css";
import type { AsOfEcho } from "../lib/fixtures";
import type { ProvenanceSummary } from "../lib/provenance";
import { DEFAULT_PROVENANCE, REVIEW_STATUS_LABELS } from "../lib/provenance";
import { getSiteMetadata, getSiteProvenance, getSourceCounts } from "../lib/data";
import { getReleaseStamp } from "../lib/release-stamp";
import { CHROME, renderChrome } from "../lib/lexicon";
import { groupDigits } from "../lib/format";
import { navForRoutes } from "../lib/nav";
import type { Crumb, PageAction } from "../lib/nav";
import { releaseRoutes } from "../lib/release-routes";
import { withBase, BASE } from "../lib/paths";
import { classifyRoute } from "../lib/page-types";
import { TYPEAHEAD_SHARD_ROOT } from "../lib/typeahead-shards";
import { T2_ROBOTS_CONTENT } from "../lib/workspace-state/index";
import { defaultDescription } from "../lib/meta";
import { socialCardForRoute } from "../lib/brand";

interface Props {
  title: string;
  /** The canonical path for the belief-pinned permalink (SIG-UI-035). */
  path: string;
  /**
   * The page's meta description (P34.13 / QW-11). Defaults to the shared
   * template — the page TITLE plus the record's name — so every built page
   * carries a unique description while titles stay unique. The template
   * itself is copy-batch row MD-01 (B-2).
   */
  description?: string;
  asOf?: AsOfEcho;
  rulesetVersion?: string;
  /** The page's "How we know this" provenance (SIG-UI-044); defaults site-wide. */
  provenance?: ProvenanceSummary;
  /**
   * The name the page-scoped "How we know this" scope line carries (P34.12 /
   * C3 NEW-13): a page supplying its own summary SHOULD also name itself — e.g.
   * `provenanceName="research queue"` renders "…the research queue's own
   * evidence…" so the label says WHICH page's totals these are.
   */
  provenanceName?: string;
  /**
   * P35.37 (SIG-TRANSP-013): the JSON-pointer base inside
   * `web/analytics/provenance.json` the "How we know this" module's figures
   * resolve under — default `/surfaces/site`; a page-scoped module passes its
   * own `surfaces/<name>` key (e.g. `/surfaces/dossiers/<slug>`).
   */
  provenancePointerBase?: string;
  /**
   * `minimal` renders only the page slot — no "How we know this", dispute or
   * citation module (P34.13 / QW-11): the branded error pages and the /terms
   * forwarder are chrome-light by design.
   */
  chrome?: "full" | "minimal";
  /**
   * P35.42 (SIG-TRANSP-023, J3 §8.2): the path this page's immutable copy
   * resolves at when the page BACKS a released record — e.g. a dossier page
   * names its `/r/<pub>/c/<comp>/jurisdiction/<slug>/` record path so the
   * citation block cites the immutable release URL. Default: the page's own
   * path joined under the configured base (`withBase(path)` — `/s/<pub>/…`
   * inside a snapshot build, where the page itself is the immutable copy).
   */
  recordPath?: string;
  /**
   * `true` marks the page noindex AND excludes it from the sitemap (P34.13 /
   * QW-11): error pages and the /terms forwarder are never canonical content.
   */
  noindex?: boolean;
  /** The BCP-47 document language (SIG-UI localisation); defaults to English. */
  lang?: string;
  /**
   * P36.18 (UXK14-2, SIG-UI-150): the page-header band's breadcrumb trail —
   * record pages pass their canonical chain (jurisdiction dossiers: country >
   * state > county > place; entity pages: Organizations > type > entity). The
   * last row is the current page, rendered unlinked.
   */
  crumbs?: Crumb[];
  /** The breadcrumb trail's testid (e.g. "dossier-breadcrumb"). */
  crumbsTestId?: string;
  /** The band's one-sentence lede (K14 §4.5); absent → no lede paragraph. */
  lede?: string;
  /** The band's action links (Print, the JSON form, …). */
  actions?: PageAction[];
}

const { title, path } = Astro.props;
// P36.25 (SIG-UI-154): the page-type classification drives both the default
// description's per-type template and the social card this page shares —
// computed once, reused by the kit/robots legs below.
const pageClassification = classifyRoute(path);
const pageType = pageClassification.ok ? pageClassification.entry.type : "T1";
const description = Astro.props.description ?? defaultDescription(title, pageType);
const chrome = Astro.props.chrome ?? "full";
const noindex = Astro.props.noindex ?? false;
const siteMeta = getSiteMetadata();
const asOf = Astro.props.asOf ?? siteMeta.asOf;
const rulesetVersion = Astro.props.rulesetVersion ?? siteMeta.rulesetVersion;
// P30.3 + P35.20a (ED-41): the "How we know this" contract — a page either supplies its
// OWN emitted provenance row (a per-dossier/per-surface summary, scope "page") or it
// renders the SITE-WIDE summary explicitly labelled site-wide (scope "site"). The
// silent version of this fallback is dead: site totals can never carry a surface's
// name, because the label always names the scope the numbers were actually counted
// over. A real-data build's site-wide default derives from the export itself — never
// the committed OKC demo summary (`DEFAULT_PROVENANCE` stays the fixtures-mode default).
const provenance = Astro.props.provenance ?? getSiteProvenance();
// P34.11 (QW-6, F-05/F-132): when a page supplies its own provenance summary it is
// page-specific; the site-wide default is the fallback. The module is labelled with
// its actual scope so site-wide totals are never read as dossier/page figures.
const provenanceScope = Astro.props.provenance !== undefined ? "page" : "site";
const lang = Astro.props.lang ?? "en";
// P34.17 (A-20 + H-6): the interim release stamp's rendered values are DATA —
// batch rows pin the sentence templates with the placeholders verbatim (the
// `{permalink}` precedent).
const releaseId = siteMeta.releaseId;
const asOfWorld = asOf.as_of_world;
// P35.13 (SIG-REL-009, G3 §6.1): the release stamp's data comes from the
// release's sig.site-release/1 — never a recomputed value. `null` (dev or a
// pre-release export) keeps the P34.17 interim sentence honestly.
const stamp = getReleaseStamp();
// P35.42 (SIG-TRANSP-023, J3 §8.2, F-399 — the seam this closes): EVERY page
// passes the build's release context to the citation block — the publication
// id, the data release id, and the path the page's immutable copy resolves
// at. `null` only when the build binds no release (fixtures/dev), never a
// page-local constant: the block renders the honest interim sentence until
// `/s/<pub>/` snapshots exist (TX-13b / P36.66a+b).
const citeRelease = stamp
  ? {
      publicationId: stamp.publicationId,
      label: stamp.label,
      recordPath: Astro.props.recordPath ?? withBase(path),
    }
  : null;

// The canonical origin the belief-pinned permalink resolves against (P27.6; DNS
// cut-over is P27.10). `Astro.site` is set in astro.config.mjs; the literal fallback
// matches it so a stray host never resurrects the retired placeholder domain.
const CANONICAL_ORIGIN = "https://surveillancegraph.org";

// P34.13 (WM-01): the wordmark's accessible name — the pinned copy row binds
// this exact literal in THIS file; the header component renders it via prop.
const WORDMARK_HOME_LABEL = "SIG Surveillance Infrastructure Graph — home";
// P36.18 (UXK14-2, SIG-UI-051/UXR-01): the header renders the sections this
// release actually serves — the manifest comes from the emitted page files
// plus the declared data probes, so a menu item can never 404 (SIG-ENG-042).
// `Astro.url.pathname` carries the configured base — strip it before the
// section-prefix match so a snapshot build still marks the right section.
const routes = releaseRoutes();
const navPath = (Astro.url.pathname.startsWith(BASE)
  ? Astro.url.pathname.slice(BASE.length)
  : Astro.url.pathname.replace(/^\/+/, "")
).replace(/\/+$/, "");
const navPathKey = navPath === "" ? "" : `${navPath}/`;
const navSections = navForRoutes(routes, navPathKey);
// The strip's own site-wide claims — the same named counts the "How we know
// this" module renders (the published-lifecycle partition over
// transparency/counts.json, the site summary's review posture). Templates
// come from the lexicon (SIG-UI-145): a count or date is never hard-coded.
const siteSourceCount = getSourceCounts().lifecycle.published.count;
const siteReviewStatus =
  REVIEW_STATUS_LABELS[(getSiteProvenance() ?? DEFAULT_PROVENANCE).human_review_status];
const stripText = renderChrome(CHROME.strip, {
  sources: groupDigits(String(siteSourceCount)),
  asOf: asOfWorld,
  reviewStatus: siteReviewStatus.toLowerCase(),
});
// The band's stamp line: the release's own label when the build binds a
// release (the honest interim id when only the manifest names one), else the
// development-build form — never a fabricated release identity.
const stampLine = stamp
  ? renderChrome(CHROME.stampRelease, { asOf: stamp.asOfWorld, label: stamp.label })
  : releaseId
    ? renderChrome(CHROME.stampRelease, { asOf: asOfWorld, label: releaseId })
    : renderChrome(CHROME.stampDevelopment, { asOf: asOfWorld });
// The footer's route-aware links — the same release manifest filters them
// (K13 §2.4: licence line, dispute, About, Releases, Status, resources — a
// target the release does not serve is omitted, never a dead link).
const footerLinks = [
  { label: CHROME.licences, route: "sources/" },
  { label: "About", route: "about/" },
  { label: "Contact", route: "contact/" },
  { label: "Releases", route: "releases/" },
  { label: CHROME.status, route: "status/" },
  { label: "Other public resources", route: "about/resources/" },
].filter((link) => routes.has(link.route));
// P36.20 (UXK0-4, ADR-224): the T1 enhancement kit's chrome modules. Only a
// full-chrome page classified T1 loads them — the registry is the single
// authority, so a page re-typed T0/T2 stops emitting the tags with no
// template edit, and a T0 route can never carry a `<script>`. The three
// modules upgrade the shared cite disclosure (`<sig-details>` opens it for
// fragment links + print, `<sig-cite>` restates formats, `<sig-copy>` copies
// the permalink); page-local elements (`<sig-table>`, `<sig-typeahead>`)
// name their own module beside the markup they upgrade. Every entry is
// allow-listed in tests/e2e/t1-module-entries.json (ADR-155/P35.50) and
// admitted under the strict CSP's `script-src 'self'` (P36.19/ADR-223).
const KIT_CHROME_MODULES = ["sig-details", "sig-cite", "sig-copy"] as const;
const loadKitChrome =
  chrome === "full" && pageClassification.ok && pageClassification.entry.type === "T1";
// P36.40 (SIG-SRCH-010, UXR-23): the header typeahead — the shared
// `sig.typeahead-shard/1` root names the ONE shard set every consumer reads.
// T1 pages load the allow-listed `/_kit/sig-typeahead.js` module beside the
// element; T2 pages may not name a `/_kit/` src (only content-hashed
// `/_astro/` assets pass the T2 script policy), so the markup mounts there
// without a script tag — on `/search/` the island's own bundle registers the
// element, and on the other T2 routes the form stays its complete GET self.
// T0 never carries the element at all (no `<script>` posture).
const headerTypeahead =
  chrome === "full" &&
  pageClassification.ok &&
  (pageClassification.entry.type === "T1" || pageClassification.entry.type === "T2");
// P36.21 (K13 §2.5, SIG-UI-059/060, ADR-225): the T2 indexing posture. Every
// parameterised T2 URL carries `noindex,follow` and the canonical on the base
// surface — a static build emits one head per route, so the directive is
// unconditional on the T2 document. The sitemap (registry-derived, T0/T1
// routes only) is the indexable set; the explore surfaces were never the
// canonical content for the index anyway.
const isT2 =
  pageClassification.ok && pageClassification.entry.type === "T2";
// P36.25 (SIG-UI-154, K14 §4.12): the social card this page shares — one
// static card per page type, generated at build time (SVG → PNG by the
// sigBrandAssets hook; T3/internal tooling shares none). og:image needs an
// absolute URL, resolved against the canonical origin through withBase so a
// snapshot build names its own copy.
const socialCard = socialCardForRoute(path);
const canonicalUrl = new URL(path, Astro.site ?? CANONICAL_ORIGIN).href;
const socialCardUrl = socialCard
  ? new URL(withBase(socialCard.file), Astro.site ?? CANONICAL_ORIGIN).href
  : null;
---

<!doctype html>
<html lang={lang} data-sig-chrome={chrome}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* P36.16 (SIG-UI-146/147, K14 §4.10): both colour schemes are first-class —
        the tokens carry a chosen dark set, so the browser may colour UA chrome
        (form controls, the page canvas) for whichever scheme is active. */}
    <meta name="color-scheme" content="light dark" />
    <title>{title} · SIG</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* P36.21 (K13 §2.5): the stateful T2 surface is `noindex,follow` — the
        parameter-space of one route is never the indexable copy; the
        canonical link names the base surface. */}
    {isT2 && <meta name="robots" content={T2_ROBOTS_CONTENT} />}
    <!-- P34.13 (QW-11): the SIG favicon — served from /favicon.svg (a file
         the allow-list names); P36.25 replaced the interim letter mark with
         the node-link glyph. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* P36.25 (SIG-UI-154, K14 §4.12): the favicon set — the 32 px PNG is the
        `alternate icon` fallback for browsers without SVG favicons (so it is
        never fetched where the SVG suffices), and the 180 px touch icon for
        mobile surfaces. Both are rasterised from public/favicon.svg at build
        time. */}
    <link rel="alternate icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("apple-touch-icon.png")} />
    <link rel="canonical" href={canonicalUrl} />
    {/* P36.25 (SIG-UI-154): the Open Graph + summary-card meta — one static
        card per page type (`sig.social-card/1`), emitted under /social/ at
        build time. T3 routes resolve no card and emit none of these tags. */}
    {socialCard && (
      <Fragment>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Surveillance Infrastructure Graph" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={socialCardUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialCard.alt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialCardUrl} />
      </Fragment>
    )}
    {/* P35.13 (SIG-REL-009, G3 §6.1): the machine + link pair — every page
        names its release (`<meta name="sig-release">` = `<label> <pub>`) and
        links the release's own release.json (`describedby`). Both absent in
        the no-release state, never a placeholder. */}
    {stamp && <meta name="sig-release" content={stamp.metaContent} />}
    {stamp && <link rel="describedby" type="application/json" href={stamp.describedby} />}
    {/* P35.39 (SIG-TRANSP-017, J3 §6.6, D-J3-7): the linked machine metadata —
        the release's publication-bound Frictionless descriptor (`describedby`)
        and the DCAT 3 series catalog (`alternate`). Both are LINKED files;
        JSON-LD is never inlined on a public page. */}
    {stamp && <link rel="describedby" type="application/json" href={withBase(`releases/${stamp.publicationId}/datapackage.json`)} />}
    {stamp && <link rel="alternate" type="application/ld+json" href={withBase("releases/catalog.jsonld")} />}
    {loadKitChrome &&
      KIT_CHROME_MODULES.map((name) => (
        <script is:inline type="module" src={withBase(`_kit/${name}.js`)}></script>
      ))}
    {/* The named head slot — a page-scoped resource (e.g. a route-scoped
        stylesheet linked via `?url`, the print.css precedent) lands inside
        <head> on ITS page only, never hoisted into the shared chunk. */}
    <slot name="head" />
  </head>
  <body>
    <a class="sig-skip-link" href="#main">Skip to main content</a>
    <SiteHeader
      sections={navSections}
      wordmarkLabel={WORDMARK_HOME_LABEL}
      typeaheadShardRoot={headerTypeahead ? TYPEAHEAD_SHARD_ROOT : undefined}
      typeaheadModule={loadKitChrome}
    />
    <main id="main">
      {chrome === "full" ? (
        <PageHeaderBand
          title={title}
          lede={Astro.props.lede}
          crumbs={Astro.props.crumbs}
          crumbsTestId={Astro.props.crumbsTestId}
          stamp={stampLine}
          actions={Astro.props.actions}
        >
          <Citation path={path} title={title} asOf={asOf} rulesetVersion={rulesetVersion} release={citeRelease} />
        </PageHeaderBand>
      ) : (
        <h1>{title}</h1>
      )}
      <slot />
    </main>
    <footer class="sig-footer">
      {chrome === "full" && (
        <div class="sig-footer__inner">
          {/* K14 §3.7's strip — the shared provenance line every page carries,
              with the disclosure one action away (SIG-UI-044/145). */}
          <p class="sig-footer__strip" data-testid="footer-strip">{stripText} · <DisputeLink compact /></p>
          {/* SIG-UI-145: the full module stays one action away on every page;
              on a record page its scope is page-specific (the page passes its
              own provenance row — scope "page" above). */}
          <details class="sig-footer__details" data-testid="chrome-details">
            <summary class="sig-footer__details-summary">{CHROME.howWeKnowThis}</summary>
            <HowWeKnowThis provenance={provenance} scope={provenanceScope} pageName={Astro.props.provenanceName} pointerBase={Astro.props.provenancePointerBase ?? "/surfaces/site"} />
            {/* P34.17: the interim release stamp (A-20 honesty — the site is a dated
                snapshot; the API may be newer) + the publication-basis label (H-6 /
                ADR-167 — the recorded no-legal-review posture). Both ship as pending
                copy-batch rows; the sentences live inside the same disclosure so the
                visible strip stays inside the word budget. */}
            {stamp ? (
              <Fragment>
                {/* P35.13 / the full provenance stamp — label, data as-of,
                    build instant, the linked code commit, the publication id
                    and the release.json link; then the latest-view basis
                    sentence pointing at the immutable namespace. */}
                <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-04">
                  Release {stamp.label} · data as of {stamp.asOfWorld} · built{" "}
                  {stamp.builtAt} from code{" "}
                  <a href={stamp.commitHref}><code>{stamp.commit8}</code></a> ·{" "}
                  <code>{stamp.publicationShort}</code> ·{" "}
                  <a href={stamp.describedby}>release.json</a>
                </p>
                <p class="sig-footer__stamp-basis" data-testid="release-stamp-basis" data-copy="RS-05">
                  This is the latest view. Cite the fixed copy:{" "}
                  <a href={`/r/${stamp.publicationId}/`}><code>/r/{stamp.publicationId}/</code></a>.
                  The public API also serves newer, unreleased records, labelled "live".
                </p>
              </Fragment>
            ) : releaseId ? (
              <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-01 RS-02">
                This site shows release {releaseId}, data as of {asOfWorld}.
                The public API is updated continuously and may show newer records.
              </p>
            ) : (
              <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-03 RS-02">
                This is a development build.
                The public API is updated continuously and may show newer records.
              </p>
            )}
            <p class="sig-footer__basis" data-testid="publication-basis" data-copy="PB-01 PB-02">
              Published on the maintainer's own rights and publication decisions. No
              lawyer's written opinion has been obtained; nothing here states that
              this publication has been cleared by counsel.
            </p>
          </details>
          <nav class="sig-footer__links" aria-label="Footer">
            {footerLinks.map((link, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={withBase(link.route)}>{link.label}</a>
              </>
            ))}
          </nav>
          <p class="sig-footer__tagline" data-testid="footer-tagline">{CHROME.tagline}</p>
        </div>
      )}
    </footer>
  </body>
</html>
