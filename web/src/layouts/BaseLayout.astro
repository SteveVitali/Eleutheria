// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// The web shell's base layout (SIG-UI-036/037; the national IA, SIG-UI-049 /
// ADR-093). It ships NO client JavaScript: there is no `client:*` directive
// anywhere in the shell, so the built HTML is archivable by default. Every page
// rendered through this layout carries the citation affordance (SIG-UI-035), a skip
// link, a document language, the grouped keyboard-accessible navigation, and the
// shared design system.
//
// The belief-pinned citation defaults (the as-of pair + ruleset) come from the
// export MANIFEST via the data layer (getSiteMetadata), not the frozen fixtures
// constant, so a citation captured off the public surface names the belief the
// surface was actually built at (SIG-UI-035, SIG-UI-049 / ADR-093 §5).
import Citation from "../components/Citation.astro";
import HowWeKnowThis from "../components/HowWeKnowThis.astro";
import DisputeLink from "../components/DisputeLink.astro";
import "../styles/epistemic.css";
import type { AsOfEcho } from "../lib/fixtures";
import type { ProvenanceSummary } from "../lib/provenance";
import { getSiteMetadata, getSiteProvenance } from "../lib/data";
import { getReleaseStamp } from "../lib/release-stamp";
import { withBase } from "../lib/paths";
import { defaultDescription } from "../lib/meta";

interface Props {
  title: string;
  /** The canonical path for the belief-pinned permalink (SIG-UI-035). */
  path: string;
  /**
   * The page's meta description (P34.13 / QW-11). Defaults to the shared
   * template — the page TITLE plus the record's name — so every built page
   * carries a unique description while titles stay unique. The template
   * itself is copy-batch row MD-01 (B-2).
   */
  description?: string;
  asOf?: AsOfEcho;
  rulesetVersion?: string;
  /** The page's "How we know this" provenance (SIG-UI-044); defaults site-wide. */
  provenance?: ProvenanceSummary;
  /**
   * The name the page-scoped "How we know this" scope line carries (P34.12 /
   * C3 NEW-13): a page supplying its own summary SHOULD also name itself — e.g.
   * `provenanceName="research queue"` renders "…the research queue's own
   * evidence…" so the label says WHICH page's totals these are.
   */
  provenanceName?: string;
  /**
   * P35.37 (SIG-TRANSP-013): the JSON-pointer base inside
   * `web/analytics/provenance.json` the "How we know this" module's figures
   * resolve under — default `/surfaces/site`; a page-scoped module passes its
   * own `surfaces/<name>` key (e.g. `/surfaces/dossiers/<slug>`).
   */
  provenancePointerBase?: string;
  /**
   * `minimal` renders only the page slot — no "How we know this", dispute or
   * citation module (P34.13 / QW-11): the branded error pages and the /terms
   * forwarder are chrome-light by design.
   */
  chrome?: "full" | "minimal";
  /**
   * `true` marks the page noindex AND excludes it from the sitemap (P34.13 /
   * QW-11): error pages and the /terms forwarder are never canonical content.
   */
  noindex?: boolean;
  /** The BCP-47 document language (SIG-UI localisation); defaults to English. */
  lang?: string;
}

const { title, path } = Astro.props;
const description = Astro.props.description ?? defaultDescription(title);
const chrome = Astro.props.chrome ?? "full";
const noindex = Astro.props.noindex ?? false;
const siteMeta = getSiteMetadata();
const asOf = Astro.props.asOf ?? siteMeta.asOf;
const rulesetVersion = Astro.props.rulesetVersion ?? siteMeta.rulesetVersion;
// P30.3 + P35.20a (ED-41): the "How we know this" contract — a page either supplies its
// OWN emitted provenance row (a per-dossier/per-surface summary, scope "page") or it
// renders the SITE-WIDE summary explicitly labelled site-wide (scope "site"). The
// silent version of this fallback is dead: site totals can never carry a surface's
// name, because the label always names the scope the numbers were actually counted
// over. A real-data build's site-wide default derives from the export itself — never
// the committed OKC demo summary (`DEFAULT_PROVENANCE` stays the fixtures-mode default).
const provenance = Astro.props.provenance ?? getSiteProvenance();
// P34.11 (QW-6, F-05/F-132): when a page supplies its own provenance summary it is
// page-specific; the site-wide default is the fallback. The module is labelled with
// its actual scope so site-wide totals are never read as dossier/page figures.
const provenanceScope = Astro.props.provenance !== undefined ? "page" : "site";
const lang = Astro.props.lang ?? "en";
// P34.17 (A-20 + H-6): the interim release stamp's rendered values are DATA —
// batch rows pin the sentence templates with the placeholders verbatim (the
// `{permalink}` precedent).
const releaseId = siteMeta.releaseId;
const asOfWorld = asOf.as_of_world;
// P35.13 (SIG-REL-009, G3 §6.1): the release stamp's data comes from the
// release's sig.site-release/1 — never a recomputed value. `null` (dev or a
// pre-release export) keeps the P34.17 interim sentence honestly.
const stamp = getReleaseStamp();

// The canonical origin the belief-pinned permalink resolves against (P27.6; DNS
// cut-over is P27.10). `Astro.site` is set in astro.config.mjs; the literal fallback
// matches it so a stray host never resurrects the retired placeholder domain.
const CANONICAL_ORIGIN = "https://surveillancegraph.org";

// The grouped, uncluttered navigation (SIG-UI-049 / ADR-093): product · about the
// record · reference. Replaces the flat 13-link bar; the Dossiers entry points at
// the per-jurisdiction index, never a single hardcoded jurisdiction.
const NAV_GROUPS: { label: string; links: { href: string; label: string }[] }[] = [
  {
    label: "Explore",
    links: [
      { href: "/map/", label: "Map" },
      { href: "/network/", label: "Network" },
      { href: "/search/", label: "Search" },
      { href: "/dossier/", label: "Dossiers" },
      { href: "/watch/", label: "Watch" },
      { href: "/evidence/", label: "Evidence" },
    ],
  },
  {
    label: "About the record",
    links: [
      { href: "/methodology/", label: "Methodology" },
      { href: "/coverage-metrics/", label: "Coverage" },
      { href: "/data-freshness/", label: "Data freshness" },
      { href: "/research-queue/", label: "Research queue" },
      { href: "/corrections/", label: "Corrections" },
      // P34.17: the interim sources/licences page and the status page.
      { href: "/sources/", label: "Sources" },
      { href: "/status/", label: "Status" },
    ],
  },
  {
    label: "Reference",
    links: [
      { href: "/editorial-standards/", label: "Editorial standards" },
      { href: "/style-guide/", label: "Style guide" },
    ],
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · SIG</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- P34.13 (QW-11): the SIG favicon — the wordmark's three-letter mark on
         the ink square, served from /favicon.svg (a file the allow-list names). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site ?? CANONICAL_ORIGIN).href} />
    {/* P35.13 (SIG-REL-009, G3 §6.1): the machine + link pair — every page
        names its release (`<meta name="sig-release">` = `<label> <pub>`) and
        links the release's own release.json (`describedby`). Both absent in
        the no-release state, never a placeholder. */}
    {stamp && <meta name="sig-release" content={stamp.metaContent} />}
    {stamp && <link rel="describedby" type="application/json" href={stamp.describedby} />}
    {/* P35.39 (SIG-TRANSP-017, J3 §6.6, D-J3-7): the linked machine metadata —
        the release's publication-bound Frictionless descriptor (`describedby`)
        and the DCAT 3 series catalog (`alternate`). Both are LINKED files;
        JSON-LD is never inlined on a public page. */}
    {stamp && <link rel="describedby" type="application/json" href={withBase(`releases/${stamp.publicationId}/datapackage.json`)} />}
    {stamp && <link rel="alternate" type="application/ld+json" href={withBase("releases/catalog.jsonld")} />}
  </head>
  <body>
    <a class="sig-skip-link" href="#main">Skip to main content</a>
    <header class="sig-header">
      <div class="sig-header__bar">
        <a class="sig-wordmark" href="/" aria-label="SIG Surveillance Infrastructure Graph — home">
          <span class="sig-wordmark__mark" aria-hidden="true">SIG</span>{" "}
          <span class="sig-wordmark__full">Surveillance Infrastructure Graph</span>
        </a>
        <nav class="sig-nav" aria-label="Primary">
          {NAV_GROUPS.map((group) => (
            <div class="sig-nav__group" role="group" aria-label={group.label}>
              <span class="sig-nav__group-label" aria-hidden="true">{group.label}</span>
              <ul class="sig-nav__list">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <h1>{title}</h1>
      <slot />
      {chrome === "full" && (
        <>
          <HowWeKnowThis provenance={provenance} scope={provenanceScope} pageName={Astro.props.provenanceName} pointerBase={Astro.props.provenancePointerBase ?? "/surfaces/site"} />
          <DisputeLink />
          <Citation path={path} title={title} asOf={asOf} rulesetVersion={rulesetVersion} />
        </>
      )}
    </main>
    <footer class="sig-footer">
      <!-- P34.17: the interim release stamp (A-20 honesty — the site is a dated
           snapshot; the API may be newer) + the publication-basis label (H-6 /
           ADR-167 — the recorded no-legal-review posture). Both ship as pending
           copy-batch rows; the sentences render on every chrome=full page. The
           stamp is omitted on chrome=minimal error/forwarder pages. -->
      {chrome === "full" && (stamp ? (
        <Fragment>
          {/* P35.13 / SIG-REL-009 (G3 §6.1): the full provenance stamp —
              label, data as-of, build instant, the linked code commit, the
              publication id and the release.json link; then the latest-view
              basis sentence pointing at the immutable namespace. The
              /s/<pub>/ fixed-copy surface is the publish row's leg — the
              immutable /r/<pub>/ namespace is the citable target today. */}
          <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-04">
            Release {stamp.label} · data as of {stamp.asOfWorld} · built{" "}
            {stamp.builtAt} from code{" "}
            <a href={stamp.commitHref}><code>{stamp.commit8}</code></a> ·{" "}
            <code>{stamp.publicationShort}</code> ·{" "}
            <a href={stamp.describedby}>release.json</a>
          </p>
          <p class="sig-footer__stamp-basis" data-testid="release-stamp-basis" data-copy="RS-05">
            This is the latest view. Cite the fixed copy:{" "}
            <a href={`/r/${stamp.publicationId}/`}><code>/r/{stamp.publicationId}/</code></a>.
            The public API also serves newer, unreleased records, labelled "live".
          </p>
        </Fragment>
      ) : releaseId ? (
        <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-01 RS-02">
          This site shows release {releaseId}, data as of {asOfWorld}.
          The public API is updated continuously and may show newer records.
        </p>
      ) : (
        <p class="sig-footer__stamp" data-testid="release-stamp" data-copy="RS-03 RS-02">
          This is a development build.
          The public API is updated continuously and may show newer records.
        </p>
      ))}
      {chrome === "full" && (
        <p class="sig-footer__basis" data-testid="publication-basis" data-copy="PB-01 PB-02">
          Published on the maintainer's own rights and publication decisions. No
          lawyer's written opinion has been obtained; nothing here states that
          this publication has been cleared by counsel.
        </p>
      )}
    </footer>
  </body>
</html>
