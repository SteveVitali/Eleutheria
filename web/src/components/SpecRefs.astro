---
// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The SIG project. Code is Apache-2.0; data and documentation
// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// P36.17 (K14 §2.5): the "Spec references" disclosure — requirement ids and
// section pointers live ONLY inside this <details> (DR-K14-07), never in
// running prose. Native <details>, no JS, prints expanded via the print CSS.
interface Props {
  /** Section/requirement references, e.g. "§10.7 · SIG-UI-061". */
  refs: string[];
}

const { refs } = Astro.props;
---

<details class="sig-spec-refs" data-testid="spec-refs">
  <summary>Spec references</summary>
  <ul>
    {refs.map((r) => <li><code>{r}</code></li>)}
  </ul>
</details>
