// A material dossier figure, ALWAYS expandable to its reconciliation (SIG-UI-014).
// P35.37 (SIG-TRANSP-013, J3 §5.4): when the page supplies its registry spec,
// the WHOLE expandable figure — headline value AND the reconciliation that is
// its breakdown — sits inside the <Figure> region, so the contract's
// data-artifact/data-pointer and evidence links cover both.
import Figure from "./Figure.astro";
import DossierFigureDetails from "./DossierFigureDetails.astro";
import type { Figure as DossierFigure } from "../lib/dossier";
import type { FigureSpec } from "../lib/figures";

interface Props {
  figure: DossierFigure;
  /** The page-registry spec for this figure's pointer contract. */
  spec?: FigureSpec;
}

const { figure, spec } = Astro.props;
const suffix = figure.unit ? ` ${figure.unit}` : "";
const lb = figure.lowerBound ? " (lower bound)" : "";
// A figure can be a genuinely UNRESOLVED standoff: the resolver could pick no
// winner (e.g. the 299-vs-190 claimed device count — two sources measuring
// different scopes, §3.1). Such a figure names NO winning claim; it is marked
// unresolved and shows both claims with their evidence rather than a value. This
// is distinct from a "contested-but-resolved" figure (a winner + preserved dissent).
const unresolved = !figure.reconciliation.claims.some(
  (c) => c.claimId === figure.reconciliation.winningClaimId,
);
---

{spec ? (
  <Figure figure={spec} order="inline" tag="div">
    <DossierFigureDetails figure={figure} unresolved={unresolved} suffix={suffix} lb={lb} />
  </Figure>
) : (
  <DossierFigureDetails figure={figure} unresolved={unresolved} suffix={suffix} lb={lb} />
)}
