// P36.22 (SIG-UI-151 / DR-K14-17, adopted UXR-A12): renders the ONE
// five-part branded error-page contract (`sig.error-page/1` in
// `lib/errors.ts`) — a typed state label, what happened (the named cause or
// the pinned notice string), what exists nearby, what the visitor can do,
// and when it may change. The recovery links always carry SIG-UI-151's trio —
// the action is home; search and status ride `recovery`. An error is NOT
// absence: no hatch renders here. Every drafted sentence carries its
// copy-batch `data-copy` (B-2); a pinned notice renders `data-notice`.
import { withBase } from "../lib/paths";
import type { ErrorPageSpec } from "../lib/errors";

interface Props {
  /** The contract `errorPage(kind)` / `errorPageForCode(code)` resolved. */
  spec: ErrorPageSpec;
}

const { spec } = Astro.props;
---

<div class="sig-error" data-testid="error-state" data-error-kind={spec.kind} role="note">
  <p class="sig-error__state" data-testid="error-state-label">
    <strong>{spec.state}</strong>
  </p>
  <p class="sig-error__missing" {...spec.notice ? { "data-notice": spec.notice } : spec.batchIds.missing ? { "data-copy": spec.batchIds.missing } : {}}>
    {spec.missing}
  </p>
  <p class="sig-error__nearby" {...spec.batchIds.nearby ? { "data-copy": spec.batchIds.nearby } : {}}>
    {spec.nearby}
  </p>
  <p class="sig-error__action">
    <a href={withBase(spec.action.href)} {...spec.action.batchId ? { "data-copy": spec.action.batchId } : {}}>
      {spec.action.label}
    </a>
  </p>
  <p class="sig-error__change" {...spec.batchIds.change ? { "data-copy": spec.batchIds.change } : {}}>
    {spec.change}
  </p>
  <p class="sig-error__recovery" data-testid="error-recovery">
    {spec.recovery.map((r, i) => (
      <>
        {i > 0 && " · "}
        <a href={withBase(r.href)} {...r.batchId ? { "data-copy": r.batchId } : {}}>{r.label}</a>
      </>
    ))}
  </p>
</div>
