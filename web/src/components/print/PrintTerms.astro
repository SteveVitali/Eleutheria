// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// P36.26 (K14 §4.11): "Terms used on this page" — the popover chips the live
// dossier carries collapse to this build-time list on paper (a printed term
// cannot be hovered). Same shared vocabulary as <Term>: every id resolves
// through `glossaryTerm` at build (an undefined term fails the build), the
// plain definition is the same sentence the popover carries, and the glossary
// anchor link is preserved so the paper reader can look the term up online.
import { withBase } from "../../lib/paths";
import type { PrintTerm } from "../../lib/print";

interface Props {
  terms: PrintTerm[];
}

const { terms } = Astro.props;
---

<section class="sig-print-terms" data-testid="print-terms" aria-labelledby="print-terms-heading">
  <h2 id="print-terms-heading" data-copy="PV-13">Terms used on this page</h2>
  <dl class="sig-print-terms__list">
    {terms.map((t) => (
      <div class="sig-print-terms__item">
        <dt>
          <a class="sig-print-terms__link" href={withBase(`glossary/#${t.anchor}`)}>{t.term}</a>
        </dt>
        <dd>{t.plain}</dd>
      </div>
    ))}
  </dl>
</section>
