// P36.26 (K14 §4.10, DR-K14-21, SIG-UI-155): the council brief — page 1 of the
// print document. One page a council aide can read: the place's name, what is
// recorded and what is unknown at a glance, the next decision date (or its
// typed absence), three to five documents to bring, and the static QR back to
// the pinned permalink (generated at build — `lib/qr.ts`). Everything derives
// from the record: the counts are `dossierFieldAudit`'s, the decision line is
// `resolveTermination`'s derived date, the document list is the record's own
// locators — nothing is written by hand.
import IncompletenessBanner from "../IncompletenessBanner.astro";
import WhatWeDontKnow from "../WhatWeDontKnow.astro";
import Figure from "../Figure.astro";
import type { Dossier } from "../../lib/dossier";
import type { RecordedGlance, CouncilDecision, PrintDocument } from "../../lib/print";
import type { FigureSpec } from "../../lib/figures";

interface Props {
  dossier: Dossier;
  pageTitle: string;
  jurisdictionLabel: string;
  glance: RecordedGlance;
  decision: CouncilDecision;
  documents: PrintDocument[];
  qr: { viewBox: number; d: string };
  permalink: string;
  specMap: Map<string, FigureSpec>;
}

const {
  dossier,
  pageTitle,
  jurisdictionLabel,
  glance,
  decision,
  documents,
  qr,
  permalink,
  specMap,
} = Astro.props;

const u = glance.unknowns;
const unknownBits: string[] = [];
if (u.notResearched > 0) unknownBits.push(`${u.notResearched} not researched`);
if (u.noEvidenceFound > 0) unknownBits.push(`${u.noEvidenceFound} searched, nothing found`);
if (u.unresolved > 0) unknownBits.push(`${u.unresolved} unresolved`);
if (u.unknown > 0) unknownBits.push(`${u.unknown} recorded unknown`);
---

<header class="sig-print-brief" data-testid="council-brief">
  <p class="sig-print-brief__kicker" data-copy="PV-01">Council brief</p>
  <h1>{pageTitle}</h1>
  <p class="sig-dossier-jurisdiction">{jurisdictionLabel}</p>
  {/* The combines/unmapped sentences (copy rows JD-02/JD-07) are rendered by
      the PAGE via this slot — the P34.14 copy-binding tests parse the route
      file itself, so the guarded elements must live there, not in here. */}
  <slot name="jurisdiction-notes" />

  <dl class="sig-print-brief__glance" data-testid="brief-glance">
    <div class="sig-print-brief__glance-item">
      <dt data-copy="PV-02">Fields recorded</dt>
      {/* The counts are material numbers — they render inside the figure
          registry's regions like every other dossier count (SIG-TRANSP-013). */}
      <Figure figure={specMap.get("glance-recorded")!} tag="dd" order="inline" testid="brief-recorded">
        <strong>{glance.recorded}</strong> of {glance.total}
      </Figure>
    </div>
    <div class="sig-print-brief__glance-item">
      <dt data-copy="PV-03">Fields with no recorded value</dt>
      <Figure figure={specMap.get("glance-unknown")!} tag="dd" order="inline" testid="brief-unknown">
        <strong>{u.total}</strong>
        {unknownBits.length > 0 && <span class="sig-print-brief__unknown-bits"> ({unknownBits.join(", ")})</span>}
      </Figure>
    </div>
    <div class="sig-print-brief__glance-item">
      <dt data-copy="PV-04">Next decision</dt>
      <dd data-testid="brief-decision">
        {decision.date ? (
          <strong><time datetime={decision.date}>{decision.date}</time></strong>
        ) : (
          <strong class="sig-print-brief__absent">{decision.absence}</strong>
        )}
        {decision.basis && <span class="sig-print-brief__basis" data-copy="PV-05">{" "}(renewal or expiry)</span>}
      </dd>
    </div>
  </dl>

  <section class="sig-print-brief__docs" aria-labelledby="print-bring">
    <h2 id="print-bring" data-copy="PV-06">Documents to bring</h2>
    {documents.length > 0 ? (
      <ol class="sig-print-brief__doclist" data-testid="brief-documents">
        {documents.map((doc) => (
          <li>
            <span class="sig-print-brief__doclabel">{doc.label}</span>{" "}
            <code class="sig-print-brief__dochref">{doc.href}</code>
          </li>
        ))}
      </ol>
    ) : (
      <p class="sig-print-brief__absent" data-testid="brief-documents-empty" data-copy="PV-07">
        No source documents recorded.
      </p>
    )}
  </section>

  <aside class="sig-print-brief__qr" data-testid="brief-qr" aria-labelledby="print-qr-caption">
    {/* K14 §4.11: the QR is a static SVG generated at build (lib/qr.ts) —
        EC level M, byte mode; a printed brief can never carry a code that
        drifts from the pinned permalink it encodes. */}
    <svg
      class="sig-print-brief__qr-svg"
      viewBox={`0 0 ${qr.viewBox} ${qr.viewBox}`}
      role="img"
      aria-label={`QR code for ${permalink}`}
    >
      <path d={qr.d} fill="currentColor" />
    </svg>
    <p id="print-qr-caption" class="sig-print-brief__qr-caption">
      <span data-copy="PV-08">Scan for the pinned page —</span> <code>{permalink}</code>
    </p>
  </aside>

  <IncompletenessBanner dossier={dossier} spec={specMap.get("banner")} />
  <section aria-labelledby="print-summary-gaps">
    <h2 id="print-summary-gaps">What we don't know (summary)</h2>
    <WhatWeDontKnow gaps={dossier.gaps} variant="print-summary" specs={specMap} />
  </section>
</header>
