// P36.23 (UXK14-3b, K14 §4.6 provenance-panel row, SIG-UI-083): the ONE
// provenance panel's Astro-side shell — the component every static (.astro)
// surface mounts to render the shared `sig.provenance-panel/1` contract
// (TX-08a / P35.36). It does one thing and only one: resolve the single
// renderer (`ProvenancePanel.tsx` — UXR-33's one-panel rule; the unit suite
// fails on a second emitter of the panel's marker attribute anywhere in
// src/components/). The .tsx alone carries the stylesheet import —
// `styles/provenance.css` — so whether the mount is this shell (record
// pages) or the React islands directly (selection panels) the contract
// renders with the identical sheet from a single importing module —
// importing it here too would add a second importer for no behaviour.
import ProvenancePanel from "./ProvenancePanel";
import type { ProvenancePanelData } from "../lib/provenance-panel";

interface Props {
  /** The normalised `sig.provenance-panel/1` data (panelForClaim/panelFromStatement). */
  panel: ProvenancePanelData;
  /** Emit `id="claim-<id>"` so `#claim-<id>` anchors resolve to this panel. */
  anchor?: boolean;
}

const { panel, anchor = false } = Astro.props;
---

<ProvenancePanel panel={panel} anchor={anchor} />
