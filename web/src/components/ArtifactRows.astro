// P36.60 (EV-02, SIG-EVUI-001/003): the artifact browse rows shared by the
// evidence hub and every facet page — one row per artifact: title → artifact
// page, source, type, captures (count + latest), classification (a synthetic
// row is labelled a run record), lane, capture status and the upstream
// "view at source" under the J3 §5.3 rule. Zero-JS; every absent field is a
// named absence, never a blank.
import {
  ARTIFACT_STATE_LABELS,
  artifactHref,
  artifactState,
  artifactTitle,
  artifactUpstream,
  capturesOf,
  laneLabel,
  latestCapture,
} from "../lib/evidence-hub";
import { artifactTypeLabel, RUN_RECORD_LABEL } from "../lib/evidence-artifacts";
import { NOT_RECORDED } from "../lib/provenance-panel";
import type { EvidenceArtifact } from "../lib/recommender";
import { withBase } from "../lib/paths";

interface Props {
  artifacts: EvidenceArtifact[];
  handles: ReadonlyMap<string, string>;
  testid?: string;
}
const { artifacts, handles, testid = "evidence-artifact-row" } = Astro.props;
---

<ul class="sig-artifact-rows">
  {artifacts.map((a) => {
    const handle = handles.get(a.artifact_id);
    const caps = capturesOf(a);
    const latest = latestCapture(a);
    const state = artifactState(a);
    const up = artifactUpstream(a);
    return (
      <li
        class="sig-artifact-row"
        data-testid={testid}
        data-artifact-id={a.artifact_id}
        data-state={state}
        data-run-record={state === "legacy_synthetic" ? "true" : "false"}
        data-lane={a.lane ?? NOT_RECORDED}
      >
        <p class="sig-artifact-row__title">
          <a href={withBase(artifactHref(handle!))} data-testid="artifact-link">{artifactTitle(a)}</a>
          {state === "legacy_synthetic" && <> — <em data-testid="run-record-label">{RUN_RECORD_LABEL}</em></>}
        </p>
        <p class="sig-artifact-row__meta">
          {a.source_name ?? a.source} · {artifactTypeLabel(a.artifact_type)} ·{" "}
          {ARTIFACT_STATE_LABELS[state] ?? state} · lane: {laneLabel(a.lane)} ·{" "}
          captures: {caps.length === 0 ? NOT_RECORDED : `${caps.length}, latest ${latest?.retrieved_at?.slice(0, 10) ?? NOT_RECORDED}`} ·{" "}
          status: {a.capture_status.replace(/_/g, " ")} ·{" "}
          {up.href ? (
            <a href={up.href} rel="external" data-testid="artifact-upstream">{up.display}</a>
          ) : (
            <span data-testid="artifact-upstream-none">{up.display}</span>
          )}
        </p>
      </li>
    );
  })}
</ul>
