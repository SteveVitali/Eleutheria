// P36.61 (K11 RQ-03a, SIG-RQ-004, SIG-UI-031): the shared task card the hub,
// pagination, place/type/role facet and sort routes render — one card per
// `sig.queue-card/2`: the per-type title and K11 §3 handle, the place facet
// link, type label, role, effort, status, closing condition, evidence sought,
// the named predicate(s), the claim state ("anyone may work" — priority never
// exclusivity, D-K11-6) and the reachable dispositions. The `/task/<handle>/`
// detail pages land with P36.62 — the card carries the handle verbatim and
// never invents a link to a page that does not exist (no dead links).
import {
  DISPOSITION_META,
  SEARCHED_FOUND_NOTHING,
  claimStatusFor,
  taskAnchor,
} from "../lib/research-queue";
import type { JurisdictionClaim, ResearchTaskCard } from "../lib/research-queue";
import {
  placeSlugOf,
  placeNameOf,
  queuePlaceHref,
  queueTypeHref,
  queueRoleHref,
  typeLabel,
  roleLabel,
  evidenceDateOf,
} from "../lib/queue-hub";
import { DRAFT_ANCHOR, draftForTask } from "../lib/records-drafts";
import { getRecordsRequestDrafts } from "../lib/data";
import { withBase } from "../lib/paths";

interface Props {
  card: ResearchTaskCard;
  claims: readonly JurisdictionClaim[];
  asOf: string;
}

const { card, claims, asOf } = Astro.props;
const claim = claimStatusFor(card, claims, asOf);
// P36.63 (RQ-04, SIG-RQ-007): the "draft request available" badge — rendered
// only when the export persists a draft for this task (never a dead link).
const hasDraft = draftForTask(card, getRecordsRequestDrafts()) !== null;
const slug = placeSlugOf(card);
const placeName = card.place?.name ?? placeNameOf(card);
const evidDate = evidenceDateOf(card);
---

<li
  class="sig-task-card"
  data-testid="task-card"
  id={taskAnchor(card)}
  {...(card.task_id ? { "data-task-id": card.task_id } : {})}
  {...(card.handle ? { "data-handle": card.handle } : {})}
  data-task-type={card.task_type}
  data-jurisdiction={card.jurisdiction}
  data-place={slug}
  data-scope={card.geographic_scope}
  data-assignee={card.assignee_class}
  data-effort={card.effort_estimate}
  data-claimed={claim.claimed ? "true" : "false"}
>
  <h3>
    {card.handle ? (
      <a href={withBase(`task/${card.handle}/`)} data-testid="task-link">{card.title ?? card.subject_label}</a>
    ) : (
      card.title ?? card.subject_label
    )}
  </h3>
  <dl class="sig-task-card__fields">
    {card.handle && (
      <div>
        <dt>Handle</dt>
        <dd data-testid="task-handle"><code>{card.handle}</code></dd>
      </div>
    )}
    {card.subject_label && card.title && (
      <div>
        <dt>Subject</dt>
        <dd data-testid="task-subject">
          {card.subject_url ? (
            <a href={withBase(card.subject_url.replace(/^\//, ""))}>{card.subject_label}</a>
          ) : (
            card.subject_label
          )}
        </dd>
      </div>
    )}
    <div>
      <dt>Closing condition</dt>
      <dd data-testid="closing-condition">{card.closing_condition}</dd>
    </div>
    <div>
      <dt>Evidence sought</dt>
      <dd data-testid="evidence-sought">{card.evidence_sought}</dd>
    </div>
    <div>
      <dt>Type</dt>
      <dd data-testid="task-type">
        <a href={withBase(queueTypeHref(card.task_type))}>{typeLabel(card.task_type)}</a>
      </dd>
    </div>
    <div>
      <dt>Assignee class</dt>
      <dd data-testid="assignee-class">
        <a href={withBase(queueRoleHref(card.assignee_class))}>{card.assignee_class}</a>
        {" — "}{roleLabel(card.assignee_class)}
      </dd>
    </div>
    <div>
      <dt>Effort estimate</dt>
      <dd data-testid="effort-estimate">{card.effort_estimate}</dd>
    </div>
    <div>
      <dt>Place</dt>
      <dd data-testid="task-place">
        <a href={withBase(queuePlaceHref(slug))}>{placeName}</a>
        {" "}<span data-testid="task-scope">{card.geographic_scope}</span>
      </dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd data-testid="task-status">{card.status ?? "generated"}</dd>
    </div>
    {(card.predicate_ids ?? []).length > 0 && (
      <div>
        <dt>Missing predicate(s)</dt>
        <dd data-testid="task-predicates">{card.predicate_ids!.join(", ")}</dd>
      </div>
    )}
    {card.trigger && (
      <div>
        <dt>Triggered by</dt>
        <dd data-testid="task-trigger">
          {card.trigger.kind} <code>{card.trigger.ref}</code>
          {evidDate && <> — evidence dated {evidDate}</>}
        </dd>
      </div>
    )}
  </dl>

  {hasDraft && card.handle && (
    <p class="sig-task-card__draft" data-testid="draft-badge">
      <a href={withBase(`task/${card.handle}/#${DRAFT_ANCHOR}`)}>DRAFT request available</a>
      {" "}— SIG sends nothing; you file it.
    </p>
  )}

  <!-- Claiming with expiry (SIG-TASK-010/011, D-K11-6): priority, never exclusivity. -->
  <p class="sig-task-card__claim" data-testid="claim-status">
    {claim.claimed ? (
      <>Claimed by <strong>{claim.claimed_by}</strong>, expiring {claim.expires_at}. </>
    ) : (
      <>Unclaimed. </>
    )}
    <span data-testid="anyone-may-work">Any contributor may work this task — a claim grants priority, not exclusivity.</span>
  </p>

  <!-- The full disposition vocabulary (SIG-TASK-008), incl. searched-found-nothing. -->
  <details class="sig-task-card__dispositions">
    <summary>How this task can be dispositioned</summary>
    <ul>
      {card.dispositions.map((d) => (
        <li
          data-testid="disposition"
          data-disposition={d}
          data-searched-found-nothing={d === SEARCHED_FOUND_NOTHING ? "true" : "false"}
        >
          <code>{d}</code> — {DISPOSITION_META[d]}
        </li>
      ))}
    </ul>
  </details>
</li>
