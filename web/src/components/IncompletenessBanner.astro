// The explicit incompleteness banner every dossier MUST carry (SIG-UI-012): it
// names the number of fields the dossier cannot answer — EVERY unknown, not only
// the not-yet-researched subset (P34.11 / QW-7 / F-136: a bare "unknown", an
// unresolved disagreement, and a null action-block field are all unanswered
// fields) — and states that absence of a row is not evidence of absence. In a
// project whose standard is "no synthetic certainty", this is a headline, not
// fine print — so it renders as a prominent, role="note" banner at the top of
// the dossier and its print export.
import { incompletenessBanner, dossierUnknowns } from "../lib/dossier";
import type { Dossier } from "../lib/dossier";

interface Props {
  dossier: Dossier;
}

const { dossier } = Astro.props;
const text = incompletenessBanner(dossier);
const unknowns = dossierUnknowns(dossier);
---

<div
  class="sig-incompleteness"
  role="note"
  data-testid="incompleteness-banner"
  data-unresearched={unknowns.notResearched}
  data-unknown={unknowns.total}
  data-empty-sections={unknowns.emptySections}
>
  {text}
</div>
