// P36.42b (K2 GX-06a 06b / §4.2 rows 7/9/10; SIG-UI-094/122/130/131) — the
// ONE renderer every entity figure goes through: the kit-emitted SVG served
// as a standalone document and rendered via <img> (axe-clean, print-safe);
// opening the document reveals every drawn node's <a href> (K2 row 7's
// links live in the served bytes). The caption, the generated legend and
// the table twin keep the figure's facts readable without it. A record wave
// emitting no figure renders the typed not-emitted state (SIG-UI-086).
import type { EntityFigureArtifact } from "../../lib/data";
import { FIGURE_NOT_EMITTED } from "../../lib/entity-figures";
import { withBase } from "../../lib/paths";

interface Props {
  /** The figure kind — drives the test ids. */
  kind: "ego" | "timeline" | "map";
  /** The emitted artifact, or null when this record wave carries none. */
  figure: EntityFigureArtifact | null;
  /** The caption's first sentence (the figure's own title). */
  caption: string;
  /** The img alt text — the figure's own desc line. */
  alt: string;
}

const { kind, figure, caption, alt } = Astro.props;
const legend = (figure?.meta?.legend ?? []) as { label?: string; plain?: string }[];
const twinRows = (figure?.meta?.table_rows ?? []) as Record<string, unknown>[];
---

<figure class="sig-entity-figure" data-testid={`entity-figure-${kind}`} data-figure-kind={kind}>
  {figure !== null ? (
    <>
      <a href={withBase(figure.href)} data-testid={`entity-figure-${kind}-open`}>
        <img class="sig-figure-frame sig-entity-figure__img" src={withBase(figure.href)} alt={alt} loading="lazy" />
      </a>
      <figcaption class="sig-fig-caption" data-testid={`entity-figure-${kind}-caption`}>
        {caption}{" "}
        <a href={withBase(figure.href)}>Open the standalone figure</a> — every drawn node links.
        {legend.length > 0 && (
          <ul class="sig-fig-legend" data-testid={`entity-figure-${kind}-legend`}>
            {legend.map((l) => (
              <li>
                <strong>{l.label}:</strong> {l.plain}
              </li>
            ))}
          </ul>
        )}
        {twinRows.length > 0 && (
          <details data-testid={`entity-figure-${kind}-twin`}>
            <summary>The figure's table twin ({twinRows.length} rows)</summary>
            <div class="sig-table-wrap">
              <table class="sig-table">
                <thead>
                  <tr>{Object.keys(twinRows[0]!).map((c) => <th scope="col">{c.replaceAll("_", " ")}</th>)}</tr>
                </thead>
                <tbody>
                  {twinRows.map((r) => (
                    <tr>
                      {Object.values(r).map((v) => (
                        <td>{Array.isArray(v) ? v.join(", ") : String(v)}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        )}
      </figcaption>
    </>
  ) : (
    <p class="sig-island__note" data-testid={`entity-figure-${kind}-absent`} data-copy="EF-01">
      {FIGURE_NOT_EMITTED}
    </p>
  )}
</figure>
