// P36.61 (K11 RQ-03a, SIG-RQ-006 / D-K11-1): one aggregated field-gap campaign
// row (`sig.queue-campaign/1`) — the missing field, its subject class, the
// place, the member count and a member sample. The campaign detail pages
// (`/research-queue/campaign/<handle>/`) land with P36.62 — the row carries
// the handle verbatim, never a dead link.
import type { QueueCampaign } from "../lib/queue-hub";
import { queuePlaceHref } from "../lib/queue-hub";
import { withBase } from "../lib/paths";

interface Props {
  campaign: QueueCampaign;
}

const { campaign } = Astro.props;
const slug = campaign.place?.slug ?? "unplaced";
const placeName = campaign.place?.name ?? "Not yet placed";
const sample = (campaign.members ?? []).slice(0, 5);
---

<li
  class="sig-campaign-card"
  data-testid="campaign-card"
  data-handle={campaign.handle}
  data-predicate={campaign.predicate_id}
  data-subject-class={campaign.subject_class}
  data-place={slug}
>
  <h3 data-testid="campaign-title">
    <a href={withBase(`research-queue/campaign/${campaign.handle}/`)} data-testid="campaign-link">
      Add the <code>{campaign.predicate_id}</code> field on {campaign.member_count}{" "}
      {campaign.subject_class.replace(/_/g, " ")} records in {placeName}
    </a>
  </h3>
  <dl class="sig-campaign-card__fields">
    <div>
      <dt>Handle</dt>
      <dd><code>{campaign.handle}</code></dd>
    </div>
    <div>
      <dt>Field</dt>
      <dd data-testid="campaign-predicate"><code>{campaign.predicate_id}</code></dd>
    </div>
    <div>
      <dt>Subject class</dt>
      <dd>{campaign.subject_class}</dd>
    </div>
    <div>
      <dt>Place</dt>
      <dd><a href={withBase(queuePlaceHref(slug))}>{placeName}</a></dd>
    </div>
    <div>
      <dt>Records</dt>
      <dd data-testid="campaign-member-count">{campaign.member_count}</dd>
    </div>
    {campaign.contribution?.note && (
      <div>
        <dt>Kind</dt>
        <dd>{campaign.contribution.kind} — {campaign.contribution.note}</dd>
      </div>
    )}
  </dl>
  {sample.length > 0 && (
    <p class="sig-campaign-card__members" data-testid="campaign-members">
      Sample records:{" "}
      {sample.map((m, i) => (
        <>
          {i > 0 && ", "}
          {m.subject_url ? (
            <a href={withBase(m.subject_url.replace(/^\//, ""))}>{m.subject_label}</a>
          ) : (
            m.subject_label
          )}
        </>
      ))}
      {(campaign.members ?? []).length > sample.length && <> …</>}
    </p>
  )}
</li>
