// The investigation-view switch (P32.15, SIG-FIND-004, ADR-134): plain zero-JS
// links between the three workspace views carrying the versioned
// `sig.workspace-state/1` release state — `?v=1&view=<v>&release=<pub>`. With
// JavaScript the islands render the same switch with the LIVE state (query,
// filters and the selected record preserved); without it these links still move
// the reader between the views at the pinned release.
import {
  DEFAULT_WORKSPACE_STATE,
  WORKSPACE_VIEWS,
  viewHref,
} from "../lib/workspace-state";
import type { WorkspaceView } from "../lib/workspace-state";

interface Props {
  view: WorkspaceView;
  /** The latest activated publication id for this build, or null (none). */
  release: string | null;
}

const { view, release } = Astro.props;
const state = { ...DEFAULT_WORKSPACE_STATE, view, release };

const LABELS: Record<WorkspaceView, string> = {
  list: "List",
  map: "Map",
  network: "Connections",
};
---

<nav class="sig-view-switch" aria-label="Investigation views" data-testid="view-switch">
  <strong class="sig-view-switch__label">Investigation views:</strong>
  {WORKSPACE_VIEWS.map((v, i) => (
    <>
      {i > 0 && " · "}
      {v === view ? (
        <strong aria-current="page" data-testid={`view-switch-${v}`}>{LABELS[v]}</strong>
      ) : (
        <a href={viewHref(state, v)} data-testid={`view-switch-${v}`}>{LABELS[v]}</a>
      )}
    </>
  ))}
  {release && (
    <span class="sig-view-switch__note" data-testid="view-switch-release">
      {" "}— release <code>{release}</code>; the interactive islands carry query,
      filters and the selected record across these views.
    </span>
  )}
</nav>
