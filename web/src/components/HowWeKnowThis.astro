// The "How we know this" module every page carries (SIG-UI-044). It renders the SIX
// required components — artifact counts, tier distribution, source-independence count,
// date range, rules applied, and human-review status — from a provenance summary,
// refusing to render if any component is missing (assertProvenanceComplete). Also the
// home of the public methodology / data-freshness / coverage-metrics links (SIG-UI-034),
// so those pages are reachable — and linked from every dossier — on every page.
import { assertProvenanceComplete, DEFAULT_PROVENANCE, REVIEW_STATUS_LABELS } from "../lib/provenance";
import type { ProvenanceSummary } from "../lib/provenance";

interface Props {
  provenance?: ProvenanceSummary;
  /**
   * What the summary describes (P34.11 / QW-6, F-05/F-132). "site" — the default —
   * means the totals are SITE-WIDE and must be labelled as such so a dossier page
   * never reads them as its own figures; "page" is for a surface supplying its own
   * provenance (the corrections log, the research queue).
   */
  scope?: "site" | "page";
  /**
   * The page's own name, used by the page-scoped scope line (P34.12 / C3
   * NEW-13): a page-specific summary names the page it describes ("These
   * totals describe the research queue's own evidence…"), never an anonymous
   * "this page". Optional for back-compat: an unnamed page-scoped module still
   * renders the generic page line.
   */
  pageName?: string;
}

const provenance = Astro.props.provenance ?? DEFAULT_PROVENANCE;
const scope = Astro.props.scope ?? "site";
const pageName = Astro.props.pageName;
// Enforce the six-component contract at build time (SIG-UI-044): a module missing a
// component fails the build rather than shipping.
assertProvenanceComplete(provenance);

const tiers = Object.entries(provenance.tier_distribution).sort(([a], [b]) => a.localeCompare(b));
const range = provenance.date_range;
---

<section class="sig-hwkt" data-testid="how-we-know-this" aria-labelledby="hwkt-heading">
  <!-- P34.13 (QW-13, RI-49): every dossier also carries its §39.2
       "How we know this" section, so TWO same-named region landmarks landed
       on one page. The visually-hidden suffix makes this landmark's
       accessible name unique ("How we know this — site-wide") without
       changing the visible heading. -->
  <h2 id="hwkt-heading">How we know this{scope === "site" ? (
    <span class="sig-visually-hidden" data-copy="HW-11"> — site-wide</span>
  ) : pageName ? (
    <span class="sig-visually-hidden" data-copy="HW-12"> — {pageName}</span>
  ) : (
    <span class="sig-visually-hidden" data-copy="HW-13"> — this page</span>
  )}</h2>
  <!-- P34.12 (C3 NEW-13): a page-scoped module names the page it describes
       (the `pageName` prop), never an anonymous "this page". -->
  {scope === "site" ? (
    <p class="sig-hwkt__scope" data-testid="hwkt-scope" data-copy="HW-01">
      Site-wide — these totals describe the whole published record, not this page alone.
    </p>
  ) : pageName ? (
    <p class="sig-hwkt__scope" data-testid="hwkt-scope" data-copy="HW-10">
      These totals describe the {pageName}'s own evidence, not the whole record.
    </p>
  ) : (
    <p class="sig-hwkt__scope" data-testid="hwkt-scope" data-copy="HW-02">
      These totals describe this page's own evidence, not the whole record.
    </p>
  )}
  {provenance.denominator && (
    <p class="sig-hwkt__denominator" data-testid="hwkt-denominator" data-copy="HW-09">
      Counted against: {provenance.denominator}.
    </p>
  )}
  <dl class="sig-hwkt__grid">
    <div data-testid="hwkt-artifact_count" data-component="artifact_count">
      <dt data-copy="HW-03">Evidence artifacts</dt>
      <dd>{provenance.artifact_count}</dd>
    </div>
    <div data-testid="hwkt-tier_distribution" data-component="tier_distribution">
      <dt data-copy="HW-04">Claims by evidence tier</dt>
      <dd>{tiers.map(([tier, n], i) => (<>{i > 0 ? ", " : ""}<span data-tier={tier}>{n}×{tier}</span></>))}</dd>
    </div>
    <div data-testid="hwkt-source_independence_count" data-component="source_independence_count">
      <dt data-copy="HW-05">Independent sources</dt>
      <dd>{provenance.source_independence_count}</dd>
    </div>
    <div data-testid="hwkt-date_range" data-component="date_range">
      <dt data-copy="HW-06">Evidence date range</dt>
      <dd>{range ? `${range.earliest} – ${range.latest}` : "no dated evidence"}</dd>
    </div>
    <div data-testid="hwkt-rules_applied" data-component="rules_applied">
      <dt data-copy="HW-07">Rules applied</dt>
      <dd>{provenance.rules_applied.join(", ")}</dd>
    </div>
    <div data-testid="hwkt-human_review_status" data-component="human_review_status">
      <dt data-copy="HW-08">Human review status</dt>
      <dd data-review-status={provenance.human_review_status}>{REVIEW_STATUS_LABELS[provenance.human_review_status]}</dd>
    </div>
  </dl>
  <p class="sig-hwkt__links">
    <a href="/methodology/" data-testid="methodology-link">Methodology</a>
    {" · "}
    <a href="/data-freshness/" data-testid="data-freshness-link">Data freshness</a>
    {" · "}
    <a href="/coverage-metrics/" data-testid="coverage-metrics-link">Coverage metrics</a>
  </p>
</section>
