---
// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The SIG project. Code is Apache-2.0; data and documentation
// carry per-artifact licences — see LICENSE and docs/2_canonical_design_spec.md §42.

// P36.17 (K14 §2.4 / DR-K14-10): the "In brief" box — the plain-language
// layer FIRST, ≤ ~80 words, always linking the precise section so the careful
// reading is one action away (plain first, precise intact). Static HTML, no
// JS, present in print.
interface Props {
  /** The fragment or route the "Read the precise version" link points at. */
  href: string;
}

const { href } = Astro.props;
---

<aside class="sig-inbrief" aria-label="In brief" data-testid="in-brief">
  <h2 class="sig-inbrief__heading">In brief</h2>
  <div class="sig-inbrief__body"><slot /></div>
  <p class="sig-inbrief__more"><a href={href}>Read the precise version ›</a></p>
</aside>
