// Absence, rendered as exactly ONE texture — the hatch (SIG-UI-007). Every absence
// uses the single `.sig-absence-hatch` class; the four absence kinds (§9.5) are
// distinguished WITHIN it by a distinct symbol + text (a non-colour channel,
// SIG-UI-005), never a second texture. Each hatch is clickable: it is a plain GET
// link (no JavaScript — SIG-UI-036/037) to the task-intake page, turning the gap
// from an admission into an invitation to generate a research task.
import { ABSENCE_HATCH_CLASS, ABSENCE_KIND_META } from "../lib/epistemic";
import { absenceTaskHref } from "../lib/task";
import type { AbsenceKind } from "../lib/epistemic";

interface Props {
  kind: AbsenceKind;
  subject_id: string;
  predicate_id: string;
  predicate_label?: string;
}

const { kind, subject_id, predicate_id, predicate_label } = Astro.props;
const meta = ABSENCE_KIND_META[kind];
const href = absenceTaskHref({
  subject_id,
  predicate_id,
  absence_kind: kind,
  ...(predicate_label ? { predicate_label } : {}),
});
const label = `${meta.label} — ${meta.meaning} Start a research task.`;
---

<a
  class={ABSENCE_HATCH_CLASS}
  data-testid="absence-hatch"
  data-absence-kind={kind}
  href={href}
  aria-label={label}
>
  <span class="sig-absence-hatch__symbol" aria-hidden="true">{meta.symbol}</span>
  <span class="sig-absence-hatch__text">{meta.label}</span>
</a>
