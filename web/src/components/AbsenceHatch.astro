// An absence marker (SIG-UI-007): a short striped hatch + label that makes every
// "we don't know" a visible, NAMED absence rather than missing text. P34.12
// (K11 §5.5 / RQ-00, F-113/F-274): the fixture `/task/new/<slug>/` intake pages
// are retired — the hatch no longer links to a mock "generated task" page (the
// link implied a task had been created when nothing had). The hatch now renders
// as a named absence: the kind label plus machine-readable subject/predicate
// attributes. The real per-task page arrives with RQ-03 (`/task/<handle>/`).
import { ABSENCE_KIND_META, type AbsenceKind } from "../lib/epistemic";

interface Props {
  kind: AbsenceKind;
  subject_id: string;
  predicate_id: string;
  predicate_label: string;
}

const { kind, subject_id, predicate_id, predicate_label } = Astro.props;
const meta = ABSENCE_KIND_META[kind];
---

<span
  class="sig-absence-hatch"
  data-testid="absence-hatch"
  data-absence-kind={kind}
  data-absence-subject={subject_id}
  data-absence-predicate={predicate_id}
  aria-label={`${predicate_label}: ${meta.label}`}
>
  <span class="sig-absence-hatch__mark" aria-hidden="true"></span>
  {meta.label}
</span>
