// A contradiction, rendered as a value RANGE with the competing claims plotted
// (SIG-UI-009). Each claim is labelled with its source, tier, date, and document
// link, and — where a claim measures a *different quantity* — an explicit note, so
// the reader can see at a glance that "42 vs 38" is not necessarily a disagreement
// (§29.1). The plotted track is decorative and aria-hidden; the claims list below
// carries the full information and is the no-JS/screen-reader equivalent.
//
// P36.23 (UXK14-3b, K14 §3.4/§4.6): the range names its agreement level —
// CONTESTED ("Contested range") or IRRECONCILABLE ("Unresolved range", the §29
// state where no value can be defended yet — the figure keeps a solid
// raspberry frame, the only place that hue lands besides the marker). Every
// plotted point now carries its ordinal label, so "one labelled dot per
// claim" ties each mark to its row in the equivalent claims list.
import { contradictionRange, plotPosition } from "../lib/epistemic";
import type { CompetingClaim } from "../lib/epistemic";
import { lexiconState } from "../lib/lexicon";

interface Props {
  claims: CompetingClaim[];
  unit?: string;
  /**
   * The agreement level this range renders — CONTESTED or IRRECONCILABLE
   * (the two `CONTESTED_AGREEMENTS` members). The unresolved figure keeps the
   * reserved-hue solid frame; every other value reads as the contested form.
   */
  agreement?: "CONTESTED" | "IRRECONCILABLE";
}

const { claims, unit, agreement = "CONTESTED" } = Astro.props;
const range = contradictionRange(claims);
const suffix = unit ? ` ${unit}` : "";
const state = lexiconState("agreement", agreement);
const label = `${state.label} range`;
---

<figure
  class:list={["sig-range", agreement === "IRRECONCILABLE" && "sig-range--unresolved"]}
  data-testid="contradiction-range"
  data-agreement={agreement}
>
  <figcaption>
    {label}: <strong>{range.min}</strong>–<strong>{range.max}</strong>{suffix}
    across {claims.length} competing claim{claims.length === 1 ? "" : "s"}
  </figcaption>

  {/* P36.19 (UXK0-3, K0 §4.8): the track is an inline <svg> — the plotted
      positions are geometry attributes (cx percent), never style=""
      attributes, so the strict CSP needs no style-src-attr exception. The
      decorative plot stays aria-hidden; the claims list is the equivalent. */}
  <svg class="sig-range__track" aria-hidden="true">
    <line class="sig-range__track-line" x1="0" x2="100%" y1="4" y2="4" />
    {
      claims.map((c, i) => (
        <g>
          <circle
            class="sig-range__point"
            cx={`${(plotPosition(range, c.value) * 100).toFixed(1)}%`}
            cy="4"
            r="4"
          />
          <text
            class="sig-range__point-label"
            x={`${(plotPosition(range, c.value) * 100).toFixed(1)}%`}
            y="18"
            text-anchor="middle"
          >
            {i + 1}
          </text>
          <title>{`${i + 1} — ${c.value}${suffix} — ${c.source}`}</title>
        </g>
      ))
    }
  </svg>

  <ol class="sig-range__claims">
    {
      claims.map((c) => (
        <li data-testid="competing-claim" data-claim-id={c.claimId}>
          <strong>{c.value}{suffix}</strong> — {c.source}
          <span class="sig-range__meta"> (tier {c.tier}, {c.date})</span>
          <a href={c.documentUrl} aria-label={`Source document for the ${c.source} claim (${c.value})`}> document</a>
          {c.differentQuantityNote && (
            <p class="sig-range__note" data-testid="different-quantity-note">
              <em>Different quantity:</em> {c.differentQuantityNote}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</figure>
