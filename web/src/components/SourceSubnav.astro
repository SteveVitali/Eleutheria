// P36.69 (UX10-3b): the source-page-B sub-navigation — the back-link plus
// the sibling sub-route set the model discloses (runs/captures/changes/
// versions/entities/dossiers). A sub-route renders only when the source
// carries the data it lists — never a dead link (R-6).
import { withBase } from "../lib/paths";

interface Props {
  id: string;
  name: string;
  /** Which sibling sets exist for this source. */
  has: {
    runs: boolean;
    captures: boolean;
    versions: boolean;
    entities: boolean;
    dossiers: boolean;
  };
  /** The current sub-route (marked aria-current). */
  current?: "source" | "runs" | "captures" | "changes" | "versions" | "entities" | "dossiers";
}

const { id, name, has, current = "source" } = Astro.props;
const items: { key: NonNullable<Props["current"]>; label: string; href: string }[] = [
  ...(has.runs ? [{ key: "runs" as const, label: "runs", href: `sources/${id}/runs/` }] : []),
  ...(has.captures
    ? [
        { key: "captures" as const, label: "captures", href: `sources/${id}/captures/` },
        { key: "changes" as const, label: "changes", href: `sources/${id}/captures/changes/` },
      ]
    : []),
  ...(has.versions ? [{ key: "versions" as const, label: "versions", href: `sources/${id}/versions/` }] : []),
  ...(has.entities ? [{ key: "entities" as const, label: "entities", href: `sources/${id}/entities/` }] : []),
  ...(has.dossiers ? [{ key: "dossiers" as const, label: "dossier contribution", href: `sources/${id}/dossiers/` }] : []),
];
---

<nav class="sig-source-subnav" aria-label="Source sections" data-testid="source-subnav">
  <a href={withBase(`sources/${id}/`)} data-testid="subnav-source">← {name}</a>
  {items.map((it) => (
    <>
      {" · "}
      {current === it.key ? (
        <strong aria-current="page" data-testid={`subnav-${it.key}`}>{it.label}</strong>
      ) : (
        <a href={withBase(it.href)} data-testid={`subnav-${it.key}`}>{it.label}</a>
      )}
    </>
  ))}
</nav>
