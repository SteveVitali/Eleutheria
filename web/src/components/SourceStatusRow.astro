// The shared source row component (K9 C-12 — one set of column definitions
// for both clocks). This adapter maps the lane's `sig.status-lane/1` row
// onto the same TableRow the release-clock `/sources/runs/` renders and
// delegates to SourceTableRow — the Runs & freshness cells are identical
// markup on both clocks; the status table alone carries "Next run (day)"
// and the seven/thirty-day windows its cells are labelled with
// (SIG-TRANSP-034). A count-only (gated/refused/withdrawn) source never
// reaches this component — the lane publishes it as a count (D-J3-11).
import SourceTableRow from "./SourceTableRow.astro";
import { statusRowToTableRow, type StatusSourceRow } from "../lib/status-lane";

interface Props {
  row: StatusSourceRow;
  /** Show the status-clock "Next run (day)" cell (default true). */
  nextRun?: boolean;
}
const { row, nextRun = true } = Astro.props;
const tableRow = statusRowToTableRow(row);
---

<SourceTableRow
  row={tableRow}
  view="runs"
  nextRunDay={nextRun ? row.next_run_day : undefined}
  runsNote="recorded in the seven-day window"
  errorsNote="failed in the recorded thirty-day window"
/>
