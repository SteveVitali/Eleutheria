// The citation affordance every page carries (SIG-UI-035, SIG-TIME-008;
// P35.42 — SIG-TRANSP-023's citation-block half, the J3 §8.2 contract).
//
// `BaseLayout` passes the release context on EVERY page (the F-399 fix): the
// block shows the verbatim J3 §8.2 cite sentence — "Cite: <title>, SIG release
// <pub-short> (data as of <as_of_world>, belief <as_of_belief>, ruleset <r>),
// <snapshot URL>" — with the release id beside the as-of pair (DR-C3-14). The
// phrase "reproducible after SIG corrects itself" appears ONLY over an
// immutable `/s/<pub>/` or `/r/<pub>/` URL (the render rule — `citationBlock`
// derives it from the recordPath, never a template flag); until snapshots
// exist (TX-13b / P36.66a+b) the block says — verbatim the J3 interim wording —
// "This page is the latest view of release <data release id>; an immutable
// citable copy is not yet published." Rendered as plain text — no JavaScript.
import {
  beliefPinnedPermalink,
  citationBlock,
  citationText,
  publicationShort,
  releaseCitationText,
  REPRODUCIBLE_PHRASE,
} from "../lib/citation";
import type { ReleaseContext } from "../lib/citation";
import { AS_OF, RULESET_VERSION } from "../lib/fixtures";
import type { AsOfEcho } from "../lib/fixtures";

interface Props {
  path: string;
  title: string;
  asOf?: AsOfEcho;
  rulesetVersion?: string;
  /**
   * P35.42 (SIG-TRANSP-023, F-399): the build's release context — REQUIRED on
   * every page that renders the block (a template omitting it fails
   * `astro check`; `citationBlock` throws on `undefined`). `null` only when
   * the build binds no release — the honest development state, never a
   * fabricated one.
   */
  release: ReleaseContext | null;
}

const { path, title, release } = Astro.props;
const asOf = Astro.props.asOf ?? AS_OF;
const rulesetVersion = Astro.props.rulesetVersion ?? RULESET_VERSION;
// The canonical (archival) origin comes from Astro's `site` config, so a real
// deployment sets it once rather than the permalink hard-coding a host.
const input = { path, title, asOf, rulesetVersion, ...(Astro.site ? { origin: Astro.site.origin } : {}) };
const permalink = beliefPinnedPermalink(input);
const cite = citationText(input);
const block = citationBlock({ ...input, release });
// The reporting-register citation (SIG-UI-043) names the release form when the
// cited URL is immutable; otherwise the factual "Retrieved from" line over the
// page's own link — a retrieval statement, never a pinning promise.
const releaseCite =
  block.mode === "immutable" && release
    ? releaseCitationText({
        publicationId: release.publicationId,
        recordPath: release.recordPath,
        title,
        asOf,
        rulesetVersion,
        ...(Astro.site ? { origin: Astro.site.origin } : {}),
      })
    : null;
// The citation sentence ends "… Retrieved from <permalink>" — the URL is an
// identifier (K14 NEW-8's exempted class): it renders inside <code> like
// every other literal, and the innerText of the sentence is unchanged.
const citeStr = releaseCite ?? cite;
const RETRIEVED = "Retrieved from ";
const rix = citeStr.lastIndexOf(RETRIEVED);
const citePre = rix >= 0 ? citeStr.slice(0, rix + RETRIEVED.length) : citeStr;
const citeTail = rix >= 0 ? citeStr.slice(rix + RETRIEVED.length) : null;
---

{/* P36.20 (UXK0-4): the cite block mounts inside `<sig-cite>` — with JS the
    element adds a JS-only format picker (plain/APA/Chicago/legal, all
    `[data-enhancement]`) restating the verbatim sentence from the
    `data-cite-*` fields; without JS the paragraph-form citation is complete.
    Each permalink anchor mounts inside `<sig-copy>` — a copy action beside
    the link that never alters the source text. The elements' modules load
    only on T1 pages (BaseLayout gates on the page-type registry); elsewhere
    they are inert markup. */}
<sig-cite
  data-cite-title={title}
  data-cite-release={block.releaseId ?? ""}
  data-cite-asof-world={asOf.as_of_world}
  data-cite-asof-belief={asOf.as_of_belief}
  data-cite-ruleset={rulesetVersion}
  data-cite-url={block.citeUrl ?? permalink}
>
<section class="sig-cite" data-testid="citation" aria-labelledby="cite-heading">
  <h2 id="cite-heading">Cite this page</h2>
  {block.mode === "immutable" && (
    <>
      <p class="sig-cite__sentence" data-testid="cite-sentence" data-immutable="true">
        Cite: {title}, SIG release{" "}
        <code>{publicationShort(release!.publicationId)}</code> (data as of{" "}
        {asOf.as_of_world}, belief {asOf.as_of_belief}, ruleset {rulesetVersion}),{" "}
        <a
          class="sig-cite__permalink"
          data-testid="citation-immutable"
          rel="bookmark"
          href={block.citeUrl}
          >{block.citeUrl}</a
        >{" "}
        — {REPRODUCIBLE_PHRASE}.
      </p>
      <p class="sig-cite__legacy">
        Historical-selector URL (legacy — resolved through the release
        compatibility index, never an immutable citation):{" "}
        <sig-copy label="Copy link"><a data-testid="permalink" href={permalink}>{permalink}</a></sig-copy>
      </p>
    </>
  )}
  {block.mode === "interim" && (
    <>
      <p class="sig-cite__sentence" data-testid="cite-sentence">{block.citeSentence}.</p>
      <p class="sig-cite__interim" data-testid="citation-interim">{block.interimSentence}</p>
      <p data-copy="CC-01">
        Link (records the as-of pair and ruleset of this build):{" "}
        <sig-copy label="Copy link"><a
          class="sig-cite__permalink"
          data-testid="permalink"
          rel="bookmark"
          href={permalink}
          >{permalink}</a
        ></sig-copy>
      </p>
    </>
  )}
  {block.mode === "unreleased" && (
    <p data-copy="CC-01">
      Link (records the as-of pair and ruleset of this build):{" "}
      <sig-copy label="Copy link"><a
        class="sig-cite__permalink"
        data-testid="permalink"
        rel="bookmark"
        href={permalink}
        >{permalink}</a
      ></sig-copy>
    </p>
  )}
  <p>
    As of world <time datetime={asOf.as_of_world}>{asOf.as_of_world}</time>,
    belief <time datetime={asOf.as_of_belief}>{asOf.as_of_belief}</time>;
    ruleset <code>{rulesetVersion}</code>
    {block.releaseId && (
      <>; release <code data-testid="citation-release-id">{block.releaseId}</code></>
    )}.
  </p>
  <p class="sig-cite__text" data-testid="citation-text">{citePre}{citeTail && <code>{citeTail}</code>}</p>
</section>
</sig-cite>
