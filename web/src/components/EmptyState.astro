// A designed, honest empty / partial state (§15, §9.5, SIG-UI-007, the §3.1 defining
// standard). It renders absence as a VISIBLE, EXPLAINED gap — never a blank section
// and never a fabricated zero — using the single absence texture (the hatch) so the
// vocabulary is consistent with every per-field gap. It always carries a clickable
// affordance (a plain GET link, no JavaScript — SIG-UI-036/037): a gap is an
// invitation, not a dead end. The copy is supplied by `lib/empty.ts` (pure, tested).
//
// P34.20 (K14 §6.4, SIG-EVUI-D08): surfaces carrying `copy.parts` render the
// cause-class five-part pattern — a typed state label, what is missing and why
// (the named cause), what exists nearby, what the visitor can do, and when it
// may change. These states name a real cause; they never say "research gap"
// and never route the visitor to the research queue as the remedy for a
// pipeline gap.
//
// P36.22 (SIG-UI-086/151): EVERY surface is typed — `parts` is always present
// and carries `cause`, the named cause class rendered as `data-cause`. The
// hatch renders only when the cause IS absence (filtered_none /
// not_redistributable / degraded render no hatch — an error or a rights hold
// is not a gap in the record).
// P36.23 (UXK14-3b, SIG-UI-086): `parts` also accepts a fully-typed
// `EmptyStateParts` record directly — the non-absence cause classes
// (`filtered_none`, `not_redistributed`, `degraded`) have no aggregate
// surface yet, so the harness and future callers mount them by contract.
// One of `surface`/`parts` is required — fail closed, never an untyped
// state (SIG-ENG-042).
import { emptyState, emptyStateHasHatch } from "../lib/empty";
import type { EmptyStateParts, EmptySurface } from "../lib/empty";
import { withBase } from "../lib/paths";

interface Props {
  /** The surface whose honest copy to render. */
  surface?: EmptySurface;
  /** Or a fully-typed five-part contract (the cause-class kinds with no surface yet). */
  parts?: EmptyStateParts;
}

const { surface, parts: directParts } = Astro.props;
if (surface === undefined && directParts === undefined) {
  throw new Error("EmptyState: one of `surface` or `parts` is required — an untyped empty state never renders");
}
const copy = surface !== undefined ? emptyState(surface) : undefined;
const parts = directParts ?? copy?.parts;
const hatch = parts ? emptyStateHasHatch(parts.cause) : true;
---

<div
  class="sig-empty"
  role="note"
  data-testid="empty-state"
  data-surface={surface ?? "custom"}
  data-cause-class={parts ? "true" : "false"}
  {...(parts ? { "data-cause": parts.cause } : {})}
  data-hatch={hatch ? "true" : "false"}
>
  {hatch && <span class="sig-empty__hatch" aria-hidden="true"></span>}
  <div class="sig-empty__body">
    {
      parts ? (
        <>
          <p class="sig-empty__heading" data-testid="empty-state-state" data-copy={parts.batchIds.state}>
            {parts.state}
          </p>
          <p class="sig-empty__text" data-testid="empty-state-missing" data-copy={parts.batchIds.missing}>
            {parts.missing}
          </p>
          <p class="sig-empty__text" data-testid="empty-state-nearby" data-copy={parts.batchIds.nearby}>
            {parts.nearby}
          </p>
          <p class="sig-empty__cta" data-testid="empty-state-action">
            <a data-testid="empty-state-cta" data-copy={parts.batchIds.action} href={withBase(parts.action.href)}>
              {parts.action.label}
            </a>
          </p>
          <p class="sig-empty__text sig-empty__change" data-testid="empty-state-change" data-copy={parts.batchIds.change}>
            {parts.change}
          </p>
        </>
      ) : (
        <>
          <p class="sig-empty__heading">{copy!.heading}</p>
          <p class="sig-empty__text">{copy!.body}</p>
          <p class="sig-empty__cta">
            <a data-testid="empty-state-cta" href={withBase(copy!.cta.href)}>
              {copy!.cta.label}
            </a>
          </p>
        </>
      )
    }
  </div>
</div>
