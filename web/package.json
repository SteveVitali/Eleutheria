{
  "name": "@sig/web",
  "version": "0.1.0",
  "private": true,
  "description": "SIG public web surface (Astro static-first, zero-JS-by-default) — the Phase-15 shell and the epistemic visual language every other surface consumes (SIG-UI-036/037). TypeScript is confined to this package (SIG-ENG-010).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:perf": "lhci autorun",
    "export:fixtures": "esbuild scripts/build-fixture-export.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-fixture-export.mjs && node node_modules/.cache/build-fixture-export.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:licenses && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.2.4",
    "maplibre-gl": "6.9.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.5",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
