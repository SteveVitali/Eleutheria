{
  "name": "@sig/web",
  "version": "0.1.0",
  "private": true,
  "description": "SIG public web surface (Astro static-first, zero-JS-by-default) \u2014 the Phase-15 shell and the epistemic visual language every other surface consumes (SIG-UI-036/037). TypeScript is confined to this package (SIG-ENG-010).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:paths": "node scripts/check-root-absolute-paths.mjs",
    "check:dom": "node scripts/check-unsafe-dom.mjs",
    "check:figures": "node scripts/check-figures.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:lexicon": "node scripts/check-lexicon.mjs",
    "check:copy": "node scripts/check-copy-lints.mjs",
    "check:lhci": "node scripts/gen-lhci.mjs --verify",
    "gen:map-styles": "node scripts/gen-map-styles.mjs",
    "check:map-styles": "node scripts/gen-map-styles.mjs --verify",
    "check:perf": "SIG_BUILD_INTERNAL=1 npm run build && npm run check:lhci && lhci autorun",
    "check:perf:national": "bash ../scripts/ci/national_budget_leg.sh all",
    "fixture:national": "uv run python ../scripts/ci/build_national_fixture.py --out national",
    "export:fixtures": "esbuild scripts/build-fixture-export.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/build-fixture-export.mjs && node node_modules/.cache/build-fixture-export.mjs",
    "check": "npm run typecheck && npm run test:unit && SIG_BUILD_INTERNAL=1 npm run build && npm run check:lhci && npm run check:map-styles && npm run check:licenses && npm run check:paths && npm run check:dom && npm run check:figures && npm run check:tokens && npm run check:lexicon && npm run check:copy && npm run check:runtime-deps && npm run test:e2e",
    "prebuild": "node scripts/prepare-map-vendor.mjs",
    "predev": "node scripts/prepare-map-vendor.mjs",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "astro": "7.3.5",
    "maplibre-gl": "6.9.0",
    "pmtiles": "4.5.0",
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.5",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@protomaps/basemaps": "^5.7.2",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "license-checker-rseidelsohn": "5.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
